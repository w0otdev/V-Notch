<?xml version="1.0" encoding="utf-8"?>
<!-- Only for a disposable non-interactive Windows session. Interactive sessions
     keep these tests skipped even with this opt-in; ordinary UI tests run on a
     private background desktop and never switch the user's desktop. -->
<RunSettings>
  <RunConfiguration>
    <TestCaseFilter>Category=DesktopIntegration</TestCaseFilter>
    <EnvironmentVariables>
      <VNOTCH_RUN_DESKTOP_TESTS>1</VNOTCH_RUN_DESKTOP_TESTS>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
