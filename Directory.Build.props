<Project>
  <!-- Shared settings for the product projects (app, tests, uninstaller).
       Tools/** holds benchmarks and probes that are built on demand, so they keep
       their own warning policy. -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <_VNotchRelativeProjectDir>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)'))</_VNotchRelativeProjectDir>
    <_VNotchIsToolProject Condition="$(_VNotchRelativeProjectDir.ToLowerInvariant().StartsWith('tools'))">true</_VNotchIsToolProject>
  </PropertyGroup>

  <!-- Keep product libraries and standalone uninstaller builds on the same
       release as V-Notch.csproj. Release-pipeline overrides take precedence. -->
  <PropertyGroup Condition="'$(_VNotchIsToolProject)' != 'true'">
    <Version Condition="'$(Version)' == ''">2.4.2</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">2.4.2.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">2.4.2.0</FileVersion>
    <AnalysisLevel Condition="'$(StrictAnalyzers)' == 'true'">latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(_VNotchIsToolProject)' != 'true' And '$(TreatWarningsAsErrors)' == ''">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
