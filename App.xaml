<Application x:Class="VNotch.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Embedded SF Pro Display font - works on all machines without SF Pro installed -->
        <FontFamily x:Key="SFProDisplay">pack://application:,,,/Fonts/#SF Pro Display, Nirmala UI, Segoe UI</FontFamily>
        <!-- SF Pro Text maps to Display since we only ship Display weights -->
        <FontFamily x:Key="SFProText">pack://application:,,,/Fonts/#SF Pro Display, Nirmala UI, Segoe UI</FontFamily>
        <!-- Embedded icon font - works on all machines without Segoe MDL2 Assets or Segoe Fluent Icons installed -->
        <FontFamily x:Key="IconFont">pack://application:,,,/Fonts/#Segoe MDL2 Assets, Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol, Segoe UI</FontFamily>
    </Application.Resources>
</Application>
