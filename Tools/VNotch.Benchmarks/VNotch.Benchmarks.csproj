<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.14.0" />
    <!-- Explicit runtime dependencies for the prebuilt application reference.
         Keep these equal to the versions V-Notch resolves transitively (packages.lock.json;
         LLamaSharp pulls the 10.0.x line), so 8.x pins would downgrade the app's dependencies. -->
    <PackageReference Include="System.Text.Json" Version="10.0.4" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <!-- BenchmarkDotNet changes IntermediateOutputPath for generated builds.
         Reference the prebuilt Release assembly so those builds do not rebuild
         the WPF application and its unrelated assets. -->
    <Reference Include="V-Notch">
      <HintPath>../../bin/Release/net8.0-windows10.0.19041.0/win-x64/V-Notch.dll</HintPath>
    </Reference>
    <Content Include="../../Native/out/VNotch.Native.dll"
             Link="VNotch.Native.dll"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('$(MSBuildThisFileDirectory)../../Native/out/VNotch.Native.dll')" />
  </ItemGroup>
  <Target Name="RequireReleaseApplication" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../../bin/Release/net8.0-windows10.0.19041.0/win-x64/V-Notch.dll') or !Exists('$(MSBuildThisFileDirectory)../../Native/out/VNotch.Native.dll')"
           Text="Build V-Notch.csproj in Release first, or use Tools/VNotch.Benchmarks/run.ps1." />
  </Target>
</Project>
