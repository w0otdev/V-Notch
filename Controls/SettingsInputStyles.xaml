<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VNotch.Controls">
    <SolidColorBrush x:Key="SettingsInputBackground" Color="#19191C"/>
    <!-- Match the File Tray overflow menu's top-lit rim and neutral ink. -->
    <LinearGradientBrush x:Key="SettingsInputBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FFFFFF" Offset="0"/>
        <GradientStop Color="#16FFFFFF" Offset="0.5"/>
        <GradientStop Color="#0DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SettingsInputText" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="SettingsInputError" Color="#F28B82"/>

    <!-- Text, password and numeric fields share the same surface and states. -->
    <Style x:Key="SettingsInputBase" TargetType="Control">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="{DynamicResource SettingsFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Background" Value="{StaticResource SettingsInputBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource SettingsInputText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SettingsInputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid>
                        <Border x:Name="InputBorder" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="InputHighlight" CornerRadius="11"
                                        Background="#0AFFFFFF" controls:TrayMotion.Opacity="0"
                                        IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InputHighlight" Property="controls:TrayMotion.Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputHighlight" Property="controls:TrayMotion.Opacity" Value="1"/>
                            <Setter TargetName="InputHighlight" Property="Background" Value="#12FFFFFF"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="invalid">
                            <Setter Property="Foreground" Value="{StaticResource SettingsInputError}"/>
                            <Setter TargetName="InputHighlight" Property="Background" Value="#16F28B82"/>
                            <Setter TargetName="InputHighlight" Property="controls:TrayMotion.Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SettingsInputError}"/>
                            <Setter TargetName="InputHighlight" Property="Background" Value="#16F28B82"/>
                            <Setter TargetName="InputHighlight" Property="controls:TrayMotion.Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="InputBorder" Property="Background" Value="#141417"/>
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="#20FFFFFF"/>
                            <Setter Property="Foreground" Value="#A0A0AA"/>
                            <Setter TargetName="InputHighlight" Property="controls:TrayMotion.Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsTextInput" TargetType="TextBox" BasedOn="{StaticResource SettingsInputBase}">
        <Setter Property="CaretBrush" Value="{StaticResource SettingsInputText}"/>
        <Setter Property="SelectionBrush" Value="#40FFFFFF"/>
        <Setter Property="SelectionOpacity" Value="1"/>
    </Style>

    <Style x:Key="SettingsPasswordInput" TargetType="PasswordBox" BasedOn="{StaticResource SettingsInputBase}">
        <Setter Property="CaretBrush" Value="{StaticResource SettingsInputText}"/>
        <Setter Property="SelectionBrush" Value="#40FFFFFF"/>
        <Setter Property="SelectionOpacity" Value="1"/>
        <Setter Property="PasswordChar" Value="●"/>
    </Style>
</ResourceDictionary>
