<UserControl xmlns:fonts="clr-namespace:VNotch.Services"
        x:Class="VNotch.Controls.AudioMixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:VNotch.Services">
    <UserControl.Resources>
        <fonts:AppFont x:Key="AudioSystemFont" Fallbacks="Nirmala UI, Segoe UI" />
        <FontFamily x:Key="AudioIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </UserControl.Resources>
    <Grid>
    <ScrollViewer x:Name="AudioScrollViewer"
                  Width="682"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly"
                  Padding="0,0,7,0"
                  ScrollChanged="AudioScrollViewer_ScrollChanged">
        <ScrollViewer.Resources>

            <Style x:Key="AudioScrollPageButton" TargetType="RepeatButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="5"/>
                <Setter Property="MinWidth" Value="5"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource AudioScrollPageButton}"
                                                      Command="ScrollBar.PageUpCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource AudioScrollPageButton}"
                                                      Command="ScrollBar.PageDownCommand"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Width="5"
                                                            CornerRadius="2.5"
                                                            Background="#59FFFFFF"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ScrollViewer.Resources>
        <ScrollViewer.Template>

            <ControlTemplate TargetType="ScrollViewer">
                <Grid>
                    <ScrollContentPresenter Margin="{TemplateBinding Padding}"
                                            CanContentScroll="{TemplateBinding CanContentScroll}"/>
                    <ScrollBar x:Name="PART_VerticalScrollBar"
                               Orientation="Vertical"
                               HorizontalAlignment="Right"
                               Margin="0,2,0,2"
                               Maximum="{TemplateBinding ScrollableHeight}"
                               ViewportSize="{TemplateBinding ViewportHeight}"
                               Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                </Grid>
            </ControlTemplate>
        </ScrollViewer.Template>

        <ScrollViewer.OpacityMask>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop x:Name="AudioFadeTopStop" Color="Black" Offset="0"/>
                <GradientStop Color="Black" Offset="0.06"/>
                <GradientStop Color="Black" Offset="0.94"/>
                <GradientStop x:Name="AudioFadeBottomStop" Color="Black" Offset="1"/>
            </LinearGradientBrush>
        </ScrollViewer.OpacityMask>
        <StackPanel x:Name="AudioRoot"
                    Opacity="1">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="AudioRootTranslate" Y="0"/>
            </StackPanel.RenderTransform>
        </StackPanel>
    </ScrollViewer>

    <StackPanel x:Name="AudioLoadingPanel"
                Visibility="Collapsed"
                Opacity="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
        <StackPanel.RenderTransform>
            <TranslateTransform x:Name="AudioLoadingTranslate" Y="0"/>
        </StackPanel.RenderTransform>
        <Border Width="36"
                Height="36"
                Margin="0,0,0,10"
                CornerRadius="18"
                Background="#12FFFFFF"
                BorderBrush="#18FFFFFF"
                BorderThickness="1">
            <TextBlock Text="&#xE995;"
                       FontFamily="{StaticResource AudioIconFont}"
                       FontSize="17"
                       Foreground="{x:Static svc:UiPalette.SecondaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="AudioLoadingText"
                   Text="Loading sound mixer..."
                   FontSize="12"
                   HorizontalAlignment="Center"
                   FontWeight="Medium"
                   FontFamily="{StaticResource AudioSystemFont}"
                   TextOptions.TextFormattingMode="Ideal">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="TextShimmerAnim">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[0].(GradientStop.Offset)"
                                                         From="-0.45" To="1.05" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[1].(GradientStop.Offset)"
                                                         From="-0.20" To="1.30" Duration="0:0:1.6" />
                                        <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[2].(GradientStop.Offset)"
                                                         From="0.05" To="1.55" Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="TextShimmerAnim" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
            <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#69FFFFFF" Offset="-0.45"/>
                    <GradientStop Color="#F5FFFFFF" Offset="-0.20"/>
                    <GradientStop Color="#69FFFFFF" Offset="0.05"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>
    </StackPanel>

    <Grid x:Name="AudioOverlay"
          Background="Transparent"
          Visibility="Collapsed"
          Panel.ZIndex="100"/>
    </Grid>
</UserControl>
