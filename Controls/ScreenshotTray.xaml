<UserControl x:Class="VNotch.Controls.ScreenshotTray"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource SFProDisplay}"
             FontWeight="Bold"
             UseLayoutRounding="False"
             SnapsToDevicePixels="False"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Grayscale"
             TextOptions.TextHintingMode="Animated"
             PreviewKeyDown="Tray_KeyDown">
    <UserControl.Resources>
        <!-- Match Settings typography, including its rendering and weight. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource SFProDisplay}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Animated"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource SFProDisplay}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="15" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#444444"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#EEEEEE"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#454545"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="Surface" Background="Transparent" BorderThickness="0"
            Padding="14" Width="304" RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="EntryScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="EntryOffset"/>
            </TransformGroup>
        </Border.RenderTransform>
        <StackPanel>
            <DockPanel Margin="2,0,0,10">
                <Button x:Name="DismissButton" DockPanel.Dock="Right" Padding="0" Width="28" Height="28"
                        VerticalAlignment="Center" Click="Dismiss_Click">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontWeight="Normal" Text="&#xE711;" FontSize="10"/>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Foreground="#C8C8C8" FontSize="12"/>
                    <TextBlock x:Name="DimensionsText" Foreground="#B3B3B3" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
            <Border x:Name="PreviewFrame" Background="Transparent" CornerRadius="12" Padding="0" Height="136"
                    Cursor="Hand" MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove">
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SizeChanged="PreviewImage_SizeChanged"/>
            </Border>
            <TextBlock x:Name="HintText" Foreground="#B3B3B3" FontSize="11" Margin="2,10,2,10"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="KeepButton" Click="Keep_Click" HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Border>
</UserControl>
