<UserControl x:Class="VNotch.Controls.ChangelogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:VNotch.Controls"
             xmlns:fonts="clr-namespace:VNotch.Services"
             FontFamily="{fonts:AppFont Fallbacks='Nirmala UI, Segoe UI'}" FontWeight="Bold">
    <UserControl.Resources>
        <SolidColorBrush x:Key="StableVersionBrush" Color="#80E6A5"/>
        <SolidColorBrush x:Key="PrereleaseVersionBrush" Color="#FFD464"/>
        <SolidColorBrush x:Key="LatestBadgeInk" Color="#E4CCFF"/>
        <SolidColorBrush x:Key="LatestBadgeFill" Color="#442969"/>
        <SolidColorBrush x:Key="CurrentBadgeInk" Color="#BCEBFF"/>
        <SolidColorBrush x:Key="CurrentBadgeFill" Color="#153E59"/>
        <Style x:Key="StableVersionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource StableVersionBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="#103D25"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrereleaseVersionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrereleaseVersionBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="#493300"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SkeletonBar" TargetType="Border">
            <Setter Property="Height" Value="9"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#20FFFFFF"/>
        </Style>
        <x:Array x:Key="SkeletonVersionWidths" Type="{x:Type sys:Double}">
            <sys:Double>48</sys:Double>
            <sys:Double>38</sys:Double>
            <sys:Double>60</sys:Double>
            <sys:Double>72</sys:Double>
            <sys:Double>49</sys:Double>
        </x:Array>
        <Style x:Key="VersionRowStyle" TargetType="ListBoxItem">
            <Setter Property="FontFamily" Value="{fonts:AppFont Fallbacks='Nirmala UI, Segoe UI'}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8E8ED"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="VersionRow" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="VersionRow" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="VersionRow" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="152"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#0DFFFFFF" CornerRadius="9" Margin="0,0,10,0"/>
        <Grid Margin="5,8,15,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="VersionsText" FontSize="11" FontWeight="Bold"
                       Foreground="#ADADAD" Margin="10,4,0,8"/>
            <ScrollViewer x:Name="VersionScrollViewer" Grid.Row="1"
                          ScrollChanged="VersionScrollViewer_ScrollChanged"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="SelectionReveal" IsHitTestVisible="False"
                            Opacity="{Binding SelectedItem.Opacity, ElementName=VersionList, FallbackValue=0}"
                            RenderTransform="{Binding SelectedItem.RenderTransform, ElementName=VersionList}">
                        <Border x:Name="SelectionMark" Margin="1,0" CornerRadius="6" Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Top" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="MarkScale"/>
                                    <TranslateTransform x:Name="MarkOffset"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <ListBox x:Name="VersionList" BorderThickness="0" Background="Transparent"
                             AutomationProperties.LabeledBy="{Binding ElementName=VersionsText}"
                             ItemContainerStyle="{StaticResource VersionRowStyle}" SelectionMode="Single"
                             PreviewKeyDown="VersionList_PreviewKeyDown"
                             SelectionChanged="VersionList_SelectionChanged" SizeChanged="VersionList_SizeChanged">
                        <ListBox.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                        </ListBox.Template>
                    </ListBox>
                    <Button x:Name="OlderVersionsButton" Grid.Row="1" Visibility="Collapsed"
                            Margin="1,4" Padding="4" FontSize="11" Click="OlderVersions_Click"/>
                </Grid>
            </ScrollViewer>
            <ItemsControl x:Name="VersionSkeleton" Grid.Row="1" ClipToBounds="True"
                          IsHitTestVisible="False" Focusable="False"
                          Visibility="{Binding Visibility, ElementName=NotesSkeleton}"
                          ItemsSource="{StaticResource SkeletonVersionWidths}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10,8,0,12" HorizontalAlignment="Left">
                            <Border Style="{StaticResource SkeletonBar}" Width="{Binding}"
                                    HorizontalAlignment="Left" Background="#32FFFFFF"/>
                            <Border Style="{StaticResource SkeletonBar}" Width="56" Height="7"
                                    HorizontalAlignment="Left" Margin="0,7,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Grid.Column="1">
            <Grid x:Name="NotesViewport">
                <ScrollViewer x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="18,14,12,16">
                    <Grid>
                        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#ADADAD"/>
                        </StackPanel>
                        <StackPanel x:Name="ChangelogContent" Visibility="Collapsed">
                            <StackPanel x:Name="ReleaseHeader" Margin="0,0,0,20"/>
                            <Border Height="1" Background="#2A2A2A" Margin="0,0,0,20"/>
                            <StackPanel x:Name="ReleaseNotes"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <Grid x:Name="NotesSkeleton" Margin="18,14,12,16" Visibility="Collapsed"
                      ClipToBounds="True" IsHitTestVisible="False">
                    <StackPanel>
                        <Border Style="{StaticResource SkeletonBar}" HorizontalAlignment="Left"
                                Width="136" Height="22" Background="#38FFFFFF" Margin="0,4,0,6"/>
                        <TextBlock x:Name="LoadingText" TextWrapping="Wrap" FontSize="13"
                                   Foreground="#ADADAD" AutomationProperties.LiveSetting="Polite"/>
                        <Border Style="{StaticResource SkeletonBar}" HorizontalAlignment="Left"
                                Width="54" Height="17" Margin="0,9,0,20"/>
                        <Border Height="1" Background="#2A2A2A" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource SkeletonBar}" Height="14" Background="#30FFFFFF"
                                    Margin="0,4,0,15"/>
                            <Border Style="{StaticResource SkeletonBar}" Grid.Row="1" Grid.ColumnSpan="3"/>
                            <Border Style="{StaticResource SkeletonBar}" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,11,0,0"/>
                            <Border Style="{StaticResource SkeletonBar}" Grid.Row="3" Margin="0,11,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                <controls:ChangelogBlurWave x:Name="ReleaseWave"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
