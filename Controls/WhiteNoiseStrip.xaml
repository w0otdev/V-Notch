<UserControl x:Class="VNotch.Controls.WhiteNoiseStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fonts="clr-namespace:VNotch.Services"
             FontFamily="{DynamicResource WhiteNoiseFont}" FontWeight="Bold">
    <UserControl.Resources>
        <fonts:AppFont x:Key="WhiteNoiseFont" Fallbacks="Nirmala UI, Segoe UI" />
    </UserControl.Resources>
    <StackPanel>
        <Grid x:Name="ChipTrack">
            <Border x:Name="ChipSelection" Width="1" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center"
                    CornerRadius="13" Background="{DynamicResource AccentBrush}" BorderThickness="0"
                    RenderTransformOrigin="0,0.5" IsHitTestVisible="False" Opacity="0">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ChipSelectionScale" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="ChipSelectionOffset"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border x:Name="ChipSelectionPulse" CornerRadius="13" Background="#22FFFFFF" BorderThickness="0" Opacity="0" IsHitTestVisible="False"/>
            </Border>
            <UniformGrid x:Name="ChipHost" Rows="1" LayoutUpdated="ChipHost_LayoutUpdated"/>
        </Grid>
        <Grid x:Name="ControlRow" Height="26" Margin="2,8,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="60"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="VolumeBar" Grid.Column="1" Height="26" Margin="6,0,14,0" Cursor="Hand" Background="Transparent"
                  MouseLeftButtonDown="VolumeBar_MouseDown" MouseMove="VolumeBar_MouseMove" MouseLeftButtonUp="VolumeBar_MouseUp">
                <Border Height="4" CornerRadius="2" Background="#22FFFFFF" VerticalAlignment="Center"/>
                <Border x:Name="VolumeFill" Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
