<UserControl x:Class="VNotch.Controls.DotLoadingIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="24" Height="24" IsHitTestVisible="False" Focusable="False">
    <UserControl.Resources>
        <RadialGradientBrush x:Key="DotGlow">
            <GradientStop Color="#70FFFFFF" Offset="0"/>
            <GradientStop Color="#30FFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </RadialGradientBrush>
        <Style x:Key="Dot" TargetType="Grid">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        </Style>
        <Style x:Key="Glow" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource DotGlow}"/>
        </Style>
        <Style x:Key="Core" TargetType="Ellipse">
            <Setter Property="Width" Value="9.5"/>
            <Setter Property="Height" Value="9.5"/>
            <Setter Property="Fill" Value="White"/>
        </Style>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Canvas x:Name="Dots" Width="48" Height="48" UseLayoutRounding="False" SnapsToDevicePixels="False">
            <Grid Style="{StaticResource Dot}" Canvas.Left="15" Canvas.Top="0">
                <Ellipse Style="{StaticResource Glow}"/><Ellipse Style="{StaticResource Core}"/>
            </Grid>
            <Grid Style="{StaticResource Dot}" Canvas.Left="27.990381" Canvas.Top="7.5">
                <Ellipse Style="{StaticResource Glow}"/><Ellipse Style="{StaticResource Core}"/>
            </Grid>
            <Grid Style="{StaticResource Dot}" Canvas.Left="27.990381" Canvas.Top="22.5">
                <Ellipse Style="{StaticResource Glow}"/><Ellipse Style="{StaticResource Core}"/>
            </Grid>
            <Grid Style="{StaticResource Dot}" Canvas.Left="15" Canvas.Top="30">
                <Ellipse Style="{StaticResource Glow}"/><Ellipse Style="{StaticResource Core}"/>
            </Grid>
            <Grid Style="{StaticResource Dot}" Canvas.Left="2.009619" Canvas.Top="22.5">
                <Ellipse Style="{StaticResource Glow}"/><Ellipse Style="{StaticResource Core}"/>
            </Grid>
            <Grid Style="{StaticResource Dot}" Canvas.Left="2.009619" Canvas.Top="7.5">
                <Ellipse Style="{StaticResource Glow}"/><Ellipse Style="{StaticResource Core}"/>
            </Grid>
        </Canvas>
    </Viewbox>
</UserControl>
