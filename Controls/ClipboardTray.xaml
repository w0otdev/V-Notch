<UserControl x:Class="VNotch.Controls.ClipboardTray"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:VNotch.ViewModels"
 xmlns:local="clr-namespace:VNotch.Controls"
 xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
 xmlns:svc="clr-namespace:VNotch.Services"
 Focusable="False" Background="Transparent" Foreground="White" PreviewKeyDown="Tray_PreviewKeyDown"
 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal"
 TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
 RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.ClearTypeHint="Enabled"
 FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold">
 <UserControl.Resources>
  <!-- The surface supplies entrance motion; the native popup supplies dismissal. -->
  <x:Static x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}" Member="primitives:PopupAnimation.None"/>
  <SolidColorBrush x:Key="TraySurfaceBase" Color="{x:Static local:ClipboardTrayTokens.SurfaceBase}"/>
  <SolidColorBrush x:Key="TraySurfaceElevated" Color="{x:Static local:ClipboardTrayTokens.SurfaceElevated}"/>
  <SolidColorBrush x:Key="TraySurfaceOverlay" Color="{x:Static local:ClipboardTrayTokens.SurfaceOverlay}"/>
  <SolidColorBrush x:Key="TrayAccent" Color="#30FFFFFF"/>
  <SolidColorBrush x:Key="TrayOnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TrayDestructive" Color="#FF453A"/>
  <SolidColorBrush x:Key="TrayMutedForeground" Color="#8E8E93"/>
  <CornerRadius x:Key="TrayRadiusSmall">8</CornerRadius>
  <CornerRadius x:Key="TrayRadiusMedium">12</CornerRadius>
  <CornerRadius x:Key="TrayRadiusLarge">16</CornerRadius>
  <CornerRadius x:Key="TrayRadiusCardFooter">0,0,16,16</CornerRadius>
  <SolidColorBrush x:Key="TrayMenuSurfaceBrush" Color="#000000"/>
  <LinearGradientBrush x:Key="TrayMenuRim" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#38FFFFFF" Offset="0"/>
   <GradientStop Color="#16FFFFFF" Offset="0.5"/>
   <GradientStop Color="#0DFFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <Style x:Key="TrayMenuSurface" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource TrayMenuSurfaceBrush}"/>
   <Setter Property="BorderBrush" Value="{StaticResource TrayMenuRim}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="{StaticResource TrayRadiusMedium}"/>
   <Setter Property="Padding" Value="5"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="Effect"><Setter.Value>
    <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Color="Black" Opacity="0.48" RenderingBias="Performance"/>
   </Setter.Value></Setter>
  </Style>

  <!-- Typography: Pure SF Pro Typographic Hierarchy -->
  <Style TargetType="TextBlock">
   <Setter Property="FontFamily" Value="{StaticResource SFProDisplay}"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Foreground" Value="#F5F5FA"/>
   <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
   <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
   <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="FontFamily" Value="{StaticResource SFProDisplay}"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
   <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="FontFamily" Value="{StaticResource SFProDisplay}"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="PasswordBox">
      <Border Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              SnapsToDevicePixels="True">
       <ScrollViewer x:Name="PART_ContentHost"
                     Focusable="False"
                     HorizontalScrollBarVisibility="Hidden"
                     VerticalScrollBarVisibility="Hidden"
                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="FontFamily" Value="{StaticResource SFProDisplay}"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="#F2F2F7"/>
   <Setter Property="Background" Value="#F2161620"/>
   <Setter Property="BorderBrush" Value="#25FFFFFF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="8,4"/>
  </Style>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <local:TrayCopiedOpacityConverter x:Key="BoolOpacity"/>
  <local:TrayCopiedBlurConverter x:Key="BoolBlur"/>

  <!-- Base Glass Button -->
  <Style x:Key="TrayButton" TargetType="Button">
   <Setter Property="FontFamily" Value="{StaticResource SFProDisplay}"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Button_PointerDown"/>
   <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Button_PointerUp"/>
   <EventSetter Event="MouseLeave" Handler="Button_PointerLeave"/>
   <EventSetter Event="PreviewKeyDown" Handler="Button_KeyDown"/>
   <EventSetter Event="PreviewKeyUp" Handler="Button_KeyUp"/>
   <EventSetter Event="LostKeyboardFocus" Handler="Button_Reset"/>
   <EventSetter Event="LostMouseCapture" Handler="Button_Reset"/>
   <EventSetter Event="Unloaded" Handler="Button_Reset"/>
   <Setter Property="Foreground" Value="#D0FFFFFF"/>
   <Setter Property="Background" Value="#14FFFFFF"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="12,5"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" local:TrayMotion.Background="{TemplateBinding Background}" CornerRadius="{StaticResource TrayRadiusMedium}"
     local:TrayMotion.BorderBrush="#18FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="Surface" Property="local:TrayMotion.Background" Value="#22FFFFFF"/>
      <Setter TargetName="Surface" Property="local:TrayMotion.BorderBrush" Value="#45FFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
     </Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="local:TrayMotion.Opacity" Value="0.7"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="local:TrayMotion.BorderBrush" Value="#A0FFFFFF"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Circular Header Companion Button (Keyboard, Pause, Info) -->
  <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource TrayButton}">
   <Setter Property="Width" Value="28"/>
   <Setter Property="Height" Value="28"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="2,0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#A8A8B2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="14">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="Surface" Property="Background" Value="#22FFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
     </Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Dedicated Forgot PIN Button: Borderless, Smooth Text Brightening on Hover -->
  <Style x:Key="ForgotPinButtonStyle" TargetType="Button">
   <Setter Property="FontFamily" Value="{StaticResource SFProDisplay}"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="{StaticResource TrayMutedForeground}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="6,4"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="True"/>
   <Setter Property="HorizontalAlignment" Value="Center"/>
   <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Button_PointerDown"/>
   <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Button_PointerUp"/>
   <EventSetter Event="MouseLeave" Handler="Button_PointerLeave"/>
   <EventSetter Event="PreviewKeyDown" Handler="Button_KeyDown"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid Background="Transparent" SnapsToDevicePixels="True">
       <!-- Base muted text -->
       <TextBlock x:Name="BaseText" Text="{TemplateBinding Content}"
                  FontFamily="{TemplateBinding FontFamily}" FontWeight="{TemplateBinding FontWeight}"
                  FontSize="{TemplateBinding FontSize}" Foreground="{StaticResource TrayMutedForeground}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <!-- Smoothly brightening white text overlay -->
       <TextBlock x:Name="BrightText" Text="{TemplateBinding Content}"
                  FontFamily="{TemplateBinding FontFamily}" FontWeight="{TemplateBinding FontWeight}"
                  FontSize="{TemplateBinding FontSize}" Foreground="#FFFFFF" Opacity="0"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
         <BeginStoryboard>
          <Storyboard>
           <DoubleAnimation Storyboard.TargetName="BrightText" Storyboard.TargetProperty="Opacity"
                            To="1.0" Duration="0:0:0.18">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
           </DoubleAnimation>
          </Storyboard>
         </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
         <BeginStoryboard>
          <Storyboard>
           <DoubleAnimation Storyboard.TargetName="BrightText" Storyboard.TargetProperty="Opacity"
                            To="0.0" Duration="0:0:0.22">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
           </DoubleAnimation>
          </Storyboard>
         </BeginStoryboard>
        </Trigger.ExitActions>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Trigger.EnterActions>
         <BeginStoryboard>
          <Storyboard>
           <DoubleAnimation Storyboard.TargetName="BrightText" Storyboard.TargetProperty="Opacity"
                            To="1.0" Duration="0:0:0.18">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
           </DoubleAnimation>
          </Storyboard>
         </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
         <BeginStoryboard>
          <Storyboard>
           <DoubleAnimation Storyboard.TargetName="BrightText" Storyboard.TargetProperty="Opacity"
                            To="0.0" Duration="0:0:0.22">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
           </DoubleAnimation>
          </Storyboard>
         </BeginStoryboard>
        </Trigger.ExitActions>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter Property="Opacity" Value="0.6"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- Reset Confirmation Action Button (inherits TrayButton) -->
  <Style x:Key="ResetDestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource TrayButton}">
   <Setter Property="Background" Value="#14FFFFFF"/>
   <Setter Property="Foreground" Value="#60FFFFFF"/>
   <Style.Triggers>
    <Trigger Property="IsEnabled" Value="True">
     <Setter Property="Background" Value="{StaticResource TrayDestructive}"/>
     <Setter Property="Foreground" Value="White"/>
    </Trigger>
   </Style.Triggers>
  </Style>

  <!-- Group Choice Checkbox -->
  <Style x:Key="TrayGroupChoice" TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <StackPanel Orientation="Horizontal" Background="Transparent">
     <Border x:Name="CheckSurface" Width="18" Height="18" CornerRadius="5" BorderThickness="1"
      local:TrayMotion.Background="#18FFFFFF" local:TrayMotion.BorderBrush="#40FFFFFF" Margin="0,0,8,0">
      <TextBlock x:Name="CheckGlyph" Text="✓" FontSize="11" FontWeight="Bold" Foreground="#121216" HorizontalAlignment="Center" VerticalAlignment="Center" local:TrayMotion.Opacity="0"/>
     </Border>
     <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </StackPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="CheckSurface" Property="local:TrayMotion.Background" Value="White"/>
      <Setter TargetName="CheckGlyph" Property="local:TrayMotion.Opacity" Value="1"/>
     </Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="local:TrayMotion.BorderBrush" Value="#80FFFFFF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="local:TrayMotion.BorderBrush" Value="White"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="CheckSurface" Property="local:TrayMotion.Opacity" Value="0.7"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Hover and press scale both actions; only the more action rotates. -->
  <Style x:Key="CardActionButton" TargetType="Button">
   <Setter Property="FontFamily" Value="{StaticResource SFProDisplay}"/>
   <Setter Property="Width" Value="24"/>
   <Setter Property="Height" Value="24"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="2,0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#E0FFFFFF"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="True"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Grid Background="Transparent" ClipToBounds="True">
      <Grid x:Name="RootGrid" IsHitTestVisible="False" SnapsToDevicePixels="False" UseLayoutRounding="False" RenderTransformOrigin="0.5,0.5" local:TrayMotion.Angle="0">
       <Grid.Effect>
        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.8" RenderingBias="Performance"/>
       </Grid.Effect>
       <Grid.RenderTransform>
        <TransformGroup>
         <ScaleTransform x:Name="HoverScale" ScaleX="1.0" ScaleY="1.0"/>
         <RotateTransform Angle="0"/>
        </TransformGroup>
       </Grid.RenderTransform>
       <Border x:Name="Surface" Background="Transparent" BorderThickness="0">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
       </Border>
      </Grid>
      </Grid>
      <ControlTemplate.Triggers>
       <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
         <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="more"/>
         <Condition Binding="{Binding IsMenuOpen}" Value="True"/>
        </MultiDataTrigger.Conditions>
        <Setter TargetName="RootGrid" Property="local:TrayMotion.Angle" Value="90"/>
       </MultiDataTrigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="White"/>
        <Trigger.EnterActions>
         <BeginStoryboard>
          <Storyboard>
           <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.18">
            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.45"/></DoubleAnimation.EasingFunction>
           </DoubleAnimation>
           <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.18">
            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.45"/></DoubleAnimation.EasingFunction>
           </DoubleAnimation>
          </Storyboard>
         </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
         <BeginStoryboard>
          <Storyboard>
           <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.20">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
           </DoubleAnimation>
           <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.20">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
           </DoubleAnimation>
          </Storyboard>
         </BeginStoryboard>
        </Trigger.ExitActions>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Surface" Property="Opacity" Value="0.7"/>
        <Trigger.EnterActions>
         <BeginStoryboard>
          <Storyboard>
           <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0:0:0.08"/>
           <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0:0:0.08"/>
          </Storyboard>
         </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
         <BeginStoryboard>
          <Storyboard>
           <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12"/>
           <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12"/>
          </Storyboard>
         </BeginStoryboard>
        </Trigger.ExitActions>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <!-- Emphasis is shared; the template rotates only the more action. -->
    <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
     <Setter Property="Foreground" Value="White"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>

  <Style x:Key="MoreActionButton" TargetType="Button" BasedOn="{StaticResource CardActionButton}">
   <Setter Property="Width" Value="20"/>
   <Setter Property="Height" Value="20"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="PinActionButton" TargetType="Button" BasedOn="{StaticResource CardActionButton}">
   <Setter Property="Width" Value="20"/>
   <Setter Property="Height" Value="20"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Opacity" Value="0.7"/>
   <Setter Property="Foreground" Value="White"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Opacity" Value="1.0"/>
     <Setter Property="Foreground" Value="White"/>
    </Trigger>
    <!-- Amber and full opacity distinguish pinned files without rotating the icon. -->
    <DataTrigger Binding="{Binding Entry.IsPinned}" Value="True">
     <Setter Property="Opacity" Value="1.0"/>
     <Setter Property="Foreground" Value="#FFD60A"/>
    </DataTrigger>
    <MultiDataTrigger>
     <MultiDataTrigger.Conditions>
      <Condition Binding="{Binding Entry.IsPinned}" Value="True"/>
      <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
     </MultiDataTrigger.Conditions>
     <Setter Property="Foreground" Value="#FFE040"/>
    </MultiDataTrigger>
   </Style.Triggers>
  </Style>

  <!-- Apple Segmented Control Tab Button -->
  <Style x:Key="CategoryButton" TargetType="Button">
   <Setter Property="FontFamily" Value="{StaticResource SFProDisplay}"/>
   <Setter Property="FontWeight" Value="Bold"/>
   <Setter Property="Margin" Value="0,0,3,0"/>
   <Setter Property="Padding" Value="12,5"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#8E8E93"/>
   <Setter Property="Tag" Value="{Binding Name}"/>
   <Setter Property="AllowDrop" Value="True"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Focusable" Value="True"/>
   <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
   <EventSetter Event="Click" Handler="Category_Click"/>
   <EventSetter Event="DragEnter" Handler="Category_DragEnter"/><EventSetter Event="DragOver" Handler="Category_DragOver"/>
   <EventSetter Event="DragLeave" Handler="Category_DragLeave"/><EventSetter Event="Drop" Handler="Category_Drop"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
    <Border x:Name="CategoryHover" Background="#18FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="13" IsHitTestVisible="False" local:TrayMotion.Opacity="0"/>
    <Border x:Name="Surface" Background="Transparent" CornerRadius="13"
     BorderThickness="1" BorderBrush="#05FFFFFF" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="CategoryHover" Property="local:TrayMotion.Opacity" Value="1"/>
      <Setter Property="Foreground" Value="White"/>
     </Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="local:TrayMotion.Opacity" Value="0.75"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsLightSelection}" Value="True">
     <Setter Property="Background" Value="#30FFFFFF"/>
     <Setter Property="Foreground" Value="White"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding IsAccentSelection}" Value="True">
     <Setter Property="Background" Value="{StaticResource TrayAccent}"/>
     <Setter Property="Foreground" Value="{StaticResource TrayOnAccent}"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>

  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
    <Border Height="1" Background="#12FFFFFF" Margin="9,5" SnapsToDevicePixels="True"/>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Floating menu uses the tray's surface, radius and ink hierarchy. -->
  <Style TargetType="MenuItem">
   <Setter Property="Foreground" Value="{x:Static svc:UiPalette.PrimaryBrush}"/>
   <Setter Property="FontFamily" Value="{StaticResource SFProText}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Padding" Value="9,6,9,6"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <EventSetter Event="PreviewMouseLeftButtonDown" Handler="MenuItem_Pressed"/>
   <EventSetter Event="PreviewMouseLeftButtonUp" Handler="MenuItem_Released"/>
   <EventSetter Event="MouseLeave" Handler="MenuItem_Released"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
    <Grid Margin="0,1" SnapsToDevicePixels="True">
     <Border x:Name="MenuRow" CornerRadius="{StaticResource TrayRadiusSmall}" Padding="{TemplateBinding Padding}"
      local:TrayMotion.Background="Transparent" local:TrayMotion.BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
      <Grid x:Name="MenuContent" local:TrayMotion.Opacity="0.72">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="18"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <ContentPresenter x:Name="MenuIcon" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
       <Border x:Name="CheckBadge" Width="15" Height="15" CornerRadius="4" Background="Transparent" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Path Data="F0 M 6.71,12.99 Q 6.41,12.99 6.19,12.71 L 3.15,8.91 Q 3.07,8.82 3.04,8.73 Q 3.0,8.63 3.0,8.55 Q 3.0,8.34 3.13,8.21 Q 3.27,8.08 3.48,8.08 Q 3.73,8.08 3.91,8.32 L 6.68,11.85 L 12.12,3.26 Q 12.2,3.12 12.3,3.06 Q 12.4,3.01 12.54,3.01 Q 12.75,3.01 12.87,3.13 Q 13.0,3.26 13.0,3.47 Q 13.0,3.55 12.97,3.64 Q 12.94,3.73 12.87,3.83 L 7.2,12.72 Q 7.11,12.86 6.99,12.92 Q 6.87,12.99 6.71,12.99 Z" Fill="White" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <AccessText x:Name="MenuLabel" Grid.Column="1" Text="{TemplateBinding Header}" FontFamily="{StaticResource SFProDisplay}"
        FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"
        VerticalAlignment="Center" Margin="9,0,14,0"/>
       <TextBlock x:Name="MenuShortcut" Grid.Column="2" Style="{x:Null}" Text="{TemplateBinding InputGestureText}" FontFamily="{StaticResource SFProDisplay}" FontSize="11" FontWeight="Bold"
        Foreground="{x:Static svc:UiPalette.TertiaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
       <Path x:Name="SubArrow" Grid.Column="3" Data="M 1,1 L 5,5 1,9" Stroke="{x:Static svc:UiPalette.SecondaryBrush}" StrokeThickness="1.5"
        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="6" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="4,0,1,0" Visibility="Collapsed"/>
      </Grid>
     </Border>
     <Popup x:Name="PART_Popup" Placement="Right" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" HorizontalOffset="1" VerticalOffset="-14"
      IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" PopupAnimation="None"
      Focusable="False" Opened="Submenu_Opened" Closed="Submenu_Closed">
      <Grid Margin="10,8,10,12">
       <Border x:Name="SubmenuSurface" Style="{StaticResource TrayMenuSurface}" MinWidth="190">
        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
       </Border>
      </Grid>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True">
      <Setter TargetName="MenuRow" Property="local:TrayMotion.Background" Value="#18FFFFFF"/>
      <Setter TargetName="MenuRow" Property="local:TrayMotion.BorderBrush" Value="#0DFFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter TargetName="MenuContent" Property="local:TrayMotion.Opacity" Value="1"/>
     </Trigger>
     <Trigger Property="IsSubmenuOpen" Value="True">
      <Setter TargetName="MenuRow" Property="local:TrayMotion.Background" Value="#18FFFFFF"/>
      <Setter TargetName="MenuRow" Property="local:TrayMotion.BorderBrush" Value="#0DFFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter TargetName="MenuContent" Property="local:TrayMotion.Opacity" Value="1"/>
     </Trigger>
     <Trigger Property="HasItems" Value="True">
      <Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/>
     </Trigger>
     <Trigger Property="IsChecked" Value="True">
      <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible"/>
      <Setter TargetName="MenuIcon" Property="Visibility" Value="Collapsed"/>
     </Trigger>
     <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="danger">
      <Setter Property="Foreground" Value="{StaticResource TrayDestructive}"/>
     </DataTrigger>
     <MultiDataTrigger>
      <MultiDataTrigger.Conditions>
       <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="danger"/>
       <Condition Binding="{Binding IsHighlighted, RelativeSource={RelativeSource Self}}" Value="True"/>
      </MultiDataTrigger.Conditions>
      <Setter TargetName="MenuRow" Property="local:TrayMotion.Background" Value="#18FF453A"/>
      <Setter TargetName="MenuRow" Property="local:TrayMotion.BorderBrush" Value="#14FF453A"/>
      <Setter Property="Foreground" Value="#FF6961"/>
     </MultiDataTrigger>
     <Trigger Property="IsEnabled" Value="False">
      <Setter Property="Opacity" Value="0.4"/>
     </Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ContextMenu">
   <Setter Property="FontFamily" Value="{StaticResource SFProText}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="HasDropShadow" Value="False"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="UseLayoutRounding" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
    <Grid Margin="10,8,10,12">
     <Border x:Name="MenuSurface" Style="{StaticResource TrayMenuSurface}" MinWidth="220">
      <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
     </Border>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>

 <Grid x:Name="SelectionSurface" Background="Transparent">
  <!-- Background content container (blurred and hit-test disabled during confirmation) -->
  <Grid x:Name="TrayContentGrid">
   <Grid.RowDefinitions>
    <RowDefinition Height="34"/>
    <RowDefinition Height="42"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>

   <!-- Row 0: Top Header (NavTabs Clearance + Flagship Search Capsule & Toolbar) -->
   <Grid Grid.Row="0" Margin="12,0,12,0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="{Binding NavigationWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ClipboardTray}}}"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    
    <Border x:Name="SearchSurface" Grid.Column="1" Height="34" MaxWidth="340" HorizontalAlignment="Stretch" Margin="8,0,0,0"
     Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="17">
     <Grid>
      <local:TrayIcon Kind="Search" Width="13" Height="13" Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#70FFFFFF"/>
      <Grid x:Name="SearchTextSurface" Margin="34,0,34,0">
       <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" FontSize="12.5"
        FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" VerticalContentAlignment="Center" TextChanged="Search_Changed"/>
       <TextBlock x:Name="SearchHint" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12.5" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" Foreground="#50FFFFFF"/>
       <!-- Left Edge Black Fade -->
       <Border x:Name="SearchFadeLeft" Width="20" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0">
        <Border.Background>
         <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#E608080C" Offset="0"/>
          <GradientStop Color="#0008080C" Offset="1"/>
         </LinearGradientBrush>
        </Border.Background>
       </Border>
       <!-- Right Edge Black Fade -->
       <Border x:Name="SearchFadeRight" Width="20" HorizontalAlignment="Right" IsHitTestVisible="False" Opacity="0">
        <Border.Background>
         <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
          <GradientStop Color="#E608080C" Offset="0"/>
          <GradientStop Color="#0008080C" Offset="1"/>
         </LinearGradientBrush>
        </Border.Background>
       </Border>
      </Grid>
      <Button x:Name="ClearSearchButton" Style="{StaticResource HeaderIconButton}" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center"
       Margin="2,0,4,0" Click="ClearSearch_Click">
       <Path Data="M 3,3 L 11,11 M 11,3 L 3,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="14" Height="14" IsHitTestVisible="False"/>
      </Button>
     </Grid>
    </Border>

   <Border x:Name="ToolbarSurface" Grid.Column="2" Visibility="Collapsed" Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="17" Height="34" Padding="3,0">
    <StackPanel Orientation="Horizontal">
     <Button x:Name="KeyboardButton" Style="{StaticResource HeaderIconButton}" Click="Keyboard_Click">
      <local:TrayIcon Kind="Keyboard" Width="13.5" Height="13.5"/>
     </Button>
     <Button x:Name="PauseButton" Style="{StaticResource HeaderIconButton}" Click="Pause_Click">
      <local:TrayIcon x:Name="PauseGlyph" Kind="Pause" Width="12.5" Height="12.5"/>
     </Button>
     <Button x:Name="InfoButton" Style="{StaticResource HeaderIconButton}" Click="Info_Click">
      <local:TrayIcon Kind="Info" Width="13.5" Height="13.5"/>
     </Button>
    </StackPanel>
   </Border>
  </Grid>

  <!-- Row 1: Apple Segmented Pill Track (Plush Rounded Capsule) -->
  <ScrollViewer x:Name="CategoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" ScrollChanged="TrayScroll_Changed" SizeChanged="TrayScroll_SizeChanged" PreviewMouseWheel="Category_Wheel" Margin="12,3,12,5">
   <Border CornerRadius="17" Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="3" HorizontalAlignment="Left">
    <Grid>
     <Border x:Name="CategorySelection" Width="1" HorizontalAlignment="Left" CornerRadius="13" IsHitTestVisible="False" Opacity="0">
      <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="CategorySelectionScale"/><TranslateTransform x:Name="CategorySelectionOffset"/></TransformGroup></Border.RenderTransform>
     </Border>
    <ItemsControl x:Name="CategoryPanel" LayoutUpdated="CategoryPanel_LayoutUpdated">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ClipboardCategoryViewModel}">
      <Button Style="{StaticResource CategoryButton}">
       <StackPanel Orientation="Horizontal">
        <local:TrayIcon Kind="{Binding IconKind}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource SFProDisplay}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding CountLabel, NotifyOnTargetUpdated=True}" TargetUpdated="CategoryCount_TargetUpdated" RenderTransformOrigin="0.5,0.5" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource SFProDisplay}" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Opacity" Value="0.55"/>
           <Setter Property="Visibility" Value="Visible"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding IsPersonal}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Opacity" Value="0.75"/></DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
        <local:TrayIcon Kind="{Binding LockIconKind}" Width="10" Height="10" Margin="5,0,0,0" VerticalAlignment="Center">
         <local:TrayIcon.Style>
          <Style TargetType="local:TrayIcon">
           <Setter Property="Visibility" Value="Collapsed"/>
           <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
           <Style.Triggers><DataTrigger Binding="{Binding IsPersonal}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style>
         </local:TrayIcon.Style>
        </local:TrayIcon>
       </StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    </Grid>
   </Border>
  </ScrollViewer>

  <!-- Import Progress Indicator -->
  <ProgressBar x:Name="ImportProgressBar" Grid.Row="1" Height="2.5" VerticalAlignment="Bottom" Margin="14,0,14,0"
               Background="Transparent" BorderThickness="0" Foreground="{StaticResource TrayAccent}"
               Visibility="Collapsed" Opacity="0" Minimum="0" Maximum="100"/>

  <!-- Row 2: Cards Canvas & Overlays -->
  <Grid x:Name="CardsViewport" Grid.Row="2" Background="Transparent" Cursor="Cross">
   <!-- Permanent Tray Drop Zone Silhouette Border (Framing both empty and filled tray) -->
   <Rectangle x:Name="TrayDropBorder" Margin="2,2,2,4" RadiusX="14" RadiusY="14"
              Fill="Transparent" Stroke="#75FFFFFF" StrokeThickness="2.0" StrokeDashArray="5 4"
              IsHitTestVisible="False"/>

   <!-- Animated opacity masks and rounded clips need antialiased composition;
        do not propagate pixel-snapping guidelines or force ClearType into them. -->
   <local:ClipboardCardListBox x:Name="Cards" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Hidden" SnapsToDevicePixels="False" UseLayoutRounding="False" TextOptions.TextRenderingMode="Grayscale"
    ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
    VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0.5" VirtualizingPanel.CacheLengthUnit="Page" TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Auto" PreviewMouseWheel="Cards_Wheel"
    ScrollViewer.ScrollChanged="TrayScroll_Changed" SizeChanged="TrayScroll_SizeChanged" PreviewKeyDown="Cards_KeyDown" SelectionMode="Extended" Margin="8,14,8,16">
    
    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
     <EventSetter Event="Loaded" Handler="CardContainer_Loaded"/>
     <EventSetter Event="Unloaded" Handler="CardContainer_Unloaded"/>
     <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="6,0"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate DataType="{x:Type vm:ClipboardCardViewModel}">
     <!-- Flagship Card Container (Exact 210 Width Required by Interaction Tests) -->
     <Border Width="210" CornerRadius="{StaticResource TrayRadiusLarge}" Background="Transparent" BorderThickness="0" ClipToBounds="True" Cursor="Hand" SnapsToDevicePixels="False" UseLayoutRounding="True"
      ContextMenuOpening="Card_ContextMenu" Loaded="Card_Loaded" Unloaded="Card_Unloaded" DataContextChanged="Card_DataContextChanged" SizeChanged="Card_SizeChanged" PreviewMouseLeftButtonDown="Card_Down" PreviewMouseLeftButtonUp="Card_Up" PreviewMouseMove="Card_Move" MouseLeave="Card_MouseLeave" IsVisibleChanged="Card_VisibilityChanged">
      <Border.ContextMenu><ContextMenu/></Border.ContextMenu>
      <Grid x:Name="CardPresentation">
       <!-- Fade the surface with its content; the hit-test shell must not leave a blank tile behind. -->
       <Border CornerRadius="{StaticResource TrayRadiusLarge}" Background="{Binding CardBrush}" IsHitTestVisible="False"/>
       <!-- Card Visual Content (Blurred when copied) -->
       <Grid x:Name="CardContentGrid" local:TrayMotion.BlurRadius="{Binding IsCopied, Converter={StaticResource BoolBlur}}">
        <!-- Layer 1: Ambient Curved-Glass Specular Gradient Sheen -->
        <Border x:Name="CardSheen" CornerRadius="{StaticResource TrayRadiusLarge}" IsHitTestVisible="False">
         <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
           <GradientStop Color="#1AFFFFFF" Offset="0"/>
           <GradientStop Color="#06FFFFFF" Offset="0.32"/>
           <GradientStop Color="#00FFFFFF" Offset="0.65"/>
           <GradientStop Color="#10000000" Offset="1"/>
          </LinearGradientBrush>
         </Border.Background>
        </Border>

        <!-- Layer 2: Image Thumbnail -->
        <!-- Fit the entire preview inside the card, clear of actions and metadata. -->
        <Image Source="{Binding Image, NotifyOnTargetUpdated=True}" TargetUpdated="CardPreview_TargetUpdated" Stretch="Uniform" Margin="8,32,8,34" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        
        <!-- Layer 3: Protective Vignette for Image readability -->
        <Border CornerRadius="{StaticResource TrayRadiusLarge}" IsHitTestVisible="False">
         <Border.Style>
          <Style TargetType="Border">
           <Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding Entry.Kind}" Value="Image">
             <Setter Property="Visibility" Value="Visible"/>
             <Setter Property="Background">
              <Setter.Value>
               <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#55000000" Offset="0"/>
                <GradientStop Color="#00000000" Offset="0.32"/>
                <GradientStop Color="#00000000" Offset="0.58"/>
                <GradientStop Color="#90000000" Offset="1"/>
               </LinearGradientBrush>
              </Setter.Value>
             </Setter>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </Border.Style>
        </Border>

        <!-- Inset rims avoid overlapping the rounded card clip and losing edge coverage. -->
        <Rectangle x:Name="BaseRim" RadiusX="14" RadiusY="14" Margin="2" StrokeThickness="2" IsHitTestVisible="False" Panel.ZIndex="2">
         <Rectangle.Stroke>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
           <GradientStop Color="#70FFFFFF" Offset="0"/>
           <GradientStop Color="#48FFFFFF" Offset="0.45"/>
           <GradientStop Color="#38FFFFFF" Offset="1"/>
          </LinearGradientBrush>
         </Rectangle.Stroke>
        </Rectangle>

        <!-- Layer 4b: Hover Optical Rim (Smooth animated illumination on card hover) -->
        <Rectangle x:Name="HoverRim" RadiusX="14" RadiusY="14" Margin="2" StrokeThickness="2" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="3">
         <Rectangle.Stroke>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
           <GradientStop Color="#85FFFFFF" Offset="0"/>
           <GradientStop Color="#45FFFFFF" Offset="0.45"/>
           <GradientStop Color="#20FFFFFF" Offset="1"/>
          </LinearGradientBrush>
         </Rectangle.Stroke>
        </Rectangle>

        <!-- Layer 4c: Selected Optical Rim (High-contrast animated rim on selection) -->
        <Rectangle x:Name="SelectedRim" RadiusX="14" RadiusY="14" Margin="2" StrokeThickness="2" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="4">
         <Rectangle.Stroke>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
           <GradientStop Color="#FFFFFF" Offset="0"/>
           <GradientStop Color="#E6FFFFFF" Offset="0.5"/>
           <GradientStop Color="#B8FFFFFF" Offset="1"/>
          </LinearGradientBrush>
         </Rectangle.Stroke>
        </Rectangle>

        <!-- Layer 5: Card Actions (Pin & More) in Top Right -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" Panel.ZIndex="4">
         <Button Tag="pin" Style="{StaticResource PinActionButton}" ToolTip="{Binding PinLabel}" Click="CardAction_Click">
          <local:TrayIcon Kind="Pin" Width="14.5" Height="14.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
         </Button>
         <Button Tag="more" Style="{StaticResource MoreActionButton}" ToolTip="{Binding MoreLabel}" PreviewMouseDown="MoreActions_PointerDown" Click="MoreActions_Click">
          <local:TrayIcon Kind="More" Width="13" Height="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
         </Button>
        </StackPanel>

        <!-- Layer 5b: File Card Hero Presentation (Kind == File) -->
        <Border x:Name="FileBadgePanel" Margin="12,30,12,30" CornerRadius="12" Background="{Binding FileBadgeBackgroundBrush}" BorderThickness="1" BorderBrush="{Binding FileAccentBrush}" Padding="10,6" IsHitTestVisible="False">
         <Border.Style>
          <Style TargetType="Border">
           <Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding Entry.Kind}" Value="File">
             <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </Border.Style>
         <Grid>
          <Grid.RowDefinitions>
           <RowDefinition Height="Auto"/>
           <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Grid x:Name="FileHeroIcon" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,7,0">
           <Image Source="{Binding FileIcon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
           <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="20"
                      Foreground="{Binding FileAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
             <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding FileIcon}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible"/>
               </DataTrigger>
              </Style.Triggers>
             </Style>
            </TextBlock.Style>
           </TextBlock>
          </Grid>
          <Border CornerRadius="4" Background="{Binding FileAccentBrush}" Padding="6,1.5" VerticalAlignment="Center">
           <TextBlock Text="{Binding FileTypeTag}" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource SFProDisplay}" Foreground="White"/>
          </Border>
          </StackPanel>
          <TextBlock x:Name="FileHeroName" Grid.Row="1" Text="{Binding Title}" ToolTip="{Binding Title}" FontFamily="{StaticResource SFProDisplay}" FontSize="11" LineHeight="14" Foreground="#F5F5FA" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" VerticalAlignment="Center" MaxHeight="28" Margin="0,4,0,0"/>
         </Grid>
        </Border>

        <!-- Layer 6: Text Preview (High-Contrast SF Pro Typographic Balance) -->
        <TextBlock x:Name="CardPreviewText" Text="{Binding Preview}" FontFamily="{StaticResource SFProDisplay}" FontSize="12.5" FontWeight="Bold" LineHeight="17.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="13,34,13,34" VerticalAlignment="Top" MaxHeight="96" Foreground="#F5F5FA"/>

        <!-- Layer 7: Seamless Frosted Vignette Footer -->
        <Border VerticalAlignment="Bottom" Height="34" CornerRadius="0,0,16,16">
         <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
           <GradientStop Color="#0009090D" Offset="0"/>
           <GradientStop Color="#7009090D" Offset="0.35"/>
           <GradientStop Color="#EA060609" Offset="1"/>
          </LinearGradientBrush>
         </Border.Background>
         <Grid Margin="10,0,10,0">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="22"/>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          
          <Border Width="18" Height="18" CornerRadius="4.5" Background="#18FFFFFF" BorderThickness="0.8" BorderBrush="#20FFFFFF" ClipToBounds="True" ToolTip="{Binding Source}">
           <Grid>
            <local:TrayIcon Kind="{Binding IconKind}" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{Binding FileAccentBrush}">
             <local:TrayIcon.Style>
              <Style TargetType="local:TrayIcon">
               <Setter Property="Visibility" Value="Collapsed"/>
               <Style.Triggers>
                <MultiDataTrigger>
                 <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding SourceIcon}" Value="{x:Null}"/>
                  <Condition Binding="{Binding FileIcon}" Value="{x:Null}"/>
                 </MultiDataTrigger.Conditions>
                 <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
               </Style.Triggers>
              </Style>
             </local:TrayIcon.Style>
            </local:TrayIcon>
            <Image Source="{Binding FileIcon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Image Source="{Binding SourceIcon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
           </Grid>
          </Border>

          <TextBlock Grid.Column="1" Text="{Binding Age}" FontFamily="{StaticResource SFProDisplay}" FontSize="11" FontWeight="Bold" Foreground="#C8C8D2" Margin="6,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="2" Text="{Binding Size}" Margin="0,0,2,0" FontSize="10" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" Foreground="{StaticResource TrayMutedForeground}" VerticalAlignment="Center"/>
         </Grid>
        </Border>
       </Grid>

       <!-- Subtle dark backdrop scrim (makes centered notification pop) -->
       <Border x:Name="CopiedScrim" Background="#35000000" CornerRadius="{StaticResource TrayRadiusLarge}"
               Opacity="0" IsHitTestVisible="False"/>

       <!-- Center Copied Feedback Notification with spring pop & smooth scale-fade dismiss -->
       <Border x:Name="CopiedBadge" HorizontalAlignment="Center" VerticalAlignment="Center"
               Padding="14,8"
               Opacity="0" IsHitTestVisible="False" Panel.ZIndex="10"
               RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
         <ScaleTransform ScaleX="0.70" ScaleY="0.70"/>
        </Border.RenderTransform>
        <TextBlock x:Name="CopiedLabel" Text="{Binding CopiedLabel}" FontSize="12" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center">
         <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="1" Opacity="0.85" RenderingBias="Performance"/></TextBlock.Effect>
        </TextBlock>
       </Border>
      </Grid>
     </Border>
     <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Entry.Kind}" Value="Color">
       <Setter TargetName="CardSheen" Property="Visibility" Value="Collapsed"/>
       <Setter TargetName="CardPreviewText" Property="Background" Value="#CC101014"/>
       <Setter TargetName="CardPreviewText" Property="Padding" Value="6,3"/>
       <Setter TargetName="CardPreviewText" Property="HorizontalAlignment" Value="Left"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Entry.Kind}" Value="File">
       <Setter TargetName="CardPreviewText" Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Entry.Kind}" Value="Image">
       <Setter TargetName="CardPreviewText" Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
      <!-- Animated appearing & disappearing for Copied notification badge -->
      <DataTrigger Binding="{Binding IsCopied}" Value="True">
       <DataTrigger.EnterActions>
        <BeginStoryboard>
         <Storyboard>
          <DoubleAnimation Storyboard.TargetName="CopiedBadge" Storyboard.TargetProperty="Opacity"
                           To="1.0" Duration="0:0:0.20">
           <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CopiedBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
           <DiscreteDoubleKeyFrame Value="0.70" KeyTime="0:0:0"/>
           <SplineDoubleKeyFrame Value="1.10" KeyTime="0:0:0.13" KeySpline="0.2,0.8,0.4,1.0"/>
           <SplineDoubleKeyFrame Value="1.0" KeyTime="0:0:0.22" KeySpline="0.4,0,0.2,1.0"/>
          </DoubleAnimationUsingKeyFrames>
          <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CopiedBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
           <DiscreteDoubleKeyFrame Value="0.70" KeyTime="0:0:0"/>
           <SplineDoubleKeyFrame Value="1.10" KeyTime="0:0:0.13" KeySpline="0.2,0.8,0.4,1.0"/>
           <SplineDoubleKeyFrame Value="1.0" KeyTime="0:0:0.22" KeySpline="0.4,0,0.2,1.0"/>
          </DoubleAnimationUsingKeyFrames>
          <DoubleAnimation Storyboard.TargetName="CopiedScrim" Storyboard.TargetProperty="Opacity"
                           To="1.0" Duration="0:0:0.20">
           <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
         </Storyboard>
        </BeginStoryboard>
       </DataTrigger.EnterActions>
       <DataTrigger.ExitActions>
        <BeginStoryboard>
         <Storyboard>
          <DoubleAnimation Storyboard.TargetName="CopiedBadge" Storyboard.TargetProperty="Opacity"
                           To="0.0" Duration="0:0:0.24">
           <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="CopiedBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                           To="0.70" Duration="0:0:0.24">
           <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="CopiedBadge" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                           To="0.70" Duration="0:0:0.24">
           <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="CopiedScrim" Storyboard.TargetProperty="Opacity"
                           To="0.0" Duration="0:0:0.24">
           <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
         </Storyboard>
        </BeginStoryboard>
       </DataTrigger.ExitActions>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
       <DataTrigger.EnterActions>
        <BeginStoryboard>
         <Storyboard>
          <DoubleAnimation Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18">
           <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
         </Storyboard>
        </BeginStoryboard>
       </DataTrigger.EnterActions>
       <DataTrigger.ExitActions>
        <BeginStoryboard>
         <Storyboard>
          <DoubleAnimation Storyboard.TargetName="HoverRim" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.22">
           <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
         </Storyboard>
        </BeginStoryboard>
       </DataTrigger.ExitActions>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
       <DataTrigger.EnterActions>
        <BeginStoryboard>
         <Storyboard>
          <DoubleAnimation Storyboard.TargetName="SelectedRim" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18">
           <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
         </Storyboard>
        </BeginStoryboard>
       </DataTrigger.EnterActions>
       <DataTrigger.ExitActions>
        <BeginStoryboard>
         <Storyboard>
          <DoubleAnimation Storyboard.TargetName="SelectedRim" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.22">
           <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
         </Storyboard>
        </BeginStoryboard>
       </DataTrigger.ExitActions>
      </DataTrigger>
     </DataTemplate.Triggers>
    </DataTemplate></ListBox.ItemTemplate>
   </local:ClipboardCardListBox>
   <Grid Margin="8,14,8,16" IsHitTestVisible="False">
    <Border x:Name="CardsFadeLeft" Width="22" HorizontalAlignment="Left" Opacity="0">
     <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
       <GradientStop Color="Black" Offset="0"/><GradientStop Color="#00000000" Offset="1"/>
      </LinearGradientBrush>
     </Border.Background>
    </Border>
    <Border x:Name="CardsFadeRight" Width="22" HorizontalAlignment="Right" Opacity="0">
     <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
       <GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/>
      </LinearGradientBrush>
     </Border.Background>
    </Border>
   </Grid>

   <!-- Empty State Center Content (Shown within TrayDropBorder) -->
   <Grid x:Name="EmptyDropSilhouette" IsHitTestVisible="False" Visibility="Collapsed">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,20">
     <!-- Downward Arrow Import Icon without circular background -->
     <Border x:Name="EmptyDropIcon" Background="Transparent" BorderThickness="0"
             HorizontalAlignment="Center" Margin="0,0,0,12">
      <Path Data="M 12,4 L 12,17 M 7,12 L 12,17 L 17,12 M 5,20 L 19,20" Stroke="#E0FFFFFF" StrokeThickness="2.0"
            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock TextWrapping="Wrap" TextAlignment="Center" x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                Foreground="#F2FFFFFF" FontSize="14" FontFamily="{StaticResource SFProDisplay}"
                FontWeight="Bold" MaxWidth="380" LineHeight="20" Visibility="Collapsed"/>
     <TextBlock x:Name="EmptyDropHint" Text="Kéo thả tệp hoặc ảnh vào đây để ghim nhanh"
                TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                Foreground="#A4FFFFFF" FontSize="12" FontFamily="{StaticResource SFProDisplay}"
                FontWeight="Medium" MaxWidth="360"/>
    </StackPanel>
   </Grid>

   <!-- Personal Lock Screen -->
   <Grid x:Name="LockPanel" Visibility="Collapsed" Background="Transparent" Cursor="Arrow">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
     <local:TrayIcon Kind="Lock" Width="20" Height="20" Margin="0,14,0,14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E5FFFFFF"/>
     <TextBlock x:Name="LockTitle" FontSize="17" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,12"/>
     <Grid HorizontalAlignment="Center">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="44"/>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="44"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="1" Width="220" Height="36" Background="#12FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="18">
       <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Visual animated PIN dots (centered) -->
        <StackPanel x:Name="PinDotsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
         <Border x:Name="PinDot0" Width="10" Height="10" Margin="4.5,0" CornerRadius="5" Background="White" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0"/></Border.RenderTransform>
         </Border>
         <Border x:Name="PinDot1" Width="10" Height="10" Margin="4.5,0" CornerRadius="5" Background="White" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0"/></Border.RenderTransform>
         </Border>
         <Border x:Name="PinDot2" Width="10" Height="10" Margin="4.5,0" CornerRadius="5" Background="White" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0"/></Border.RenderTransform>
         </Border>
         <Border x:Name="PinDot3" Width="10" Height="10" Margin="4.5,0" CornerRadius="5" Background="White" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0"/></Border.RenderTransform>
         </Border>
         <Border x:Name="PinDot4" Width="10" Height="10" Margin="4.5,0" CornerRadius="5" Background="White" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0"/></Border.RenderTransform>
         </Border>
         <Border x:Name="PinDot5" Width="10" Height="10" Margin="4.5,0" CornerRadius="5" Background="White" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0"/></Border.RenderTransform>
         </Border>
        </StackPanel>
        <Border x:Name="PinCaret" Width="2" Height="22" CornerRadius="1" Background="White"
                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
         <Border.RenderTransform><TranslateTransform x:Name="PinCaretOffset"/></Border.RenderTransform>
         <Border.Effect><DropShadowEffect Color="White" BlurRadius="10" ShadowDepth="0" Opacity="0.95"/></Border.Effect>
        </Border>
        <!-- Native input remains responsible for editing; the visible caret follows the PIN dots. -->
        <PasswordBox x:Name="PasscodeBox" MaxLength="6" FontSize="18" PasswordChar="●"
                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                     Background="Transparent" Foreground="Transparent" CaretBrush="Transparent"
                     GotKeyboardFocus="Passcode_FocusChanged" LostKeyboardFocus="Passcode_FocusChanged"
                     IsVisibleChanged="Passcode_VisibilityChanged"
                     BorderThickness="0" Padding="0" KeyDown="Passcode_KeyDown"/>
       </Grid>
      </Border>
      <Button x:Name="UnlockButton" Grid.Column="2" Width="36" Height="36" Margin="8,0,0,0" Background="White" Foreground="#121216" Style="{StaticResource TrayButton}" Padding="0" Click="Unlock_Click">
       <local:TrayIcon Kind="Arrow" Width="16" Height="16" Foreground="#121216"/>
      </Button>
     </Grid>
     <TextBlock x:Name="LockHint" FontSize="12" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" Foreground="{StaticResource TrayMutedForeground}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
     <Button x:Name="PinBackButton" Visibility="Collapsed" Style="{StaticResource TrayButton}" HorizontalAlignment="Center" Click="PinBack_Click" Margin="0,6,0,0"/>
     <Button x:Name="ForgotPinButton" Style="{StaticResource ForgotPinButtonStyle}" Click="ForgotPin_Click" Margin="0,6,0,0"/>
    </StackPanel>
   </Grid>

   <!-- Approval Dialog -->
   <Border x:Name="ApprovalPanel" Visibility="Collapsed" Background="{StaticResource TraySurfaceOverlay}" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="{StaticResource TrayRadiusLarge}" Padding="20" Panel.ZIndex="20" Cursor="Arrow">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock x:Name="ApprovalText" FontSize="13.5" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
      <Button x:Name="ApproveButton" Style="{StaticResource TrayButton}" Background="{StaticResource TrayAccent}" Foreground="{StaticResource TrayOnAccent}" Margin="0,0,10,0" Click="Approve_Click"/>
      <Button x:Name="SkipButton" Style="{StaticResource TrayButton}" Click="Skip_Click"/>
     </StackPanel>
    </StackPanel>
   </Border>

   <!-- Details & Sheet Panel -->
   <Border x:Name="DetailPanel" Visibility="Collapsed" BorderThickness="1" CornerRadius="{StaticResource TrayRadiusLarge}" Panel.ZIndex="10" Cursor="Arrow">
    <Border.Style>
     <Style TargetType="Border">
      <Setter Property="Background" Value="#F0101016"/>
      <Setter Property="BorderBrush" Value="#25FFFFFF"/>
      <Setter Property="Padding" Value="16"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding Visibility, ElementName=ResetConfirmationPanel}" Value="Visible">
        <Setter Property="Background" Value="#FF111113"/>
        <Setter Property="BorderBrush" Value="#30FFFFFF"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="MaxWidth" Value="500"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </Border.Style>
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid>
      <Grid.Style>
       <Style TargetType="Grid">
        <Style.Triggers>
         <DataTrigger Binding="{Binding Visibility, ElementName=ResetConfirmationPanel}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers>
       </Style>
      </Grid.Style>
      <ItemsControl x:Name="GroupChoices" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="450">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:ClipboardGroupChoiceViewModel}">
        <CheckBox Style="{StaticResource TrayGroupChoice}" Checked="GroupChoice_Motion" Unchecked="GroupChoice_Motion" Content="{Binding Label}" Tag="{Binding ActiveName}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
         Foreground="White" Margin="10" FontWeight="SemiBold" AutomationProperties.Name="{Binding Label}"/>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Image x:Name="DetailImage" Visibility="Collapsed" Stretch="Uniform"/>
      <ScrollViewer x:Name="DetailTextScroll" VerticalScrollBarVisibility="Auto">
       <TextBox x:Name="DetailText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="#F0F0F5" BorderThickness="0" FontSize="13" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold"/>
      </ScrollViewer>
     </Grid>
      <Grid x:Name="ResetConfirmationPanel" Grid.RowSpan="2" Visibility="Collapsed" MinWidth="280">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       <TextBlock x:Name="ResetConfirmationTitle" FontSize="16" FontWeight="Bold" FontFamily="{StaticResource SFProDisplay}" Foreground="White" TextWrapping="Wrap"/>
       <TextBlock x:Name="ResetConfirmationHint" Grid.Row="1" TextWrapping="Wrap" FontSize="12.5" LineHeight="17" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" Foreground="{StaticResource TrayMutedForeground}" Margin="0,4,0,8"/>
       <Border Grid.Row="2" CornerRadius="{StaticResource TrayRadiusSmall}" Background="#12FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Height="32" Margin="0,0,0,8">
        <Grid Margin="12,0">
         <TextBox x:Name="ResetConfirmationBox" MaxLength="6" TextChanged="ResetConfirmation_Changed" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" FontSize="12.5" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" VerticalContentAlignment="Center"/>
         <TextBlock Text="DELETE" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12.5" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" Foreground="#40FFFFFF">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding Text, ElementName=ResetConfirmationBox}" Value="">
              <Setter Property="Visibility" Value="Visible"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
        </Grid>
       </Border>
       <Grid Grid.Row="3" Margin="0,2,0,4">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="1*"/>
         <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="ResetCloseButton" Style="{StaticResource TrayButton}" MinWidth="80" MinHeight="36" Margin="0,0,5,0" Click="CloseDetail_Click"/>
        <Button x:Name="ResetPersonalButton" Grid.Column="1" Style="{StaticResource ResetDestructiveButtonStyle}" Visibility="Collapsed" IsEnabled="False" MinHeight="36" Margin="5,0,0,0" Padding="12,5" Click="ResetPersonal_Click">
         <TextBlock x:Name="ResetPersonalLabel" TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold"/>
        </Button>
       </Grid>
      </Grid>
      <Grid Grid.Row="1" Margin="0,10,0,0">
       <Grid.Style>
        <Style TargetType="Grid">
         <Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=ResetConfirmationPanel}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
       </Grid.Style>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="CopyDetailButton" Visibility="Collapsed" Style="{StaticResource TrayButton}" Margin="0,0,8,0" Click="CopyDetail_Click"/>
        <Button x:Name="CloseDetailButton" Style="{StaticResource TrayButton}" Click="CloseDetail_Click"/>
       </StackPanel>
      </Grid>
    </Grid>
   </Border>
  </Grid>
  <Border x:Name="StatusPanel" Grid.Row="2" Panel.ZIndex="100" Visibility="Collapsed"
          HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="420" IsHitTestVisible="False"
          Background="{StaticResource TraySurfaceOverlay}" BorderBrush="#25FFFFFF" BorderThickness="1"
          CornerRadius="{StaticResource TrayRadiusMedium}" Padding="10,6" Margin="12,0,12,8">
   <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
  </Border>
 </Grid>

 <!-- Marquee spans the tray so drags can begin in the surrounding empty space. -->
 <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="5">
  <Border x:Name="SelectionRectangle" Visibility="Collapsed" Background="#24D1D5DB" BorderBrush="#C0E5E7EB" BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True"/>
 </Canvas>

 <!-- Delete Confirmation Dialog (global modal overlay covering all rows; OLED black background, modal barrier) -->
 <Grid x:Name="DeleteConfirmationPanel" Visibility="Collapsed" Panel.ZIndex="100" Background="#8A000000"
       KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"
       PreviewMouseLeftButtonDown="DeleteConfirmationBackdrop_MouseDown">
  <Border x:Name="DeleteConfirmationBorder" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
          Background="#FF000000" BorderBrush="#55FF453A" BorderThickness="1.8"
          CornerRadius="{StaticResource TrayRadiusLarge}" Padding="18,16" Margin="16">
   <Border.Effect>
    <DropShadowEffect BlurRadius="32" ShadowDepth="6" Direction="270" Color="Black" Opacity="0.75" RenderingBias="Performance"/>
   </Border.Effect>
   <StackPanel>
    <TextBlock x:Name="DeleteConfirmationText" TextWrapping="Wrap" FontSize="13" LineHeight="18"
               FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" Foreground="White"
               AutomationProperties.LiveSetting="Assertive"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
     <Button x:Name="CancelDeleteButton" Style="{StaticResource TrayButton}" Click="CancelDelete_Click" Margin="0,0,10,0" Padding="14,6"/>
     <Button x:Name="ConfirmDeleteButton" Style="{StaticResource TrayButton}" Background="{StaticResource TrayDestructive}" Foreground="White" Click="ConfirmDelete_Click" Padding="14,6"/>
    </StackPanel>
   </StackPanel>
  </Border>
 </Grid>
</Grid>
</UserControl>
