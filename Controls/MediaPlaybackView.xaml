<UserControl xmlns:fonts="clr-namespace:VNotch.Services"
        x:Class="VNotch.Controls.MediaPlaybackView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ctrl="clr-namespace:VNotch.Controls" xmlns:svc="clr-namespace:VNotch.Services"
 SizeChanged="MediaWidgetContainer_SizeChanged">
 <UserControl.Resources>
 <fonts:AppFont x:Key="MainSystemFont" Fallbacks="Nirmala UI, Segoe UI" />
 <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{x:Static svc:UiPalette.PrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource MainSystemFont}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Animated"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
<Style x:Key="SubtitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{x:Static svc:UiPalette.SecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource MainSystemFont}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Animated"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
<Style x:Key="ProgressTimeText" TargetType="TextBlock" BasedOn="{StaticResource SubtitleText}"><Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Typography.NumeralStyle" Value="Lining"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.55" Color="Black" RenderingBias="Performance"/>
                </Setter.Value>
            </Setter>
        </Style>
 <Geometry x:Key="PauseButtonSvgIcon">M172,3605 C171.448,3605 171,3605.448 171,3606 L171,3612 C171,3612.552 
