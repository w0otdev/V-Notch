        <Geometry x:Key="PlayButtonSvgIcon">M9.629,44.68c-1.154,1.16-2.895,1.51-4.407,0.885c-1.513-0.623-2.5-2.1-2.5-3.735V4.043c0-1.637,0.987-3.112,2.5-3.736 
c1.513-0.625,3.253-0.275,4.407,0.885l17.862,17.951c2.088,2.098,2.088,5.488,0,7.585L9.629,44.68z</Geometry>
 <LinearGradientBrush x:Key="TrackTitleGradient"><GradientStop Color="White" Offset="0"/><GradientStop Color="White" Offset="1"/></LinearGradientBrush>
 <LinearGradientBrush x:Key="TrackTitleNextGradient"><GradientStop Color="White" Offset="0"/><GradientStop Color="White" Offset="1"/></LinearGradientBrush>
 </UserControl.Resources>
 <Grid x:Name="MediaInfoSection"
                                          Grid.Column="0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"
                                          Margin="0,-1,0,0"
                                          SizeChanged="MediaInfoSection_SizeChanged">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" MaxWidth="340" RenderOptions.ClearTypeHint="Enabled" Margin="0,0,0,0">
                                            <StackPanel.OpacityMask>
                                                <LinearGradientBrush x:Name="TextFadeBrush" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="Black" Offset="0"/>
                                                    <GradientStop Color="Black" Offset="0.8"/>
                                                    <GradientStop Color="Transparent" Offset="1"/>
                                                </LinearGradientBrush>
                                            </StackPanel.OpacityMask>

                                            <!-- Leave headroom for Vietnamese accents inside the marquee clip. -->
                                            <Canvas x:Name="TitleScrollContainer" Height="24" Width="340" ClipToBounds="True">
                                                <Grid x:Name="TitleMorphContainer" Canvas.Left="0" Canvas.Top="1">

                                                    <Grid x:Name="TrackTitleLayer" Opacity="1">
                                                        <Grid.RenderTransform>
                                                            <TransformGroup>
                                                                <TranslateTransform x:Name="TitleMarqueeTranslate" X="0"/>
                                                                <TranslateTransform x:Name="TitleMorphTranslate" Y="0"/>
                                                            </TransformGroup>
                                                        </Grid.RenderTransform>

                                                        <TextBlock Text="{Binding Text, ElementName=TrackTitle}"
                                                                   Style="{StaticResource TitleText}" TextOptions.TextHintingMode="Animated"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="#80000000"
                                                                   Margin="0,1,0,0" />

                                                        <TextBlock x:Name="TrackTitle"
                                                                   Text="No media playing"
                                                                   Style="{StaticResource TitleText}" TextOptions.TextHintingMode="Animated"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TrackTitleGradient}" />
                                                    </Grid>

                                                    <Grid x:Name="TrackTitleNextLayer" Opacity="0">
                                                        <Grid.RenderTransform>
                                                            <TransformGroup>
                                                                <TranslateTransform x:Name="TitleMarqueeTranslateNext" X="0"/>
                                                                <TranslateTransform x:Name="TitleMorphTranslateNext" Y="0"/>
                                                            </TransformGroup>
                                                        </Grid.RenderTransform>

                                                        <TextBlock Text="{Binding Text, ElementName=TrackTitleNext}"
                                                                   Style="{StaticResource TitleText}" TextOptions.TextHintingMode="Animated"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="#80000000"
                                                                   Margin="0,1,0,0" />

                                                        <TextBlock x:Name="TrackTitleNext"
                                                                   Text=""
                                                                   Style="{StaticResource TitleText}" TextOptions.TextHintingMode="Animated"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TrackTitleNextGradient}" />
                                                    </Grid>
                                                </Grid>
                                            </Canvas>

                                            <Canvas x:Name="ArtistScrollContainer" Height="18" Width="340" ClipToBounds="True" Margin="0,1,0,0">
                                                <Grid x:Name="ArtistMorphContainer" Canvas.Left="0" Canvas.Top="-1">

                                                    <Grid x:Name="TrackArtistLayer" Opacity="1">
                                                        <Grid.RenderTransform>
                                                            <TransformGroup>
                                                                <TranslateTransform x:Name="ArtistMarqueeTranslate" X="0"/>
                                                                <TranslateTransform x:Name="ArtistMorphTranslate" Y="0"/>
                                                            </TransformGroup>
                                                        </Grid.RenderTransform>

                                                        <TextBlock Text="{Binding Text, ElementName=TrackArtist}"
                                                                   Style="{StaticResource SubtitleText}"
                                                                   FontWeight="Bold"
                                                                   Foreground="#80000000"
                                                                   Margin="0,1,0,0" />

                                                        <TextBlock x:Name="TrackArtist"
                                                                     Text="Artist name"
                                                                     Style="{StaticResource SubtitleText}"
                                                                    Foreground="{x:Static svc:UiPalette.SecondaryBrush}"
                                                                    FontWeight="Bold" />
                                                     </Grid>

                                                     <Grid x:Name="TrackArtistNextLayer" Opacity="0">
                                                        <Grid.RenderTransform>
                                                            <TransformGroup>
                                                                <TranslateTransform x:Name="ArtistMarqueeTranslateNext" X="0"/>
                                                                <TranslateTransform x:Name="ArtistMorphTranslateNext" Y="0"/>
                                                            </TransformGroup>
                                                        </Grid.RenderTransform>

                                                        <TextBlock Text="{Binding Text, ElementName=TrackArtistNext}"
                                                                   Style="{StaticResource SubtitleText}"
                                                                   FontWeight="Bold"
                                                                   Foreground="#80000000"
                                                                   Margin="0,1,0,0" />

                                                         <TextBlock x:Name="TrackArtistNext"
                                                                    Text=""
                                                                     Style="{StaticResource SubtitleText}"
                                                                    Foreground="{x:Static svc:UiPalette.SecondaryBrush}"
                                                                    FontWeight="Bold" />
                                                     </Grid>
                                                </Grid>
                                            </Canvas>
                                        </StackPanel>

                                        <Grid x:Name="MediaControls"
                                              Grid.Row="2"
                                              Width="{Binding ActualWidth, ElementName=ProgressSection}"
                                              VerticalAlignment="Top"
                                              HorizontalAlignment="Left"
                                              Margin="0,2,0,0">
                                            <Grid.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.2" Direction="270" Opacity="0.55" Color="Black" RenderingBias="Performance"/>
                                            </Grid.Effect>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                                <ctrl:ActionBorder x:Name="PrevButton" AutomationProperties.Name="Previous Track"
                                                        Grid.Column="0"
                                                        Background="Transparent"
                                                        Cursor="Hand"
                                                        Click="PrevButton_Click"
                                                        MouseEnter="MediaButton_MouseEnter"
                                                        MouseLeave="MediaButton_MouseLeave"
                                                        Width="32" Height="26"
                                                        Margin="0"
                                                        HorizontalAlignment="Left"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                <Viewbox Width="16" Height="16" Margin="0,0,0,0" Stretch="Uniform">
                                                    <Canvas Width="512" Height="512" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                                        <Path x:Name="PrevArrow0" Fill="{x:Static svc:UiPalette.PrimaryBrush}" StrokeThickness="0" Data="M30.71,229.47l188.87-113a30.54,30.54,0,0,1,31.09-.39,33.74,33.74,0,0,1,16.76,29.47V224.6L448.15,116.44a30.54,30.54,0,0,1,31.09-.39A33.74,33.74,0,0,1,496,145.52v221A33.73,33.73,0,0,1,479.24,396a30.54,30.54,0,0,1-31.09-.39L267.43,287.4v79.08A33.73,33.73,0,0,1,250.67,396a30.54,30.54,0,0,1-31.09-.39l-188.87-113a31.27,31.27,0,0,1,0-53Z" Opacity="0">
                                                            <Path.RenderTransform>
                                                                <TranslateTransform X="0" Y="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                        <Path x:Name="PrevArrow2" Fill="{x:Static svc:UiPalette.PrimaryBrush}" StrokeThickness="0" Data="M30.71,229.47l188.87-113a30.54,30.54,0,0,1,31.09-.39,33.74,33.74,0,0,1,16.76,29.47V224.6L448.15,116.44a30.54,30.54,0,0,1,31.09-.39A33.74,33.74,0,0,1,496,145.52v221A33.73,33.73,0,0,1,479.24,396a30.54,30.54,0,0,1-31.09-.39L267.43,287.4v79.08A33.73,33.73,0,0,1,250.67,396a30.54,30.54,0,0,1-31.09-.39l-188.87-113a31.27,31.27,0,0,1,0-53Z">
                                                            <Path.RenderTransform>
                                                                <TranslateTransform X="0" Y="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                        <Path x:Name="PrevArrow1" Fill="{x:Static svc:UiPalette.PrimaryBrush}" StrokeThickness="0" Data="M30.71,229.47l188.87-113a30.54,30.54,0,0,1,31.09-.39,33.74,33.74,0,0,1,16.76,29.47V224.6L448.15,116.44a30.54,30.54,0,0,1,31.09-.39A33.74,33.74,0,0,1,496,145.52v221A33.73,33.73,0,0,1,479.24,396a30.54,30.54,0,0,1-31.09-.39L267.43,287.4v79.08A33.73,33.73,0,0,1,250.67,396a30.54,30.54,0,0,1-31.09-.39l-188.87-113a31.27,31.27,0,0,1,0-53Z" Opacity="0">
                                                            <Path.RenderTransform>
                                                                <TranslateTransform X="0" Y="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Canvas>
                                                    </Viewbox>
                                                </ctrl:ActionBorder>

                                                <ctrl:ActionBorder x:Name="PlayPauseButton" AutomationProperties.Name="Play or Pause"
                                                        Grid.Column="1"
                                                        Background="Transparent"
                                                        Cursor="Hand"
                                                        Click="PlayPauseButton_Click"
                                                        MouseEnter="MediaButton_MouseEnter"
                                                        MouseLeave="MediaButton_MouseLeave"
                                                        Width="32" Height="26"
                                                        Margin="0"
                                                        HorizontalAlignment="Center"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                    <Viewbox Width="12.8" Height="13">
                                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas x:Name="PauseIcon" Width="46" Height="46" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                                                                <Canvas.RenderTransform>
                                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                                </Canvas.RenderTransform>
                                                                <Path x:Name="PauseIconPath"
                                                                      Width="48"
                                                                      Height="45.812"
                                                                      Fill="{x:Static svc:UiPalette.PrimaryBrush}"
                                                                      Stretch="Fill"
                                                                      Data="{StaticResource PauseButtonSvgIcon}"
                                                                      Canvas.Left="0"
                                                                      Canvas.Top="1"/>
                                                            </Canvas>
                                                            <Canvas x:Name="PlayIcon" Width="46" Height="46" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                                                <Canvas.RenderTransform>
                                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                                </Canvas.RenderTransform>
                                                                <Path x:Name="PlayIconPath"
                                                                      Width="48"
                                                                      Height="45.975"
                                                                      Fill="{x:Static svc:UiPalette.PrimaryBrush}"
                                                                      Stretch="Fill"
                                                                      Data="{StaticResource PlayButtonSvgIcon}"
                                                                      Canvas.Left="0"
                                                                      Canvas.Top="1"/>
                                                            </Canvas>
                                                        </Grid>
                                                    </Viewbox>
                                                </ctrl:ActionBorder>

                                                <ctrl:ActionBorder x:Name="NextButton" AutomationProperties.Name="Next Track"
                                                        Grid.Column="2"
                                                        Background="Transparent"
                                                        CornerRadius="8"
                                                        Cursor="Hand"
                                                        Click="NextButton_Click"
                                                        MouseEnter="MediaButton_MouseEnter"
                                                        MouseLeave="MediaButton_MouseLeave"
                                                        Width="32" Height="26"
                                                        Margin="0"
                                                        HorizontalAlignment="Right"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                <Viewbox Width="16" Height="16" Margin="0,0,0,0" Stretch="Uniform">
                                                    <Canvas Width="512" Height="512" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                                                        <Path x:Name="NextArrow0" Fill="{x:Static svc:UiPalette.PrimaryBrush}" StrokeThickness="0" Data="M481.29,229.47l-188.87-113a30.54,30.54,0,0,0-31.09-.39,33.74,33.74,0,0,0-16.76,29.47V224.6L63.85,116.44a30.54,30.54,0,0,0-31.09-.39A33.74,33.74,0,0,0,16,145.52v221A33.74,33.74,0,0,0,32.76,396a30.54,30.54,0,0,0,31.09-.39L244.57,287.4v79.08A33.74,33.74,0,0,0,261.33,396a30.54,30.54,0,0,0,31.09-.39l188.87-113a31.27,31.27,0,0,0,0-53Z" Opacity="0">
                                                            <Path.RenderTransform>
                                                                <TranslateTransform X="0" Y="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                        <Path x:Name="NextArrow1" Fill="{x:Static svc:UiPalette.PrimaryBrush}" StrokeThickness="0" Data="M481.29,229.47l-188.87-113a30.54,30.54,0,0,0-31.09-.39,33.74,33.74,0,0,0-16.76,29.47V224.6L63.85,116.44a30.54,30.54,0,0,0-31.09-.39A33.74,33.74,0,0,0,16,145.52v221A33.74,33.74,0,0,0,32.76,396a30.54,30.54,0,0,0,31.09-.39L244.57,287.4v79.08A33.74,33.74,0,0,0,261.33,396a30.54,30.54,0,0,0,31.09-.39l188.87-113a31.27,31.27,0,0,0,0-53Z">
                                                            <Path.RenderTransform>
                                                                <TranslateTransform X="0" Y="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                        <Path x:Name="NextArrow2" Fill="{x:Static svc:UiPalette.PrimaryBrush}" StrokeThickness="0" Data="M481.29,229.47l-188.87-113a30.54,30.54,0,0,0-31.09-.39,33.74,33.74,0,0,0-16.76,29.47V224.6L63.85,116.44a30.54,30.54,0,0,0-31.09-.39A33.74,33.74,0,0,0,16,145.52v221A33.74,33.74,0,0,0,32.76,396a30.54,30.54,0,0,0,31.09-.39L244.57,287.4v79.08A33.74,33.74,0,0,0,261.33,396a30.54,30.54,0,0,0,31.09-.39l188.87-113a31.27,31.27,0,0,0,0-53Z" Opacity="0">
                                                            <Path.RenderTransform>
                                                                <TranslateTransform X="0" Y="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Canvas>
                                                    </Viewbox>
                                                </ctrl:ActionBorder>
                                        </Grid>

                                        <Grid x:Name="ProgressSection" Grid.Row="1" Margin="0,8,0,0" Visibility="Visible">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid x:Name="ProgressBarContainer"
                                                  Grid.Row="0"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="3"
                                                  Height="24"
                                                  Background="Transparent"
                                                  Cursor="Hand"
                                                  MouseEnter="ProgressBar_MouseEnter"
                                                  MouseLeftButtonDown="ProgressBar_MouseDown"
                                                  MouseMove="ProgressBar_MouseMove"
                                                  MouseLeftButtonUp="ProgressBar_MouseUp"
                                                  MouseLeave="ProgressBar_MouseLeave"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform x:Name="ProgressBarMainScale" ScaleY="1"/>
                                                </Grid.RenderTransform>

                                                <Border x:Name="ProgressBarBg" Background="#262626" Height="4" CornerRadius="2" VerticalAlignment="Center" SizeChanged="ProgressBarBg_SizeChanged">
                                                    <Grid>
                                                        <Grid.Clip>
                                                            <RectangleGeometry x:Name="ProgressBarClip" RadiusX="2" RadiusY="2"/>
                                                        </Grid.Clip>
                                                        <Border x:Name="ProgressBar"
                                                                Height="4"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center"
                                                                RenderTransformOrigin="0,0.5">
                                                            <Border.Background>
                                                                <LinearGradientBrush x:Name="ProgressBarGradient" StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop x:Name="ProgressBarGradientStart" Color="White" Offset="0"/>
                                                                    <GradientStop x:Name="ProgressBarGradientEnd" Color="{x:Static svc:UiPalette.SecondaryColor}" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Border.RenderTransform>
                                                                <ScaleTransform x:Name="ProgressBarScale" ScaleX="0"/>
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <Border x:Name="IndeterminateProgress"
                                                        Background="White"
                                                        Height="4"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center"
                                                        Opacity="0"
                                                        Visibility="Collapsed"/>
                                            </Grid>

                                            <TextBlock x:Name="RemainingTimeText"
                                                       Grid.Row="1"
                                                       Grid.Column="2"
                                                       Margin="6,2,0,0"
                                                       Text="0:00"
                                                       Style="{StaticResource ProgressTimeText}"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock x:Name="CurrentTimeText"
                                                       Grid.Row="1"
                                                       Grid.Column="0"
                                                       Margin="0,2,6,0"
                                                       Text="0:00"
                                                       Style="{StaticResource ProgressTimeText}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
</UserControl>
