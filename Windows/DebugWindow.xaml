<Window x:Class="VNotch.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V-Notch Inspector"
        Width="Auto"
        Height="Auto"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        TextElement.FontFamily="Segoe UI, -apple-system, sans-serif"
        TextElement.FontSize="11.5">

    <Window.Resources>
        <!-- ImGui/Inspector Style ComboBoxItem -->
        <Style x:Key="ImGuiComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E0E6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Margin="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#33333E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E88E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ImGui/Inspector Style ComboBox -->
        <Style x:Key="ImGuiComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#2B2B32"/>
            <Setter Property="Foreground" Value="#E0E0E6"/>
            <Setter Property="BorderBrush" Value="#3E3E4C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ImGuiComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="#2B2B32"
                                                BorderBrush="#3E3E4C"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="7,0,6,0"
                                                Cursor="Hand">
                                            <Grid>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  TextElement.Foreground="#FFFFFF"
                                                                  TextElement.FontSize="11"/>
                                                <Path Data="M 0 0 L 3.5 4 L 7 0 Z"
                                                      Fill="#A0A0AA"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#1E88E5"/>
                                                <Setter TargetName="ComboBorder" Property="Background" Value="#33333C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border x:Name="DropdownBorder"
                                        Background="#1E1E24"
                                        BorderBrush="#3E3E4C"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="0,2,0,0"
                                        Padding="2"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.8" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="220"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False"
                                                  PanningMode="VerticalOnly">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ImGui/Inspector Style CheckBox -->
        <Style x:Key="ImGuiCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D0D0D8"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2.5,0,2.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="CheckBorder" Width="14" Height="14" CornerRadius="2"
                                    Background="#2B2B32" BorderBrush="#424250" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path x:Name="CheckGlyph" Data="M 2,6 L 5,9 L 10,3"
                                      Stroke="#1E88E5" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#1C2836"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#1E88E5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#1E88E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ImGui/Inspector Flat Dark Button -->
        <Style x:Key="ImGuiButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#D8D8E0"/>
            <Setter Property="Background" Value="#2B2B32"/>
            <Setter Property="BorderBrush" Value="#3E3E4C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="8,2.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#383842"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#1E88E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1E88E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ImGui/Inspector ScrollBar Styles -->
        <Style x:Key="InspectorScrollBarThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Width="5"
                                HorizontalAlignment="Center"
                                CornerRadius="2.5"
                                Background="#3E3E4C"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#66667A"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#1E88E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InspectorScrollPageButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InspectorScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Margin" Value="0,1,1,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InspectorScrollPageButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource InspectorScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource InspectorScrollPageButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <!-- Left: Performance Inspector Panel -->
            <ColumnDefinition Width="Auto"/>
            <!-- Right: Service Runtime Logs Panel -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ==================================================== -->
        <!-- COLUMN 0: MAIN PERFORMANCE INSPECTOR PANEL          -->
        <!-- ==================================================== -->
        <Border Grid.Column="0" Width="350" CornerRadius="6"
                Background="#F51E1E22"
                BorderBrush="#33333C"
                BorderThickness="1"
                Padding="9,8,9,9"
                Cursor="SizeAll">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Opacity="0.75" ShadowDepth="4" Direction="270" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <!-- 1. Window Title Bar & Health Alert Banner -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 0 0 L 4 5 L 8 0 Z" Fill="#E0E0E6" VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock Text="V-Notch Performance Inspector" Foreground="#E0E0E6" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Close 'X' Button -->
                    <Button Grid.Column="1" x:Name="CloseButton"
                            Click="CloseButton_Click"
                            Width="16" Height="16"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="3">
                                    <Path Data="M 3,3 L 11,11 M 11,3 L 3,11"
                                          Stroke="#8A8A94" StrokeThickness="1.2"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#44FF453A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Health / Performance Alert Status Banner -->
                <Border x:Name="HealthBanner" Background="#1B3320" BorderBrush="#2E7D32" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,2,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="HealthBadgeBorder" Background="#2E7D32" CornerRadius="2" Padding="4,1" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock x:Name="HealthBadgeText" Text="NOMINAL" Foreground="#FFFFFF" FontSize="9.5" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="HealthSummaryText" Grid.Column="1" Text="Performance Nominal" Foreground="#E0E0E6" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- Top Controls: State View & Notch Control -->
                <Grid Margin="0,2,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ViewStateComboBox"
                              Style="{StaticResource ImGuiComboBoxStyle}"
                              SelectionChanged="ViewStateComboBox_SelectionChanged">
                        <ComboBoxItem Content="Current" Tag="Current" IsSelected="True"/>
                        <ComboBoxItem Content="Media Player" Tag="MediaExpanded"/>
                        <ComboBoxItem Content="File Shelf" Tag="SecondaryShelf"/>
                        <ComboBoxItem Content="Timer &amp; Clock" Tag="TimerStopwatch"/>
                        <ComboBoxItem Content="Audio Router" Tag="AudioRouting"/>
                        <ComboBoxItem Content="Compact Pill" Tag="CompactMusicPill"/>
                        <ComboBoxItem Content="Collapsed" Tag="CollapsedNotch"/>
                    </ComboBox>
                    <TextBlock Grid.Column="1" Text="View State" Foreground="#D0D0D8" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <Grid Margin="0,1,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="DragNotchCheckBox"
                                  Style="{StaticResource ImGuiCheckBoxStyle}"
                                  Content="Move with mouse" Margin="0,0,12,0"
                                  Checked="DragNotchCheckBox_Checked" Unchecked="DragNotchCheckBox_Unchecked"/>
                        <CheckBox x:Name="LockStateCheckBox"
                                  Style="{StaticResource ImGuiCheckBoxStyle}"
                                  Content="Lock view"
                                  Checked="LockStateCheckBox_Checked" Unchecked="LockStateCheckBox_Unchecked"/>
                    </StackPanel>
                    <Button x:Name="ResetPositionBtn" Grid.Column="1"
                            Click="ResetPositionBtn_Click"
                            Style="{StaticResource ImGuiButtonStyle}"
                            Content="Reset pos"/>
                </Grid>

                <!-- ========================================== -->
                <!-- 2. SECTION: V-NOTCH USAGE (PROCESS PROFILE) -->
                <!-- ========================================== -->
                <Border Background="#1C2B3A" CornerRadius="3" Height="20" Padding="6,0" Margin="0,5,0,2"
                        Cursor="Hand" MouseLeftButtonDown="ToggleProcessUsage_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="ProcessUsageArrow" Data="M 0 0 L 4 5 L 8 0 Z" Fill="#64D2FF" VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock Text="V-NOTCH USAGE (PROCESS)" Foreground="#64D2FF" FontSize="10.5" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Collapsible Container for V-Notch Usage -->
                <StackPanel x:Name="ProcessUsageContent">
                    <!-- V-Notch CPU -->
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="20" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="VNotchCpuBar" HorizontalAlignment="Stretch" Background="#1E88E5" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="VNotchCpuScale" ScaleX="0" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock x:Name="VNotchCpuText" Text="0.0%" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="VNotchCpuThreadsText" Grid.Column="1" Text="CPU (0 th / 0 hd)" Foreground="#D0D0D8" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- V-Notch Working Set RAM -->
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="20" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="VNotchRamBar" HorizontalAlignment="Stretch" Background="#1E88E5" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="VNotchRamScale" ScaleX="0" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock x:Name="VNotchRamText" Text="0 MB" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="VNotchPrivateRamText" Grid.Column="1" Text="RAM (0 MB Priv)" Foreground="#D0D0D8" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- Managed GC Heap & Alloc Rate -->
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="20" Padding="5,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="GcHeapText" Text="Heap 0 MB" Foreground="#FFFFFF" FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock x:Name="AllocRateText" Text="(0 B/s)" Foreground="#A0A0AA" FontSize="9.5"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="GcGenText" Grid.Column="1" Text="GC (0/0/0)" Foreground="#D0D0D8" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- V-Notch GPU & Render Latency -->
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="20" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="VNotchGpuBar" HorizontalAlignment="Stretch" Background="#1E88E5" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="VNotchGpuScale" ScaleX="0" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock x:Name="VNotchGpuText" Text="0.0%" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="RenderLatencyText" Grid.Column="1" Text="GPU 3D (0ms / 0ms UI)" Foreground="#D0D0D8" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>

                <!-- ========================================== -->
                <!-- 3. SECTION: GLOBAL SYSTEM USAGE            -->
                <!-- ========================================== -->
                <Border Background="#2D2214" CornerRadius="3" Height="20" Padding="6,0" Margin="0,6,0,2"
                        Cursor="Hand" MouseLeftButtonDown="ToggleGlobalUsage_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="GlobalUsageArrow" Data="M 0 0 L 4 5 L 8 0 Z" Fill="#FF9F0A" VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock Text="GLOBAL SYSTEM USAGE" Foreground="#FF9F0A" FontSize="10.5" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Collapsible Container for Global System Usage -->
                <StackPanel x:Name="GlobalUsageContent">
                    <!-- Global CPU -->
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="20" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="GlobalCpuBar" HorizontalAlignment="Stretch" Background="#FF9F0A" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="GlobalCpuScale" ScaleX="0" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock x:Name="GlobalCpuText" Text="0%" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Global CPU" Foreground="#D0D0D8" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Global RAM -->
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="20" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="GlobalRamBar" HorizontalAlignment="Stretch" Background="#FF9F0A" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="GlobalRamScale" ScaleX="0" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock x:Name="GlobalRamText" Text="0 GB (0%)" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="GlobalRamAvailText" Grid.Column="1" Text="RAM (0 GB free)" Foreground="#D0D0D8" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- Global GPU & VRAM -->
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="20" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="GlobalGpuBar" HorizontalAlignment="Stretch" Background="#FF9F0A" CornerRadius="2" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="GlobalGpuScale" ScaleX="0" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                                <TextBlock x:Name="GlobalGpuText" Text="0%" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="GpuNameText" Grid.Column="1" Text="GPU Hardware" Foreground="#D0D0D8" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>

                    <!-- Global Network I/O -->
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="20" Padding="4,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="↓" Foreground="#64D2FF" FontSize="10.5" FontWeight="Bold" Margin="0,0,2,0"/>
                                <TextBlock x:Name="NetDownText" Text="0 B/s" Foreground="#FFFFFF" FontSize="9.5" Margin="0,0,6,0"/>
                                <TextBlock Text="↑" Foreground="#FF9F0A" FontSize="10.5" FontWeight="Bold" Margin="0,0,2,0"/>
                                <TextBlock x:Name="NetUpText" Text="0 B/s" Foreground="#FFFFFF" FontSize="9.5"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Network I/O" Foreground="#D0D0D8" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- ========================================== -->
                <!-- 4. SECTION: BOTTLENECKS & HEALTH LOG       -->
                <!-- ========================================== -->
                <Border Background="#222228" CornerRadius="3" Height="20" Padding="6,0" Margin="0,6,0,2"
                        Cursor="Hand" MouseLeftButtonDown="ToggleBottlenecks_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="BottlenecksArrow" Data="M 0 0 L 4 5 L 8 0 Z" Fill="#A0A0AA" VerticalAlignment="Center" Margin="0,1,6,0"/>
                            <TextBlock Text="BOTTLENECK &amp; HEALTH ALERTS" Foreground="#D8D8E0" FontSize="10" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CopyAllLogsBtn" Click="CopyAllLogsBtn_Click"
                                    Style="{StaticResource ImGuiButtonStyle}" Content="Copy" Padding="5,1" FontSize="9.5" Margin="0,0,4,0"/>
                            <Button x:Name="ClearLogsBtn" Click="ClearLogsBtn_Click"
                                    Style="{StaticResource ImGuiButtonStyle}" Content="Clear" Padding="5,1" FontSize="9.5"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Collapsible Container for Bottlenecks & Health Alerts Log -->
                <StackPanel x:Name="BottlenecksContent">
                    <Border Background="#18181C" BorderBrush="#303038" BorderThickness="1" CornerRadius="3" Height="130" Margin="0,2,0,4" Padding="2,2">
                        <ListBox x:Name="DiagnosticLogsListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 SelectionMode="Single">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource InspectorScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#141419" BorderBrush="#24242D" BorderThickness="1" CornerRadius="3" Padding="5,3" Margin="1,1,1,2.5">
                                        <StackPanel>
                                            <!-- Row 1: Timestamp & Category Badge -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBox Text="{Binding FormattedTime, Mode=OneWay}"
                                                         IsReadOnly="True"
                                                         IsReadOnlyCaretVisible="False"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="#82828C"
                                                         FontSize="9.5"
                                                         FontFamily="Consolas, Segoe UI, monospace"
                                                         Padding="0"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Cursor="IBeam"
                                                         SelectionBrush="#1E88E5"/>
                                                <Border Background="{Binding SeverityBackground}" CornerRadius="2" Padding="4,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" Foreground="{Binding SeverityForeground}" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Row 2: Full Log Message (100% Width) -->
                                            <TextBox Text="{Binding Message, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     IsReadOnlyCaretVisible="False"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Foreground="#E2E2E8"
                                                     FontSize="10"
                                                     FontFamily="Consolas, Segoe UI, monospace"
                                                     TextWrapping="Wrap"
                                                     Padding="0"
                                                     VerticalAlignment="Top"
                                                     Cursor="IBeam"
                                                     SelectionBrush="#1E88E5"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>

                <!-- Footer: FPS & Hz Summary + Toggle Service Logs Button -->
                <Border Height="1" Background="#33333C" Margin="0,4,0,4"/>

                <Grid Margin="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FpsSummaryText" Text="-- FPS" Foreground="#E0E0E6" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HzSummaryText" Text=" (-- Hz)" Foreground="#8A8A94" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <TextBlock x:Name="FrameTimeSummaryText" Text=" • 0.0ms" Foreground="#64D2FF" FontSize="10.5" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="ToggleServiceLogsBtn"
                            Click="ToggleServiceLogsBtn_Click"
                            Style="{StaticResource ImGuiButtonStyle}"
                            Content="Service Logs ▶"
                            Padding="6,2" FontSize="10"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================================================== -->
        <!-- COLUMN 1: DEDICATED SERVICE RUNTIME LOGS SIDE PANEL -->
        <!-- ==================================================== -->
        <Border Grid.Column="1" x:Name="ServiceLogsPanel" Width="460" CornerRadius="6"
                Background="#F51E1E22"
                BorderBrush="#33333C"
                BorderThickness="1"
                Padding="9,8,9,9"
                Margin="8,0,0,0"
                Visibility="Visible">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Opacity="0.75" ShadowDepth="4" Direction="270" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 0 0 L 4 5 L 8 0 Z" Fill="#64D2FF" VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock Text="SERVICE RUNTIME LOGS" Foreground="#64D2FF" FontSize="11.5" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Close Side Panel Button -->
                    <Button Grid.Column="1" Click="CloseServiceLogsBtn_Click"
                            Width="16" Height="16"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="3">
                                    <Path Data="M 3,3 L 11,11 M 11,3 L 3,11"
                                          Stroke="#8A8A94" StrokeThickness="1.2"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#44FF453A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Filter Bar and Action Buttons -->
                <Grid Grid.Row="1" Margin="0,2,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="ServiceCategoryFilterComboBox"
                              Style="{StaticResource ImGuiComboBoxStyle}"
                              SelectionChanged="ServiceCategoryFilterComboBox_SelectionChanged">
                        <ComboBoxItem Content="All Categories" IsSelected="True"/>
                        <ComboBoxItem Content="Media (Playback &amp; Track)"/>
                        <ComboBoxItem Content="Audio Mixer"/>
                        <ComboBoxItem Content="Battery &amp; Power"/>
                        <ComboBoxItem Content="Bluetooth"/>
                        <ComboBoxItem Content="Spotify"/>
                        <ComboBoxItem Content="Weather"/>
                        <ComboBoxItem Content="Spotlight Search"/>
                        <ComboBoxItem Content="Subtitles &amp; Lyrics"/>
                        <ComboBoxItem Content="Liquid Glass"/>
                        <ComboBoxItem Content="Memory &amp; GC"/>
                    </ComboBox>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                        <Button x:Name="CopyServiceLogsBtn" Click="CopyServiceLogsBtn_Click"
                                Style="{StaticResource ImGuiButtonStyle}" Content="Copy All" Padding="6,2" FontSize="9.5" Margin="0,0,4,0"/>
                        <Button x:Name="ClearServiceLogsBtn" Click="ClearServiceLogsBtn_Click"
                                Style="{StaticResource ImGuiButtonStyle}" Content="Clear" Padding="6,2" FontSize="9.5"/>
                    </StackPanel>
                </Grid>

                <!-- Service Logs ListBox (Virtualized) -->
                <Border Grid.Row="2" Background="#18181C" BorderBrush="#303038" BorderThickness="1" CornerRadius="3"
                        Height="400" Padding="2,2">
                    <ListBox x:Name="ServiceLogsListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             SelectionMode="Single">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource InspectorScrollBar}"/>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141419" BorderBrush="#24242D" BorderThickness="1" CornerRadius="3" Padding="6,3.5" Margin="1,1,1,2.5">
                                    <StackPanel>
                                        <!-- Row 1: Timestamp & Category Tag -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBox Text="{Binding FormattedTime, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     IsReadOnlyCaretVisible="False"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Foreground="#82828C"
                                                     FontSize="9.5"
                                                     FontFamily="Consolas, Segoe UI, monospace"
                                                     Padding="0"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Cursor="IBeam"
                                                     SelectionBrush="#1E88E5"/>
                                            <Border Background="{Binding SeverityBackground}" CornerRadius="2" Padding="4,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" Foreground="{Binding SeverityForeground}" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Row 2: Full Log Message (100% Width) -->
                                        <TextBox Text="{Binding Message, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 IsReadOnlyCaretVisible="False"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="#ECECEE"
                                                 FontSize="10.5"
                                                 FontFamily="Consolas, Segoe UI, monospace"
                                                 TextWrapping="Wrap"
                                                 Padding="0"
                                                 VerticalAlignment="Top"
                                                 Cursor="IBeam"
                                                 SelectionBrush="#1E88E5"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Footer Summary of Service Logs -->
                <TextBlock Grid.Row="3" x:Name="ServiceLogCountText" Text="0 service log events" Foreground="#7E7E88" FontSize="9.5" Margin="2,4,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
