<Window x:Class="VNotch.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V-Notch Inspector"
        Width="310"
        Height="Auto"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        TextElement.FontFamily="Segoe UI, -apple-system, sans-serif"
        TextElement.FontSize="11.5">

    <Window.Resources>
        <!-- ImGui/Inspector Style ComboBoxItem -->
        <Style x:Key="ImGuiComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E0E6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Margin="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#33333E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E88E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ImGui/Inspector Style ComboBox -->
        <Style x:Key="ImGuiComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="#2B2B32"/>
            <Setter Property="Foreground" Value="#E0E0E6"/>
            <Setter Property="BorderBrush" Value="#3E3E4C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ImGuiComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="#2B2B32"
                                                BorderBrush="#3E3E4C"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Padding="7,0,6,0"
                                                Cursor="Hand">
                                            <Grid>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  TextElement.Foreground="#FFFFFF"
                                                                  TextElement.FontSize="11"/>
                                                <Path Data="M 0 0 L 3.5 4 L 7 0 Z"
                                                      Fill="#A0A0AA"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#1E88E5"/>
                                                <Setter TargetName="ComboBorder" Property="Background" Value="#33333C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border x:Name="DropdownBorder"
                                        Background="#1E1E24"
                                        BorderBrush="#3E3E4C"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="0,2,0,0"
                                        Padding="2"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.8" Color="#000000"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="220"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False"
                                                  PanningMode="VerticalOnly">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ImGui/Inspector Style CheckBox -->
        <Style x:Key="ImGuiCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D0D0D8"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2.5,0,2.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="CheckBorder" Width="14" Height="14" CornerRadius="2"
                                    Background="#2B2B32" BorderBrush="#424250" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <Path x:Name="CheckGlyph" Data="M 2,6 L 5,9 L 10,3"
                                      Stroke="#1E88E5" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#1C2836"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#1E88E5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#1E88E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ImGui/Inspector Flat Dark Button -->
        <Style x:Key="ImGuiButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#D8D8E0"/>
            <Setter Property="Background" Value="#2B2B32"/>
            <Setter Property="BorderBrush" Value="#3E3E4C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#383842"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#1E88E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#1E88E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <!-- Main Inspector Window Panel with ImGui Dark Charcoal Styling -->
        <Border CornerRadius="6"
                Background="#F51E1E22"
                BorderBrush="#33333C"
                BorderThickness="1"
                Padding="8,7,8,8"
                Cursor="SizeAll">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Opacity="0.75" ShadowDepth="4" Direction="270" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <!-- 1. Window Title Bar -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 0 0 L 4 5 L 8 0 Z" Fill="#E0E0E6" VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock Text="Settings &amp; Debug" Foreground="#E0E0E6" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Close 'X' Button -->
                    <Button Grid.Column="1" x:Name="CloseButton"
                            Click="CloseButton_Click"
                            Width="16" Height="16"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Background="Transparent" CornerRadius="3">
                                    <Path Data="M 3,3 L 11,11 M 11,3 L 3,11"
                                          Stroke="#8A8A94" StrokeThickness="1.2"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#44FF453A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Top Controls: State View & Move with mouse -->
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ViewStateComboBox"
                              Style="{StaticResource ImGuiComboBoxStyle}"
                              SelectionChanged="ViewStateComboBox_SelectionChanged">
                        <ComboBoxItem Content="Current" Tag="Current" IsSelected="True"/>
                        <ComboBoxItem Content="Media Player" Tag="MediaExpanded"/>
                        <ComboBoxItem Content="File Shelf" Tag="SecondaryShelf"/>
                        <ComboBoxItem Content="Timer &amp; Clock" Tag="TimerStopwatch"/>
                        <ComboBoxItem Content="Audio Router" Tag="AudioRouting"/>
                        <ComboBoxItem Content="Compact Pill" Tag="CompactMusicPill"/>
                        <ComboBoxItem Content="Collapsed" Tag="CollapsedNotch"/>
                    </ComboBox>
                    <TextBlock Grid.Column="1" Text="View State" Foreground="#D0D0D8" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <CheckBox x:Name="DragNotchCheckBox"
                          Style="{StaticResource ImGuiCheckBoxStyle}"
                          Content="Move with mouse"
                          Checked="DragNotchCheckBox_Checked" Unchecked="DragNotchCheckBox_Unchecked"/>

                <CheckBox x:Name="LockStateCheckBox"
                          Style="{StaticResource ImGuiCheckBoxStyle}"
                          Content="Lock view (Never close)"
                          Checked="LockStateCheckBox_Checked" Unchecked="LockStateCheckBox_Unchecked"/>

                <!-- 2. Section: GPU Hardware -->
                <Border Background="#282830" CornerRadius="3" Height="20" Padding="6,0" Margin="0,6,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 0 0 L 4 5 L 8 0 Z" Fill="#A0A0AA" VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock Text="GPU Hardware" Foreground="#D8D8E0" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="22" Padding="6,0">
                        <TextBlock x:Name="GpuNameText" Text="DirectX Adapter" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <TextBlock x:Name="GpuVramText" Grid.Column="1" Text="-- VRAM" Foreground="#D0D0D8" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- 3. Section: CPU Metrics -->
                <Border Background="#282830" CornerRadius="3" Height="20" Padding="6,0" Margin="0,6,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 0 0 L 4 5 L 8 0 Z" Fill="#A0A0AA" VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock Text="CPU Utilization" Foreground="#D8D8E0" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- V-Notch CPU -->
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="22" ClipToBounds="True">
                        <Grid>
                            <!-- Blue Marker / Bar -->
                            <Border x:Name="VNotchCpuBar" HorizontalAlignment="Left" Background="#1E88E5" Width="0" CornerRadius="2"/>
                            <!-- Centered Value -->
                            <TextBlock x:Name="VNotchCpuText" Text="0.0%" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="V-Notch CPU" Foreground="#D0D0D8" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Global CPU -->
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="22" ClipToBounds="True">
                        <Grid>
                            <!-- Blue Marker / Bar -->
                            <Border x:Name="GlobalCpuBar" HorizontalAlignment="Left" Background="#1E88E5" Width="0" CornerRadius="2"/>
                            <!-- Centered Value -->
                            <TextBlock x:Name="GlobalCpuText" Text="0%" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Global CPU" Foreground="#D0D0D8" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- 4. Section: Memory & GPU 3D -->
                <Border Background="#282830" CornerRadius="3" Height="20" Padding="6,0" Margin="0,6,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 0 0 L 4 5 L 8 0 Z" Fill="#A0A0AA" VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock Text="Memory &amp; GPU 3D" Foreground="#D8D8E0" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- V-Notch RAM -->
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="22" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="VNotchRamBar" HorizontalAlignment="Left" Background="#1E88E5" Width="0" CornerRadius="2"/>
                            <TextBlock x:Name="VNotchRamText" Text="0 MB" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="V-Notch RAM" Foreground="#D0D0D8" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Global RAM -->
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="22" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="GlobalRamBar" HorizontalAlignment="Left" Background="#1E88E5" Width="0" CornerRadius="2"/>
                            <TextBlock x:Name="GlobalRamText" Text="0 GB (0%)" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Global RAM" Foreground="#D0D0D8" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- V-Notch GPU -->
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="22" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="VNotchGpuBar" HorizontalAlignment="Left" Background="#1E88E5" Width="0" CornerRadius="2"/>
                            <TextBlock x:Name="VNotchGpuText" Text="0.0%" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="V-Notch GPU" Foreground="#D0D0D8" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Global GPU -->
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="22" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="GlobalGpuBar" HorizontalAlignment="Left" Background="#1E88E5" Width="0" CornerRadius="2"/>
                            <TextBlock x:Name="GlobalGpuText" Text="0%" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Global GPU" Foreground="#D0D0D8" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- Network -->
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#2B2B32" BorderBrush="#383842" BorderThickness="1" CornerRadius="3" Height="22" Padding="4,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="↓" Foreground="#64D2FF" FontSize="10.5" FontWeight="Bold" Margin="0,0,2,0"/>
                            <TextBlock x:Name="NetDownText" Text="0 B/s" Foreground="#FFFFFF" FontSize="10" Margin="0,0,6,0"/>
                            <TextBlock Text="↑" Foreground="#FF9F0A" FontSize="10.5" FontWeight="Bold" Margin="0,0,2,0"/>
                            <TextBlock x:Name="NetUpText" Text="0 B/s" Foreground="#FFFFFF" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Network I/O" Foreground="#D0D0D8" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <!-- 5. Footer: FPS & Reset Action Button -->
                <Border Height="1" Background="#33333C" Margin="0,8,0,6"/>

                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FpsSummaryText" Text="-- FPS" Foreground="#E0E0E6" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HzSummaryText" Text=" (-- Hz)" Foreground="#8A8A94" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>

                    <Button x:Name="ResetPositionBtn" Grid.Column="1"
                            Click="ResetPositionBtn_Click"
                            Style="{StaticResource ImGuiButtonStyle}"
                            Content="Reset position"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
