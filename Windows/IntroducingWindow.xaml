<Window x:Class="VNotch.IntroducingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get to know V-Notch" Width="430" Height="350"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="pack://application:,,,/V-Notch;component/Fonts/#SF Pro Display, Nirmala UI, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Animated">
    <Window.Resources>
        <FontFamily x:Key="SettingsFont">pack://application:,,,/V-Notch;component/Fonts/#SF Pro Display, Nirmala UI, Segoe UI</FontFamily>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SettingsFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource SettingsFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#D8DEE5"/>
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#18FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.3"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="CoachSurface" RenderTransformOrigin="0.5,0.5" Margin="12" CornerRadius="20" BorderBrush="#4291B8E5" BorderThickness="1" Padding="22">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FD181C23" Offset="0"/>
                <GradientStop Color="#FE090A0D" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#9ECBFF" Margin="0,0,9,0"/>
                    <TextBlock x:Name="StepText" FontSize="12" FontWeight="SemiBold" Foreground="#AFBECE" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CloseButton" Content="×" HorizontalAlignment="Right" Padding="9,3" Click="Close_Click" AutomationProperties.Name="Close tutorial"/>
            </Grid>
            <Border Grid.Row="1" Background="#18FFFFFF" CornerRadius="1" Margin="0,0,0,0" ClipToBounds="True">
                <Border x:Name="ProgressFill" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#73A9F3" Offset="0"/>
                            <GradientStop Color="#C4DFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0"/></Border.RenderTransform>
                </Border>
            </Border>
            <Grid Grid.Row="2" Margin="0,17,0,0" ClipToBounds="True">
                <ScrollViewer x:Name="StepScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="StepContent">
                        <TextBlock x:Name="HeadlineText" FontSize="22" FontWeight="SemiBold" Foreground="#F2F5F9" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BodyText" FontSize="14" FontWeight="Normal" Foreground="#B4BBC5" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                        <TextBlock x:Name="HintText" FontSize="12" FontWeight="Medium" Foreground="#ADCFFF" TextWrapping="Wrap" Margin="0,14,0,4" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </ScrollViewer>
                <!-- Previous page is visually overlaid; it never changes the scroll extent or incoming layout. -->
                <Grid ClipToBounds="True" IsHitTestVisible="False">
                    <StackPanel x:Name="OutgoingContent" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="OutgoingHeadline" FontSize="22" FontWeight="SemiBold" Foreground="#F2F5F9" TextWrapping="Wrap"/>
                        <TextBlock x:Name="OutgoingBody" FontSize="14" FontWeight="Normal" Foreground="#B4BBC5" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                        <TextBlock x:Name="OutgoingHint" FontSize="12" FontWeight="Medium" Foreground="#ADCFFF" TextWrapping="Wrap" Margin="0,14,0,4"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Click="Back_Click" Padding="8,11"/>
                <Button x:Name="NextButton" Grid.Column="2" Background="#F2F2F2" Foreground="#080808" Click="Next_Click" Padding="8,11" IsDefault="True"/>
            </Grid>
        </Grid>
    </Border>
</Window>
