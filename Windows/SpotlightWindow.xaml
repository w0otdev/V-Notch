<Window x:Class="VNotch.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VNotch.Controls"
        Title="V-Notch Spotlight"
        Width="720"
        Height="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        AutomationProperties.Name="V-Notch Spotlight">
    <Window.Resources>
        <controls:SpotlightHotkeyConverter x:Key="HotkeyConverter"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4FFFFFF"/>
        <SolidColorBrush x:Key="TitleTextBrush" Color="#EDFFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8AFFFFFF"/>
        <SolidColorBrush x:Key="TertiaryTextBrush" Color="#5EFFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F2F2F2"/>
        <!-- Fully opaque OLED black to match the notch; any translucency lets
             the window behind bleed through the search field. -->
        <SolidColorBrush x:Key="ShellBrush" Color="#FF000000"/>
        <SolidColorBrush x:Key="ShellBorderBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="SelectedItemBrush" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="HoverItemBrush" Color="#10FFFFFF"/>

        <Style x:Key="KeyBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#1CFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ThinScrollBarThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="4"
                                HorizontalAlignment="Center"
                                CornerRadius="2"
                                Background="#30FFFFFF"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Margin" Value="0,2,3,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpotlightContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource ShellBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="4">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpotlightMenuItemStyle" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root"
                                CornerRadius="6"
                                Padding="12,7"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextElement.FontFamily="{StaticResource SFProText}"
                                              TextElement.FontSize="12"
                                              TextElement.Foreground="{StaticResource PrimaryTextBrush}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedItemBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <EventSetter Event="MouseLeftButtonUp" Handler="ResultItem_MouseLeftButtonUp"/>
            <EventSetter Event="MouseRightButtonUp" Handler="ResultItem_MouseRightButtonUp"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="7,2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="HoverSurface"
                                    Background="{StaticResource HoverItemBrush}"
                                    CornerRadius="8"
                                    Opacity="0"/>
                            <Border Padding="14,8">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The window is a fixed-size transparent canvas; only the shell resizes.
         Animating an HWND resize on a layered window re-uploads the whole
         surface every frame and stutters, so the window never changes size. -->
    <Border x:Name="Shell"
            CornerRadius="14"
            Background="{StaticResource ShellBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="1"
            VerticalAlignment="Top"
            ClipToBounds="False"
            Opacity="0"
            RenderTransformOrigin="0.5,0.12">
        <Border.Effect>
            <DropShadowEffect Color="#020408"
                              BlurRadius="24"
                              ShadowDepth="5"
                              Direction="270"
                              Opacity="0.48"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ShellScale" ScaleX="0.98" ScaleY="0.98"/>
                <TranslateTransform x:Name="ShellShake"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <!-- ClipToBounds keeps rows inside the shell while its explicit
                 morph height is smaller than the content's natural height. -->
            <Grid x:Name="ShellContent"
                  ClipToBounds="True"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ContentTranslate" Y="0"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

            <!-- Search field: text on the left, magnifier on the right (Flow Launcher layout). -->
            <Grid Margin="22,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,16,0">
                    <!-- Inline autocomplete: the typed prefix is rendered transparent so
                         only the dim completion tail shows behind the real caret text. -->
                    <TextBlock x:Name="AutocompleteText"
                               FontFamily="{StaticResource SFProDisplay}"
                               FontSize="20"
                               FontWeight="Normal"
                               Margin="1,2,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"><Run x:Name="AutocompleteTypedRun" Foreground="Transparent"/><Run x:Name="AutocompleteSuffixRun" Foreground="#48FFFFFF"/></TextBlock>
                    <TextBox x:Name="SearchBox"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="SearchBox_TextChanged"
                             FontFamily="{StaticResource SFProDisplay}"
                             FontSize="20"
                             FontWeight="Normal"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             CaretBrush="{StaticResource AccentBrush}"
                             SelectionBrush="#4DFFFFFF"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,2,0,0"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="Search apps and files"/>
                    <TextBlock x:Name="PlaceholderText"
                               Text="Search apps and files"
                               FontFamily="{StaticResource SFProDisplay}"
                               FontSize="20"
                               FontWeight="Normal"
                               Foreground="#44FFFFFF"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border x:Name="EscBadge"
                        Grid.Column="1"
                        Margin="0,0,14,0"
                        Style="{StaticResource KeyBadgeStyle}">
                    <TextBlock Text="ESC"
                               FontFamily="{StaticResource SFProText}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#72FFFFFF"/>
                </Border>

                <TextBlock Grid.Column="2"
                           Text="&#xE721;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="19"
                           Foreground="#7DFFFFFF"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Results appear only after the user starts searching. -->
            <Border x:Name="ContentRegion"
                    Grid.Row="1"
                    BorderBrush="#14FFFFFF"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ContentRegionTranslate" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,6,0,7">
                        <ListBox x:Name="ResultsList"
                                 ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ResultItemStyle}"
                                 SelectionChanged="ResultsList_SelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="440"
                                 AlternationCount="20"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 AutomationProperties.Name="Search results">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <!-- The selection highlight is one shared surface that glides
                                         between rows; it lives inside the scrolled content so it
                                         stays glued to its row while scrolling. -->
                                    <ScrollViewer Focusable="False"
                                                  CanContentScroll="False"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <Grid>
                                            <Border x:Name="SelectionGlide"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="{StaticResource SelectedItemBrush}"
                                                    CornerRadius="8"
                                                    Opacity="0"
                                                    IsHitTestVisible="False">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="SelectionGlideTransform"/>
                                                </Border.RenderTransform>
                                                <!-- Full-height accent bar hugging the row's left edge. -->
                                                <Border Width="3"
                                                        Margin="0,4"
                                                        CornerRadius="1.5"
                                                        Background="{StaticResource AccentBrush}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Stretch"/>
                                            </Border>
                                            <ItemsPresenter/>
                                        </Grid>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="38"
                                          AutomationProperties.Name="{Binding Title}"
                                          AutomationProperties.HelpText="{Binding Subtitle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="32"
                                              Height="32"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}"
                                                   Width="32"
                                                   Height="32"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="FallbackGlyph"
                                                       Text="{Binding Glyph}"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="20"
                                                       Foreground="#B4FFFFFF"
                                                       Visibility="Collapsed"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1"
                                                    Margin="4,0,16,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock controls:HighlightedText.Text="{Binding Title}"
                                                       controls:HighlightedText.Query="{Binding DataContext.Query, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontFamily="{StaticResource SFProDisplay}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TitleTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SubtitleText"
                                                       Text="{Binding Subtitle}"
                                                       Margin="0,2,0,0"
                                                       FontFamily="{StaticResource SFProText}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource TertiaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border x:Name="HotkeyBadge"
                                                Grid.Column="2"
                                                Style="{StaticResource KeyBadgeStyle}">
                                            <TextBlock x:Name="HotkeyText"
                                                       Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource HotkeyConverter}}"
                                                       FontFamily="{StaticResource SFProText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#86FFFFFF"/>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                            <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Subtitle}" Value="">
                                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=HotkeyText}" Value="">
                                            <Setter TargetName="HotkeyBadge" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid x:Name="StatusPanel"
                              MinHeight="112"
                              Margin="24,4,24,14"
                              Visibility="Collapsed"
                              AutomationProperties.LiveSetting="Polite">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusGlyph"
                                           Text="&#xE721;"
                                           Margin="0,0,0,10"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="24"
                                           Foreground="#66FFFFFF"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="StatusTitle"
                                           FontFamily="{StaticResource SFProDisplay}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#D8FFFFFF"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="StatusHint"
                                           MaxWidth="520"
                                           Margin="0,4,0,0"
                                           FontFamily="{StaticResource SFProText}"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Only surfaces when a launch fails; there is no permanent footer. -->
                    <Border x:Name="FailureBar"
                            Grid.Row="1"
                            BorderBrush="#12FFFFFF"
                            BorderThickness="0,1,0,0"
                            Padding="22,9"
                            Visibility="Collapsed">
                        <TextBlock x:Name="FailureText"
                                   FontFamily="{StaticResource SFProText}"
                                   FontSize="11"
                                   Foreground="#E8FFA894"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Assertive"/>
                    </Border>
                </Grid>
                </Border>
            </Grid>

            <!-- Snapshot of the source notch used only during the opening
                 handoff, above the Spotlight content that fades in below. -->
            <Image x:Name="NotchMorphSnapshot"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Stretch="Fill"
                   IsHitTestVisible="False"
                   Opacity="0"/>
        </Grid>
    </Border>
</Window>
