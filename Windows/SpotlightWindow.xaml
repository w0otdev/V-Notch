<Window x:Class="VNotch.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:controls="clr-namespace:VNotch.Controls"
        xmlns:local="clr-namespace:VNotch"
        Title="V-Notch Spotlight"
        Width="968"
        Height="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Opacity="0"
        FontFamily="{DynamicResource SFProDisplay}"
        FontWeight="Bold"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        AutomationProperties.Name="V-Notch Spotlight">
    <Window.Resources>
        <FontFamily x:Key="SFProDisplay">pack://application:,,,/V-Notch;component/Fonts/#SF Pro Display, Segoe UI, Arial</FontFamily>
        <FontFamily x:Key="SFProText">pack://application:,,,/V-Notch;component/Fonts/#SF Pro Display, Segoe UI, Arial</FontFamily>
        <controls:SpotlightHotkeyConverter x:Key="HotkeyConverter"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4FFFFFF"/>
        <SolidColorBrush x:Key="TitleTextBrush" Color="#EDFFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8AFFFFFF"/>
        <SolidColorBrush x:Key="TertiaryTextBrush" Color="#5EFFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F2F2F2"/>
        <!-- Fully opaque OLED black to match the notch; any translucency lets
             the window behind bleed through the search field. -->
        <SolidColorBrush x:Key="ShellBrush" Color="#FF000000"/>
        <SolidColorBrush x:Key="ShellBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="SelectedItemBrush" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="HoverItemBrush" Color="#10FFFFFF"/>

        <Style x:Key="AiActionStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource SFProDisplay}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiToolbarStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="5" Background="Transparent" BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.6"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiSuggestionStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource SFProDisplay}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8C959E"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#C8C8C8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiStopButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RevealSurface" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                            <Ellipse x:Name="BreathingGlow" Width="48" Height="48" Opacity="0.22"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFEF4B53" Offset="0"/>
                                        <GradientStop Color="#80EF4B53" Offset="0.65"/>
                                        <GradientStop Color="#00EF4B53" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Grid x:Name="ButtonContent" Width="36" Height="36"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                                <Border x:Name="Bg" CornerRadius="18" Background="#EF4B53"
                                        BorderThickness="1" BorderBrush="#55FFFFFF"/>
                                <Border x:Name="HoverOverlay" CornerRadius="18" Background="#20FFFFFF"
                                        Opacity="0" IsHitTestVisible="False"/>
                                <Border x:Name="PressedOverlay" CornerRadius="18" Background="#28000000"
                                        Opacity="0" IsHitTestVisible="False"/>
                                <Rectangle Width="12" Height="12" RadiusX="2.5" RadiusY="2.5" Fill="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#222228"/>
            <Setter Property="BorderBrush" Value="#3C3C46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,3.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ThinScrollBarThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="4"
                                HorizontalAlignment="Center"
                                CornerRadius="2"
                                Background="#30FFFFFF"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Margin" Value="0,2,3,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpotlightContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource ShellBrush}"
                                BorderBrush="{StaticResource ShellBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="4">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpotlightMenuItemStyle" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root"
                                CornerRadius="6"
                                Padding="12,7"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextElement.FontFamily="{StaticResource SFProDisplay}"
                                              TextElement.FontSize="12"
                                              TextElement.FontWeight="Bold"
                                              TextElement.Foreground="{StaticResource PrimaryTextBrush}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedItemBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <EventSetter Event="MouseLeftButtonUp" Handler="ResultItem_MouseLeftButtonUp"/>
            <EventSetter Event="MouseRightButtonUp" Handler="ResultItem_MouseRightButtonUp"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="7,2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="HoverSurface"
                                    Background="{StaticResource HoverItemBrush}"
                                    CornerRadius="8"
                                    Opacity="0"/>
                            <Border Padding="14,8">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fit the 920-DIP file tray plus shadow space in both morph directions.
         Keep the HWND fixed while the shell resizes to avoid surface uploads. -->
    <AdornerDecorator>
    <Grid>
        <!-- Match NotchShadowWrapper: a solid silhouette behind the shell,
             with the shadow on its wrapper and no exclusion clip. -->
        <Grid x:Name="ShellShadowHost"
                Width="{Binding ActualWidth, ElementName=Shell}"
                Height="{Binding ActualHeight, ElementName=Shell}"
                Margin="0,16,0,0"
                Opacity="{Binding Opacity, ElementName=Shell}"
                Visibility="{Binding Visibility, ElementName=Shell}"
                RenderTransform="{Binding RenderTransform, ElementName=Shell}"
                RenderTransformOrigin="{Binding RenderTransformOrigin, ElementName=Shell}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
            <Grid.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="20"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Opacity="0.6"
                                  RenderingBias="Performance"/>
            </Grid.Effect>
            <Border Background="Black"
                    CornerRadius="{Binding CornerRadius, ElementName=Shell}"/>
        </Grid>
    <Border x:Name="Shell"
            Margin="124,16,124,0"
            CornerRadius="14"
            Background="{StaticResource ShellBrush}"
            BorderBrush="Transparent"
            BorderThickness="0"
            VerticalAlignment="Top"
            ClipToBounds="False"
            Opacity="0"
            RenderTransformOrigin="0.5,0.12">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ShellScale" ScaleX="0.98" ScaleY="0.98"/>
                <TranslateTransform x:Name="ShellShake"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <!-- Concave side ear curves for notch transition in standard notch mode -->
            <Path x:Name="ShellLeftEar"
                  Data="M 0,0 L 11,0 L 11,10 C 11,4.4 6.2,0 0,0 Z"
                  Fill="{StaticResource ShellBrush}"
                  Width="11" Height="10"
                  Margin="-10,0,0,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False"
                  Opacity="0"/>
            <Path x:Name="ShellRightEar"
                  Data="M 11,0 L 0,0 L 0,10 C 0,4.4 4.8,0 11,0 Z"
                  Fill="{StaticResource ShellBrush}"
                  Width="11" Height="10"
                  Margin="0,0,-10,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False"
                  Opacity="0"/>

            <!-- Final rounded clip for material stack; kept outside blurred children
                 so post-effects cannot spread blur into transparent canvas corners. -->
            <!-- Material bounds follow shell bounds during morphs; desktop texture
                 contributes no desired size so content min-size is not inherited. -->
            <Canvas IsHitTestVisible="False">
            <Grid x:Name="GlassMaterialClipHost"
                  Width="{Binding ActualWidth, ElementName=Shell}"
                  Height="{Binding ActualHeight, ElementName=Shell}"
                  IsHitTestVisible="False"
                  LayoutUpdated="GlassMaterialClipHost_LayoutUpdated"
                  SizeChanged="GlassMaterialClipHost_SizeChanged">
                <Border x:Name="GlassBackdropHost"
                        IsHitTestVisible="False"
                        ClipToBounds="True"
                        Visibility="Collapsed"
                        CornerRadius="14">
                    <Canvas>
                    <Image x:Name="GlassBackdropImage"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Stretch="Fill"
                           Margin="0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Canvas>
                </Border>

                <Border x:Name="GlassGrainOverlay"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Opacity="0"
                        CornerRadius="14"/>

                <Border x:Name="GlassTintOverlay"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        CornerRadius="14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
                            <GradientStop Color="#0CFFFFFF" Offset="0"/>
                            <GradientStop Color="#06FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#160A0E14" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Border x:Name="GlassDarkOverlay"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Opacity="0"
                        CornerRadius="14"
                        Background="Black"/>

                <!-- Optical rim stack: depth, spectral split, Fresnel,
                     broken edge reflection and a focused specular glint. -->
                <Border x:Name="GlassDepthRimBorder"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Opacity="0"
                        BorderThickness="1.2"
                        CornerRadius="14">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#08000000" Offset="0.42"/>
                            <GradientStop Color="#B8000000" Offset="0.78"/>
                            <GradientStop Color="#54000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>

                <Border x:Name="GlassCoolRimBorder"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Opacity="0"
                        BorderThickness="1.8"
                        CornerRadius="14">
                    <Border.BorderBrush>
                        <RadialGradientBrush Center="0.14,0.72"
                                               GradientOrigin="0.14,0.72"
                                               RadiusX="0.68" RadiusY="0.82"
                                               po:Freeze="True">
                            <GradientStop Color="#E57D92FF" Offset="0"/>
                            <GradientStop Color="#8871C8FF" Offset="0.26"/>
                            <GradientStop Color="#247BDFFF" Offset="0.58"/>
                            <GradientStop Color="#007BDFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.BorderBrush>
                </Border>

                <Border x:Name="GlassWarmRimBorder"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Opacity="0"
                        BorderThickness="1.65"
                        CornerRadius="14">
                    <Border.BorderBrush>
                        <RadialGradientBrush Center="0.9,0.2"
                                               GradientOrigin="0.9,0.2"
                                               RadiusX="0.58" RadiusY="0.76"
                                               po:Freeze="True">
                            <GradientStop Color="#E5FFD27A" Offset="0"/>
                            <GradientStop Color="#7CFFAB5C" Offset="0.3"/>
                            <GradientStop Color="#18FF9348" Offset="0.64"/>
                            <GradientStop Color="#00FF9348" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.BorderBrush>
                </Border>

                <Border x:Name="GlassFresnelBloomBorder"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Opacity="0"
                        BorderThickness="3.2"
                        CornerRadius="14"
                        BorderBrush="Transparent">
                    <Border.Effect>
                        <BlurEffect Radius="3.2"
                                    KernelType="Gaussian"
                                    RenderingBias="Quality"/>
                    </Border.Effect>
                </Border>

                <Border x:Name="GlassFresnelBorder"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Opacity="0"
                        BorderThickness="1.15"
                        CornerRadius="14"
                        BorderBrush="Transparent"/>

                <Border x:Name="GlassInnerFresnelBorder"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Opacity="0"
                        Margin="1.15"
                        BorderThickness="0.8"
                        CornerRadius="13"
                        BorderBrush="Transparent"/>

                <Border x:Name="GlassRimBorder"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Opacity="0"
                        BorderThickness="0.75"
                        CornerRadius="14">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0.04,0" EndPoint="0.96,1" po:Freeze="True">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#B8E9F7FF" Offset="0.16"/>
                            <GradientStop Color="#30FFFFFF" Offset="0.38"/>
                            <GradientStop Color="#18000000" Offset="0.57"/>
                            <GradientStop Color="#A6000000" Offset="0.76"/>
                            <GradientStop Color="#48FFFFFF" Offset="0.91"/>
                            <GradientStop Color="#D8FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                </Border>

                <Border x:Name="GlassSpecularBorder"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Opacity="0"
                        BorderThickness="1.15"
                        CornerRadius="14">
                    <Border.BorderBrush>
                        <RadialGradientBrush Center="0.22,0.08"
                                               GradientOrigin="0.18,0.02"
                                               RadiusX="0.38" RadiusY="0.62"
                                               po:Freeze="True">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#FFFFFFFF" Offset="0.13"/>
                            <GradientStop Color="#8CFFFFFF" Offset="0.34"/>
                            <GradientStop Color="#10FFFFFF" Offset="0.68"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.BorderBrush>
                </Border>
            </Grid>

            </Canvas>

            <!-- ClipToBounds keeps rows inside the shell while its explicit
                 morph height is smaller than the content's natural height. -->
            <Grid x:Name="ShellContent"
                  ClipToBounds="True"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ContentTranslate" Y="0"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

            <!-- Search field: text on the left, magnifier on the right (Flow Launcher layout). -->
            <Grid Margin="22,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="SearchBoxContainer" Margin="0,0,16,0" RenderTransformOrigin="0.0,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SearchBoxScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="SearchBoxTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <!-- Inline autocomplete: the typed prefix is rendered transparent so
                         only the dim completion tail shows behind the real caret text. -->
                    <TextBlock x:Name="AutocompleteText"
                               FontFamily="{StaticResource SFProDisplay}"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="1,2,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"><Run x:Name="AutocompleteTypedRun" Foreground="Transparent"/><Run x:Name="AutocompleteSuffixRun" Foreground="#48FFFFFF"/></TextBlock>
                    <TextBox x:Name="SearchBox" ContextMenuOpening="SearchBox_ContextMenuOpening"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="SearchBox_TextChanged"
                             SelectionChanged="SearchBox_SelectionChanged"
                             GotFocus="SearchBox_GotFocus"
                             LostFocus="SearchBox_LostFocus"
                             FontFamily="{StaticResource SFProDisplay}"
                             FontSize="20"
                             FontWeight="Bold"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             CaretBrush="Transparent"
                             SelectionBrush="#FFFFFF"
                             SelectionTextBrush="#C8C8C8"
                             SelectionOpacity="0.35"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="2,2,0,0"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="Search apps and files">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" />
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <Border x:Name="GlowingCaret"
                            Width="2"
                            Height="22"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#FFFFFF"
                            CornerRadius="1"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CaretScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="CaretGlow"
                                              Color="#FFFFFF"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.95"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock x:Name="PlaceholderText"
                               Text="Search apps and files"
                               FontFamily="{StaticResource SFProDisplay}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#44FFFFFF"
                               Margin="7,0,0,0"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border x:Name="EscBadge"
                        MouseLeftButtonDown="AiToggle_Click" Cursor="Hand"
                        Grid.Column="1"
                        Margin="0,0,14,0"
                        Style="{StaticResource KeyBadgeStyle}">
                    <TextBlock x:Name="EscBadgeText"
                               Text="TAB · AI"
                               FontFamily="{StaticResource SFProDisplay}"
                               FontSize="9.5"
                               FontWeight="Bold"
                               Foreground="#D0D0D8"/>
                </Border>

                <controls:MorphingSettingsIcon x:Name="SearchIcon"
                                               Grid.Column="2"
                                               Width="19" Height="19"
                                               Brush="#C0C0C8"
                                               VerticalAlignment="Center"
                                               Cursor="Hand"
                                               MouseLeftButtonDown="AiToggle_Click"
                                               RenderTransformOrigin="0.5,0.5">
                    <controls:MorphingSettingsIcon.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SearchIconScale" ScaleX="1" ScaleY="1"/>
                            <RotateTransform x:Name="SearchIconRotate" Angle="0"/>
                        </TransformGroup>
                    </controls:MorphingSettingsIcon.RenderTransform>
                </controls:MorphingSettingsIcon>
            </Grid>

            <!-- Results appear only after the user starts searching. -->
            <Border x:Name="ContentRegion"
                    Grid.Row="1"
                    BorderBrush="#14FFFFFF"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ContentRegionTranslate" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,6,0,7">
                        <StackPanel x:Name="AiPanel" Visibility="Collapsed" Margin="20,10,20,4" TextElement.FontFamily="{StaticResource SFProDisplay}" TextElement.FontWeight="Bold">
                            <!-- Unified macOS Header Toolbar -->
                            <Grid x:Name="AiHeader" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Back button + Model Pill -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="AiBackButton" Style="{StaticResource AiToolbarStyle}" Click="AiBack_Click" Margin="0,0,10,0">
                                        <Path Data="{x:Static local:SpotlightWindow.AiArrowLeftGeometry}" Fill="{x:Static local:SpotlightWindow.ChatIconBrush}" Stretch="Uniform" Width="11" Height="11"/>
                                    </Button>
                                    <StackPanel x:Name="AiModelPill" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="AiModeLabel" Foreground="#C8C8C8" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: Metadata + Action buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="AiMetadata" Foreground="#8C959E" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button x:Name="AiCopyButton" Style="{StaticResource AiToolbarStyle}" Click="AiCopy_Click" Margin="0,0,6,0">
                                        <Path Data="{x:Static local:SpotlightWindow.AiCopyGeometry}" Fill="{x:Static local:SpotlightWindow.ChatIconBrush}" Stretch="Uniform" Width="10" Height="10"/>
                                    </Button>
                                    <Button x:Name="AiHistoryButton" Style="{StaticResource AiToolbarStyle}" Click="AiHistory_Click" Margin="0,0,6,0">
                                        <Path Data="{x:Static local:SpotlightWindow.AiHistoryGeometry}" Fill="{x:Static local:SpotlightWindow.ChatIconBrush}" Stretch="Uniform" Width="11.5" Height="11.5"/>
                                    </Button>
                                    <Button x:Name="AiNewChatButton" Style="{StaticResource AiToolbarStyle}" Click="AiNewChat_Click">
                                        <Path Data="{x:Static local:SpotlightWindow.AiPlusGeometry}" Fill="{x:Static local:SpotlightWindow.ChatIconBrush}" Stretch="Uniform" Width="9" Height="9"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Welcome Screen (Monochrome Gray Aesthetic) -->
                            <Border x:Name="AiWelcome" Padding="22,22" Margin="0,0,0,6" Background="Transparent">
                                <StackPanel>
                                    <TextBlock Text="✦" FontFamily="{StaticResource SFProDisplay}" FontSize="28" FontWeight="Bold" Foreground="{x:Static local:SpotlightWindow.ChatIconBrush}" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                                    <TextBlock x:Name="AiWelcomeTitle" FontFamily="{StaticResource SFProDisplay}" Foreground="#C8C8C8" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="AiWelcomeHint" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" Foreground="#8C959E" FontSize="12" Margin="0,6,0,16" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <WrapPanel HorizontalAlignment="Center">
                                        <Button x:Name="AiPromptOne" Style="{StaticResource AiSuggestionStyle}" Click="AiSuggestion_Click" Margin="0,0,8,6"/>
                                        <Button x:Name="AiPromptTwo" Style="{StaticResource AiSuggestionStyle}" Click="AiSuggestion_Click" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <ScrollViewer x:Name="AiHistoryPanel" Visibility="Collapsed" MaxHeight="310" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/></ScrollViewer.Resources>
                                <StackPanel x:Name="AiHistoryItems" Margin="0,2,8,0" HorizontalAlignment="Stretch"/>
                            </ScrollViewer>

                            <Grid ClipToBounds="True">
                            <ScrollViewer x:Name="AiTranscriptScroll" ScrollChanged="AiTranscript_ScrollChanged" MaxHeight="310" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/></ScrollViewer.Resources>
                                <StackPanel x:Name="AiTranscript" Margin="0,0,8,0"/>
                            </ScrollViewer>
                            <Border x:Name="AiTopEdge" Height="22" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F0000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.Background>
                                <Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="White" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Border.OpacityMask>
                                <Rectangle>
                                    <Rectangle.Fill><VisualBrush x:Name="AiTopEdgeBrush" Visual="{Binding ElementName=AiTranscriptScroll}" ViewboxUnits="RelativeToBoundingBox" Viewbox="0,0,1,0.07" Stretch="Fill"/></Rectangle.Fill>
                                    <Rectangle.Effect><BlurEffect Radius="5"/></Rectangle.Effect>
                                </Rectangle>
                            </Border>
                            <Border x:Name="AiBottomEdge" Height="22" VerticalAlignment="Bottom" IsHitTestVisible="False" Opacity="0">
                                <Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#F0000000" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></LinearGradientBrush></Border.Background>
                                <Border.OpacityMask><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Border.OpacityMask>
                                <Rectangle>
                                    <Rectangle.Fill><VisualBrush x:Name="AiBottomEdgeBrush" Visual="{Binding ElementName=AiTranscriptScroll}" ViewboxUnits="RelativeToBoundingBox" Viewbox="0,0,1,0.07" Stretch="Fill"/></Rectangle.Fill>
                                    <Rectangle.Effect><BlurEffect Radius="5"/></Rectangle.Effect>
                                </Rectangle>
                            </Border>
                            </Grid>

                            <!-- Unified Bottom Status and Action Row (Cancel button, status, and token usage on 1 line) -->
                            <Border x:Name="AiBottomActionRow" Margin="0,4,0,0" Padding="0">
                                <Grid MinHeight="42">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column: Status, Usage, and Activity Tracking -->
                                    <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <!-- Hidden activity elements (used by code-behind for state tracking) -->
                                        <Grid Width="0" Height="0" Visibility="Collapsed">
                                            <Ellipse x:Name="AiActivityHalo" Width="14" Height="14" Fill="#20FFFFFF" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="AiActivityHaloScale" ScaleX="1" ScaleY="1"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse x:Name="AiActivityDot" Width="6" Height="6" Fill="#90959E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Status stays visible when streaming or when failed prompt is restored to the input -->
                                        <TextBlock x:Name="AiStatus" TextWrapping="Wrap" HorizontalAlignment="Left" TextAlignment="Left" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#A8ACB6"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="Tag" Value="error">
                                                            <Setter Property="Foreground" Value="#FF6B6B"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Token usage and quota bar inline with status -->
                                        <Grid x:Name="AiUsageRow" VerticalAlignment="Center" Margin="0,0,0,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="AiUsageText" FontFamily="{StaticResource SFProDisplay}" FontWeight="Bold" FontSize="11" Foreground="#8E929E" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <ProgressBar x:Name="AiQuotaBar" Width="40" Height="3" Margin="8,0,0,0" Minimum="0" Maximum="100" Foreground="#C8C8C8" Background="#252525" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </StackPanel>
                                            <Button x:Name="AiUsageRefresh" Grid.Column="1" Style="{StaticResource AiToolbarStyle}" Click="AiUsageRefresh_Click" Content="↻" Foreground="#C8C8C8" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </WrapPanel>

                                    <!-- Right Column: Stop Button -->
                                    <Grid Grid.Column="1" Width="44" Height="44" VerticalAlignment="Center">
                                        <controls:AiStopButton x:Name="AiStopButton" Style="{StaticResource AiStopButtonStyle}" Click="AiStop_Click" HideCompleted="AiStopButton_HideCompleted" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <ListBox x:Name="ResultsList"
                                 ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ResultItemStyle}"
                                 SelectionChanged="ResultsList_SelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="440"
                                 AlternationCount="20"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 AutomationProperties.Name="Search results">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <!-- Shared selection highlight lives inside scrolled content
                                         so it stays glued to its target row while scrolling. -->
                                    <ScrollViewer Focusable="False"
                                                  CanContentScroll="False"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <Grid>
                                            <Border x:Name="SelectionGlide"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="{StaticResource SelectedItemBrush}"
                                                    CornerRadius="8"
                                                    Opacity="0"
                                                    IsHitTestVisible="False">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="SelectionGlideTransform"/>
                                                </Border.RenderTransform>
                                                <!-- Full-height accent bar hugging the row's left edge. -->
                                                <Border Width="3"
                                                        Margin="0,4"
                                                        CornerRadius="1.5"
                                                        Background="{StaticResource AccentBrush}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Stretch"/>
                                            </Border>
                                            <ItemsPresenter/>
                                        </Grid>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="38"
                                          AutomationProperties.Name="{Binding DisplayTitle}"
                                          ToolTip="{Binding Target}"
                                          AutomationProperties.HelpText="{Binding Subtitle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="32"
                                              Height="32"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}"
                                                   Width="32"
                                                   Height="32"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Viewbox Width="22" Height="22" Stretch="Uniform"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path x:Name="SolidSystemIcon" Data="{Binding SolidIcon}"
                                                          Stretch="None" Fill="#AAAAAA"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="FallbackGlyph"
                                                       Text="{Binding Glyph}"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="20"
                                                       FontWeight="Normal"
                                                       Foreground="#B4FFFFFF"
                                                       Visibility="Collapsed"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Path x:Name="ShortcutArrow" Visibility="Collapsed"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                  Margin="-1,0,0,-1" Fill="#FFFFFF"
                                                  IsHitTestVisible="False"
                                                  Data="M1 15 L1 9 Q1 4 6 4 L8 4 L8 0 L16 6 L8 12 L8 8 L6 8 Q5 8 5 10 L5 15 Z">
                                                <Path.Effect>
                                                    <DropShadowEffect Color="Black" BlurRadius="4"
                                                                      ShadowDepth="1" Opacity="0.9"
                                                                      RenderingBias="Performance"/>
                                                </Path.Effect>
                                            </Path>
                                            <controls:MediaPinBadge IsPinned="{Binding IsPinned}"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1"
                                                    Margin="4,0,16,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock controls:HighlightedText.Text="{Binding DisplayTitle}"
                                                       controls:HighlightedText.Query="{Binding DataContext.Query, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontFamily="{StaticResource SFProDisplay}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TitleTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SubtitleText"
                                                       Text="{Binding DisplaySubtitle}"
                                                       Margin="0,2,0,0"
                                                       FontFamily="{StaticResource SFProDisplay}"
                                                       FontSize="11.5"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TertiaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border x:Name="HotkeyBadge"
                                                Grid.Column="2"
                                                Style="{StaticResource KeyBadgeStyle}">
                                            <TextBlock x:Name="HotkeyText"
                                                       Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource HotkeyConverter}}"
                                                       FontFamily="{StaticResource SFProDisplay}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#86FFFFFF"/>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsShortcut}" Value="True">
                                            <Setter TargetName="ShortcutArrow" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SolidIcon}" Value="{x:Null}">
                                            <Setter TargetName="SolidSystemIcon" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Icon}" Value="{x:Null}"/>
                                                <Condition Binding="{Binding SolidIcon}" Value="{x:Null}"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding Subtitle}" Value="">
                                            <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=HotkeyText}" Value="">
                                            <Setter TargetName="HotkeyBadge" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid x:Name="StatusPanel"
                              MinHeight="112"
                              Margin="24,4,24,14"
                              Visibility="Collapsed"
                              AutomationProperties.LiveSetting="Polite">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="StatusWarningIcon"
                                      Width="26" Height="24"
                                      Margin="0,0,0,10"
                                      Stretch="Uniform"
                                      Fill="#C8C8C8"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      Data="M12,1.67 C12.955,1.67 13.845,2.137 14.39,2.917 L14.495,3.077 L22.609,16.625 C23.63,18.33 22.4,20.99 20.302,21 L4.077,21 C1.979,20.99 0.749,18.33 1.77,16.625 L9.88,3.087 C10.425,2.137 11.315,1.67 12,1.67 Z M12.01,15 L11.883,15.007 A1,1 0 0,0 12.01,17 A1,1 0 0,0 12.01,15 Z M12,8 A1,1 0 0,0 11.007,8.883 L11,9 L11,13 A1,1 0 0,0 13,13 L13,9 A1,1 0 0,0 12,8 Z"/>
                                <TextBlock x:Name="StatusGlyph"
                                           Text="&#xE721;"
                                           Margin="0,0,0,10"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="24"
                                           FontWeight="Normal"
                                           Foreground="#66FFFFFF"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="StatusTitle"
                                           FontFamily="{StaticResource SFProDisplay}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#D8FFFFFF"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="StatusHint"
                                           MaxWidth="520"
                                           Margin="0,4,0,0"
                                           FontFamily="{StaticResource SFProDisplay}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Only surfaces when a launch fails; there is no permanent footer. -->
                    <Border x:Name="FailureBar"
                            Grid.Row="1"
                            BorderBrush="#12FFFFFF"
                            BorderThickness="0,1,0,0"
                            Padding="22,9"
                            Visibility="Collapsed">
                        <TextBlock x:Name="FailureText"
                                   FontFamily="{StaticResource SFProDisplay}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#E8FFA894"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Assertive"/>
                    </Border>
                </Grid>
                </Border>
            </Grid>

            <!-- Rounded viewport follows morphing shell while bitmap retains native
                 size cropped from top rather than being squeezed into search bar. -->
            <Border x:Name="NotchMorphSnapshot"
                    Margin="-1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    CornerRadius="14"
                    IsHitTestVisible="False"
                    Visibility="Hidden"
                    Opacity="0">
                <Border.Background>
                    <ImageBrush x:Name="NotchMorphSnapshotBrush"
                                Stretch="None"
                                AlignmentX="Center"
                                AlignmentY="Top"/>
                </Border.Background>
            </Border>
            <!-- AI Focus Ambient Rim (Monochrome Gray) -->
            <Border x:Name="AiGlowBorder"
                    Margin="-1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="#26FFFFFF"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect x:Name="AiGlowEffect"
                                      Color="#000000"
                                      BlurRadius="16"
                                      ShadowDepth="0"
                                      Opacity="0.6"/>
                </Border.Effect>
            </Border>
        </Grid>
    </Border>
    </Grid>
    </AdornerDecorator>
</Window>
