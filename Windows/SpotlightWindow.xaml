<Window x:Class="VNotch.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VNotch.Controls"
        Title="V-Notch Spotlight"
        Width="720"
        SizeToContent="Height"
        MaxHeight="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        AutomationProperties.Name="V-Notch Spotlight">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4FFFFFF"/>
        <SolidColorBrush x:Key="TitleTextBrush" Color="#C2FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8AFFFFFF"/>
        <SolidColorBrush x:Key="TertiaryTextBrush" Color="#54FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="ShellBrush" Color="#F6060608"/>
        <SolidColorBrush x:Key="ShellBorderBrush" Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="SelectedItemBrush" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="HoverItemBrush" Color="#0CFFFFFF"/>

        <Style x:Key="KeyBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ThinScrollBarThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="4"
                                HorizontalAlignment="Center"
                                CornerRadius="2"
                                Background="#30FFFFFF"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Margin" Value="0,2,3,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <EventSetter Event="MouseLeftButtonUp" Handler="ResultItem_MouseLeftButtonUp"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="10,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="HoverSurface"
                                    Background="{StaticResource HoverItemBrush}"
                                    CornerRadius="10"
                                    Opacity="0"/>
                            <Border x:Name="SelectionSurface"
                                    Background="{StaticResource SelectedItemBrush}"
                                    BorderBrush="#1CFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Visibility="Collapsed"/>
                            <Border Padding="14,7">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="SelectionAccent"
                                    Width="3"
                                    Height="24"
                                    CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFFFFF"
                                                      BlurRadius="8"
                                                      ShadowDepth="0"
                                                      Opacity="0.35"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.10"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverSurface"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionSurface" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SelectionAccent" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SelectionAccent"
                                                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                             From="0.4"
                                                             To="1"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SelectionAccent"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell"
            CornerRadius="20"
            Background="{StaticResource ShellBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="1"
            ClipToBounds="False"
            Opacity="0"
            RenderTransformOrigin="0.5,0.12">
        <Border.Effect>
            <DropShadowEffect Color="#020408" BlurRadius="42" ShadowDepth="14" Opacity="0.78"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="0.98" ScaleY="0.98"/>
        </Border.RenderTransform>

        <Grid x:Name="ShellContent"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ContentTranslate" Y="0"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search field -->
            <Grid Margin="26,0,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="&#xE721;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="21"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>

                <Grid Grid.Column="1" Margin="2,0,18,0">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown"
                             FontFamily="{StaticResource SFProDisplay}"
                             FontSize="23"
                             FontWeight="Normal"
                             Foreground="{StaticResource PrimaryTextBrush}"
                             CaretBrush="{StaticResource AccentBrush}"
                             SelectionBrush="#4DFFFFFF"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,2,0,0"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="Search apps and files"/>
                    <TextBlock x:Name="PlaceholderText"
                               Text="Search apps and files"
                               FontFamily="{StaticResource SFProDisplay}"
                               FontSize="23"
                               FontWeight="Normal"
                               Foreground="#4CFFFFFF"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border Grid.Column="2"
                        Style="{StaticResource KeyBadgeStyle}">
                    <TextBlock Text="ESC"
                               FontFamily="{StaticResource SFProText}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#72FFFFFF"/>
                </Border>
            </Grid>

            <!-- Results and keyboard help appear only after the user starts searching. -->
            <Border x:Name="ContentRegion"
                    Grid.Row="1"
                    BorderBrush="#14FFFFFF"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ContentRegionTranslate" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,2,0,8">
                        <ListBox x:Name="ResultsList"
                                 ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ResultItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="440"
                                 AlternationCount="20"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Search results">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                            </ListBox.Resources>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       Margin="26,10,25,5"
                                                       FontFamily="{StaticResource SFProText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#58FFFFFF"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="42"
                                          AutomationProperties.Name="{Binding Title}"
                                          AutomationProperties.HelpText="{Binding Subtitle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="30"
                                              Height="30"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}"
                                                   Width="28"
                                                   Height="28"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock x:Name="FallbackGlyph"
                                                       Text="{Binding Glyph}"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="19"
                                                       Foreground="#B4FFFFFF"
                                                       Visibility="Collapsed"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1"
                                                    Margin="4,0,16,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock controls:HighlightedText.Text="{Binding Title}"
                                                       controls:HighlightedText.Query="{Binding DataContext.Query, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontFamily="{StaticResource SFProDisplay}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TitleTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Margin="0,1,0,0"
                                                       FontFamily="{StaticResource SFProText}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TertiaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border x:Name="OpenBadge"
                                                Grid.Column="2"
                                                Style="{StaticResource KeyBadgeStyle}"
                                                Padding="7,3"
                                                Opacity="0">
                                            <TextBlock Text="&#x21B5;"
                                                       FontFamily="{StaticResource SFProText}"
                                                       FontSize="11"
                                                       Foreground="#AFFFFFFF"/>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                            <Setter TargetName="FallbackGlyph" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="OpenBadge"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1"
                                                                         Duration="0:0:0.14"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="OpenBadge"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.10"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid x:Name="StatusPanel"
                              MinHeight="112"
                              Margin="24,4,24,14"
                              Visibility="Collapsed"
                              AutomationProperties.LiveSetting="Polite">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusGlyph"
                                           Text="&#xE721;"
                                           Margin="0,0,0,10"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="24"
                                           Foreground="#66FFFFFF"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="StatusTitle"
                                           FontFamily="{StaticResource SFProDisplay}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#D8FFFFFF"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="StatusHint"
                                           MaxWidth="520"
                                           Margin="0,4,0,0"
                                           FontFamily="{StaticResource SFProText}"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="#10FFFFFF"
                            BorderThickness="0,1,0,0">
                        <Grid Margin="26,0,22,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#x2191; &#x2193;"
                                           FontSize="11"
                                           Foreground="#A6FFFFFF"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavigateHintText"
                                           Text="Navigate"
                                           Margin="7,0,0,0"
                                           FontFamily="{StaticResource SFProText}"
                                           FontSize="10"
                                           Foreground="#5CFFFFFF"
                                           VerticalAlignment="Center"/>
                                <Border Width="1" Height="12" Margin="12,0" Background="#1CFFFFFF"/>
                                <TextBlock Text="&#x21B5;"
                                           FontSize="12"
                                           Foreground="#A6FFFFFF"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="OpenHintText"
                                           Text="Open"
                                           Margin="7,0,0,0"
                                           FontFamily="{StaticResource SFProText}"
                                           FontSize="10"
                                           Foreground="#5CFFFFFF"
                                           VerticalAlignment="Center"/>
                                <StackPanel x:Name="RevealHintGroup"
                                            Orientation="Horizontal"
                                            Visibility="Collapsed">
                                    <Border Width="1" Height="12" Margin="12,0" Background="#1CFFFFFF"/>
                                    <TextBlock Text="Ctrl &#x21B5;"
                                               FontFamily="{StaticResource SFProText}"
                                               FontSize="10"
                                               Foreground="#A6FFFFFF"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RevealHintText"
                                               Text="Show in folder"
                                               Margin="7,0,0,0"
                                               FontFamily="{StaticResource SFProText}"
                                               FontSize="10"
                                               Foreground="#5CFFFFFF"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Border Style="{StaticResource KeyBadgeStyle}" Padding="6,2">
                                    <TextBlock Text="ESC"
                                               FontFamily="{StaticResource SFProText}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="#78FFFFFF"/>
                                </Border>
                                <TextBlock x:Name="EscHintText"
                                           Text="Clear"
                                           Margin="7,0,0,0"
                                           FontFamily="{StaticResource SFProText}"
                                           FontSize="10"
                                           Foreground="#5CFFFFFF"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
