                                                          StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Width="11"
                                                          Height="11"
                                                          Stretch="None"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1"
                                                    Height="1"
                                                    Background="#1AFFFFFF"
                                                    Margin="8,0"
                                                    SnapsToDevicePixels="True"/>
                                            <Border x:Name="CountdownMinusBtn"
                                                    Grid.Row="2"
                                                    Background="Transparent"
                                                    CornerRadius="0,0,12,12"
                                                    Cursor="Hand"
                                                    MouseEnter="CountdownStepBtn_MouseEnter"
                                                    MouseLeave="CountdownBtn_MouseLeaveOrUp"
                                                    MouseLeftButtonDown="CountdownMinus_Click"
                                                    MouseLeftButtonUp="CountdownBtn_MouseLeaveOrUp">
                                                <Grid>
                                                    <Border x:Name="CountdownMinusHighlight"
                                                            Background="White"
                                                            Opacity="0"
                                                            CornerRadius="0,0,12,12"
                                                            IsHitTestVisible="False"/>
                                                    <Path Data="M0,5.5 L11,5.5"
                                                          Stroke="#E6FFFFFF"
                                                          StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Width="11"
                                                          Height="11"
                                                          Stretch="None"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                </Grid>
                            </Border>
                        </Grid>

                    </Grid>

                    <Grid x:Name="AudioContent"
                          Opacity="0"
                          Visibility="Collapsed"
                          Margin="22,40,16,14"
                          MouseLeftButtonDown="SecondaryContent_Click"
                          UseLayoutRounding="True"
                          SnapsToDevicePixels="True"
                          TextOptions.TextFormattingMode="Ideal"
                          TextOptions.TextRenderingMode="Grayscale"
                          TextOptions.TextHintingMode="Animated">
                        <ScrollViewer x:Name="AudioScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly"
                                      Padding="0,0,7,0"
                                      ScrollChanged="AudioScrollViewer_ScrollChanged">
                            <ScrollViewer.Resources>

                                <Style x:Key="AudioScrollPageButton" TargetType="RepeatButton">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="IsTabStop" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>

                                <Style TargetType="ScrollBar">
                                    <Setter Property="Width" Value="5"/>
                                    <Setter Property="MinWidth" Value="5"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Grid Background="Transparent">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Style="{StaticResource AudioScrollPageButton}"
                                                                          Command="ScrollBar.PageUpCommand"/>
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Style="{StaticResource AudioScrollPageButton}"
                                                                          Command="ScrollBar.PageDownCommand"/>
                                                        </Track.IncreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb>
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border Width="5"
                                                                                CornerRadius="2.5"
                                                                                Background="#59FFFFFF"/>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ScrollViewer.Resources>
                            <ScrollViewer.Template>

                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <ScrollContentPresenter Margin="{TemplateBinding Padding}"
                                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                                   Orientation="Vertical"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,2,0,2"
                                                   Maximum="{TemplateBinding ScrollableHeight}"
                                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>

                            <ScrollViewer.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop x:Name="AudioFadeTopStop" Color="Black" Offset="0"/>
                                    <GradientStop Color="Black" Offset="0.06"/>
                                    <GradientStop Color="Black" Offset="0.94"/>
                                    <GradientStop x:Name="AudioFadeBottomStop" Color="Black" Offset="1"/>
                                </LinearGradientBrush>
                            </ScrollViewer.OpacityMask>
                            <StackPanel x:Name="AudioRoot"
                                        Opacity="1">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="AudioRootTranslate" Y="0"/>
                                </StackPanel.RenderTransform>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel x:Name="AudioLoadingPanel"
                                    Visibility="Collapsed"
                                    Opacity="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="AudioLoadingTranslate" Y="0"/>
                            </StackPanel.RenderTransform>
                            <Border Width="36"
                                    Height="36"
                                    Margin="0,0,0,10"
                                    CornerRadius="18"
                                    Background="#12FFFFFF"
                                    BorderBrush="#18FFFFFF"
                                    BorderThickness="1">
                                <TextBlock Text="&#xE995;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="17"
                                           Foreground="#BFFFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="AudioLoadingText"
                                       Text="Loading sound mixer..."
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       FontWeight="Medium"
                                       FontFamily="{StaticResource MainSystemFont}"
                                       TextOptions.TextFormattingMode="Ideal">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="IsVisible" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard Name="TextShimmerAnim">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[0].(GradientStop.Offset)"
                                                                             From="-0.45" To="1.05" Duration="0:0:1.6" />
                                                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[1].(GradientStop.Offset)"
                                                                             From="-0.20" To="1.30" Duration="0:0:1.6" />
                                                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(GradientBrush.GradientStops)[2].(GradientStop.Offset)"
                                                                             From="0.05" To="1.55" Duration="0:0:1.6" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="TextShimmerAnim" />
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#69FFFFFF" Offset="-0.45"/>
                                        <GradientStop Color="#F5FFFFFF" Offset="-0.20"/>
                                        <GradientStop Color="#69FFFFFF" Offset="0.05"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>

                        <Grid x:Name="AudioOverlay"
                              Background="Transparent"
                              Visibility="Collapsed"
                              Panel.ZIndex="100"/>
                    </Grid>

                    <Grid x:Name="CountdownCompleteOverlay"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Width="{Binding Width, ElementName=NotchBorder}"
                          Height="{Binding Height, ElementName=NotchBorder}"
                          Opacity="0"
                          Visibility="Collapsed"
                          Background="Transparent"
                          MouseEnter="CountdownCompleteOverlay_MouseEnter"
                          MouseLeave="CountdownCompleteOverlay_MouseLeave"
                          Panel.ZIndex="200">
                        <Border x:Name="CountdownCompleteSurface"
                                Background="Black"
                                CornerRadius="{Binding CornerRadius, ElementName=NotchBorder}"
                                ClipToBounds="True"
                                Opacity="0"/>
                        <Grid Margin="16,0,16,0" VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="CountdownCompleteText"
                                           Grid.Column="0"
                                           Text="00:00"
                                           FontSize="36"
                                           FontWeight="ExtraBold"
                                           Foreground="#FFFF9B3D"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Margin="4,0,12,0"
                                           Padding="0"
                                           Opacity="0"
                                           FontFamily="{StaticResource MainSystemFont}"
                                           Typography.NumeralAlignment="Tabular"
                                           Typography.NumeralStyle="Lining">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="CountdownCompleteTextTranslate" Y="-14"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <Grid x:Name="CountdownRestartHost"
                                      Grid.Column="1"
                                      Opacity="0"
                                      Margin="0,0,12,0">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="CountdownRestartTranslate" Y="-14"/>
                                    </Grid.RenderTransform>
                                    <Border x:Name="CountdownRestartBtn"
                                            Width="58"
                                            Height="58"
                                            Background="#5A3518"
                                            CornerRadius="29"
                                            Cursor="Hand"
                                            MouseEnter="TimerControlButton_MouseEnter"
                                            MouseLeave="TimerControlButton_MouseLeave"
                                            MouseLeftButtonDown="CountdownRestart_Click">
                                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H21V3L17.65,6.35Z"
                                              Fill="#FFFF9B3D"
                                              Stretch="Uniform"
                                              Width="33"
                                              Height="33"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <Grid x:Name="CountdownDismissHost"
                                      Grid.Column="2"
                                      Opacity="0">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="CountdownDismissTranslate" Y="-14"/>
                                    </Grid.RenderTransform>
                                    <Border x:Name="CountdownDismissBtn"
                                            Width="58"
                                            Height="58"
                                            Background="#303030"
                                            CornerRadius="29"
                                            Cursor="Hand"
                                            MouseEnter="TimerControlButton_MouseEnter"
                                            MouseLeave="TimerControlButton_MouseLeave"
                                            MouseLeftButtonDown="CountdownDismiss_Click">
                                        <Path Data="M6,6 L18,18 M18,6 L6,18"
                                              Stroke="White"
                                              StrokeThickness="2.9"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Stretch="Uniform"
                                              Width="31"
                                              Height="31"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Border x:Name="HoverGlow"
                            CornerRadius="0,0,20,20"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush GradientOrigin="0.5,0" Center="0.5,0" RadiusX="0.9" RadiusY="1.1">
                                <GradientStop Color="#28FFFFFF" Offset="0"/>
                                <GradientStop Color="#08FFFFFF" Offset="0.65"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    </Grid>
                </Grid>
            </Border>
        </Border>

            <Border x:Name="UpdateInlineTooltip"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,34,10,0"
                    Visibility="Collapsed"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Panel.ZIndex="3000">
                <Border CornerRadius="10"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        Padding="10,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F0222222" Offset="0"/>
                            <GradientStop Color="#EA111111" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Ellipse Width="7" Height="7" Fill="#30D158" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ready To Update"
                                       Foreground="White"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource MainSystemFont}"/>
                        </DockPanel>
                        <TextBlock x:Name="UpdateInlineStatusText"
                                   Text="Version v-"
                                   Foreground="#CCFFFFFF"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0"
                                   FontFamily="{StaticResource MainSystemFont}"/>
                        <TextBlock x:Name="UpdateInlineHintText"
                                   Text="Click to download &amp; install"
                                   Foreground="#99FFFFFF"
                                   FontSize="9.5"
                                   FontWeight="Bold"
                                   Margin="0,5,0,0"
                                   FontFamily="{StaticResource MainSystemFont}"/>
                    </StackPanel>
                </Border>
            </Border>

            <Path x:Name="RightEar"
                  Grid.Column="2"
                  Data="M 11,0 L 0,0 L 0,10 C 0,4.4 4.8,0 11,0 Z"
                  Fill="{StaticResource NotchGradient}"
                  Width="11" Height="10"
                  Margin="-1,0,0,0"
                  VerticalAlignment="Top"
                  RenderOptions.EdgeMode="Unspecified"/>
        </Grid>
    </Grid>
</Grid>
</Window>
