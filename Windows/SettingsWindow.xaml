                                            <StackPanel>
                                                <CheckBox x:Name="CurrencyConversionCheck" Checked="TranslationSetting_Changed" Unchecked="TranslationSetting_Changed"/>
                                                <StackPanel x:Name="CurrencyOptions" Style="{StaticResource DisabledFeatureGroup}" IsEnabled="{Binding IsChecked, ElementName=CurrencyConversionCheck}">
                                                <TextBlock x:Name="TranslationCurrencyLabel" Style="{StaticResource SettingTitleText}" Margin="0,12,0,0"/>
                                                <ComboBox x:Name="TranslationCurrencyCombo" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="TranslationCurrency_Changed" MinHeight="36" Margin="0,8,0,0"/>
                                                <TextBlock x:Name="TranslationCurrencyHint" Style="{StaticResource SettingHintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
