                    </StackPanel>
                    <TextBlock x:Name="SidebarBuildVersionText"

                               Text="Build 2.1"
                               FontSize="10.5" FontWeight="Bold"
                               Foreground="#8C959E"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,2"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="1" IsHitTestVisible="False" VerticalAlignment="Top" Height="8" Panel.ZIndex="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Border Grid.Row="1" IsHitTestVisible="False" VerticalAlignment="Bottom" Height="24" Panel.ZIndex="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FF000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <ScrollViewer x:Name="SettingsScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="20,0,14,14"
                                  CanContentScroll="False"
                                   PreviewMouseWheel="SettingsScrollViewer_PreviewMouseWheel">
                        <Grid x:Name="ContentHost">

                            <StackPanel x:Name="PanelSearching" Visibility="Collapsed">
                                <Border x:Name="SearchingCard" Opacity="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=SearchingEmptyState}" Value="Visible">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="SearchingCardTranslate" Y="12"/>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock x:Name="SearchingHeader" Text="Search mode" Style="{StaticResource SectionHeader}" Visibility="Collapsed"/>
                                        <StackPanel x:Name="SearchingEmptyState"
                                                    Visibility="Collapsed"
                                                    Margin="28,32,28,36">
                                            <TextBlock Text="404" FontSize="144" FontWeight="Bold"
                                                       Foreground="#E8E8E8" FlowDirection="LeftToRight"
                                                       HorizontalAlignment="Left"
                                                       LineHeight="156" LineStackingStrategy="BlockLineHeight"
                                                       AutomationProperties.Name="404"/>
                                            <TextBlock x:Name="SearchingEmptyText"
                                                       Text="No matching settings."
                                                       Margin="4,24,0,0" FontSize="24" FontWeight="Bold"
                                                       Foreground="{StaticResource SoftText}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock x:Name="SearchingEmptyQuery"
                                                       Margin="4,10,0,0" FontSize="14" FontWeight="Bold"
                                                       Foreground="#B0B0B0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            <TextBlock x:Name="SearchingEmptyHint"
                                                       Text="Try a different keyword or a shorter search."
                                                       Margin="4,8,0,0" FontSize="13" FontWeight="Bold"
                                                       Foreground="{StaticResource MutedText}"
                                                       TextWrapping="Wrap"/>
                                            <Button x:Name="SearchingClearButton" Content="Clear search"
                                                    Style="{StaticResource PrimaryButton}"
                                                    HorizontalAlignment="Left" Margin="4,30,0,0"
                                                    MinWidth="132" Height="42"
                                                    Click="SearchingClearButton_Click"/>
                                        </StackPanel>
                                        <StackPanel x:Name="SearchResultsStack"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="PanelAppearance" Visibility="Visible">
                                <Border x:Name="AppearanceCard" Style="{StaticResource CardBorderStyle}" Opacity="0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="AppearanceCardTranslate" Y="12"/>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock x:Name="AppearanceHeader" Text="APPEARANCE" Style="{StaticResource SectionHeader}" Visibility="Collapsed"/>

                                        <!-- Navigation Tabs Order & Visibility -->
                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <CheckBox x:Name="DynamicIslandModeCheck"
                                                          x:Uid="dynamicIslandMode"
                                                          Content="Dynamic Island mode"
                                                          Checked="DynamicIslandModeCheck_Changed"
                                                          Unchecked="DynamicIslandModeCheck_Changed"
                                                          Margin="0,0,0,0"/>
                                                <TextBlock x:Name="DynamicIslandModeHint"
                                                           Text="Detach the notch from the top edge so it floats as a fully rounded pill."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}" Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock x:Name="DynamicIslandWidthLabel" Text="Dynamic Island Length" Style="{StaticResource SettingTitleText}" Visibility="Collapsed"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Visibility="Collapsed">
                                                    <Run x:Name="DynamicIslandWidthValue" Text="260"/><Run Text=" px"/>
                                                </TextBlock>
                                                <TextBlock x:Name="DynamicIslandWidthHint" Visibility="Collapsed"/>
                                                <controls:ElasticSlider x:Name="DynamicIslandWidthSlider"
                                                        Label="Dynamic Island Length" Unit=" px"
                                                        Description="Adjust the floating pill length used by Dynamic Island mode."
                                                        Minimum="100"
                                                        Maximum="520"
                                                        Value="260"
                                                        TickFrequency="10"
                                                        IsSnapToTickEnabled="True"
                                                        ValueChanged="DynamicIslandWidthSlider_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}" Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock x:Name="DynamicIslandHeightLabel" Text="Dynamic Island Width" Style="{StaticResource SettingTitleText}" Visibility="Collapsed"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Visibility="Collapsed">
                                                    <Run x:Name="DynamicIslandHeightValue" Text="40"/><Run Text=" px"/>
                                                </TextBlock>
                                                <TextBlock x:Name="DynamicIslandHeightHint" Visibility="Collapsed"/>
                                                <controls:ElasticSlider x:Name="DynamicIslandHeightSlider"
                                                        Label="Dynamic Island Width" Unit=" px"
                                                        Description="Adjust the floating pill width/thickness used by Dynamic Island mode."
                                                        Minimum="24"
                                                        Maximum="80"
                                                        Value="40"
                                                        TickFrequency="2"
                                                        IsSnapToTickEnabled="True"
                                                        ValueChanged="DynamicIslandHeightSlider_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <TextBlock x:Name="WidthLabel" Text="Width" Style="{StaticResource SettingTitleText}" Visibility="Collapsed"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Visibility="Collapsed">
                                                    <Run x:Name="WidthValue" Text="360"/><Run Text=" px"/>
                                                </TextBlock>
                                                <TextBlock x:Name="WidthHint" Visibility="Collapsed"/>
                                                <controls:ElasticSlider x:Name="WidthSlider"
                                                        Label="Width" Unit=" px"
                                                        Description="How wide the compact notch should sit on screen."
                                                        Minimum="100"
                                                        Maximum="400"
                                                        Value="200"
                                                        TickFrequency="10"
                                                        IsSnapToTickEnabled="True"
                                                        ValueChanged="WidthSlider_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <TextBlock x:Name="HeightLabel" Text="Height" Style="{StaticResource SettingTitleText}" Visibility="Collapsed"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Visibility="Collapsed">
                                                    <Run x:Name="HeightValue" Text="32"/><Run Text=" px"/>
                                                </TextBlock>
                                                <TextBlock x:Name="HeightHint" Visibility="Collapsed"/>
                                                <controls:ElasticSlider x:Name="HeightSlider"
                                                        Label="Height" Unit=" px"
                                                        Description="Controls the compact profile thickness."
                                                        Minimum="20"
                                                        Maximum="50"
                                                        Value="32"
                                                        TickFrequency="2"
                                                        IsSnapToTickEnabled="True"
                                                        ValueChanged="HeightSlider_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <TextBlock x:Name="RadiusLabel" Text="Corner Radius" Style="{StaticResource SettingTitleText}" Visibility="Collapsed"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Visibility="Collapsed">
                                                    <Run x:Name="RadiusValue" Text="16"/><Run Text=" px"/>
                                                </TextBlock>
                                                <TextBlock x:Name="RadiusHint" Visibility="Collapsed"/>
                                                <controls:ElasticSlider x:Name="RadiusSlider"
                                                        Label="Corner Radius" Unit=" px"
                                                        Description="Sharper for utility, softer for an island-like feel."
                                                        Minimum="0"
                                                        Maximum="30"
                                                        Value="16"
                                                        TickFrequency="2"
                                                        IsSnapToTickEnabled="True"
                                                        ValueChanged="RadiusSlider_ValueChanged"/>

                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <TextBlock x:Name="OpacityLabel" Text="Opacity" Style="{StaticResource SettingTitleText}" Visibility="Collapsed"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Visibility="Collapsed">
                                                    <Run x:Name="OpacityValue" Text="100"/><Run Text=" %"/>
                                                </TextBlock>
                                                <TextBlock x:Name="OpacityHint" Visibility="Collapsed"/>
                                                <controls:ElasticSlider x:Name="OpacitySlider"
                                                        Label="Opacity" Unit="%"
                                                        Description="Blend the notch into the desktop or keep it crisp and solid."
                                                        Minimum="50"
                                                        Maximum="100"
                                                        Value="100"
                                                        TickFrequency="5"
                                                        IsSnapToTickEnabled="True"
                                                        ValueChanged="OpacitySlider_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <TextBlock x:Name="NavTabsLabel" Text="Navigation Tabs" Style="{StaticResource SettingTitleText}"/>
                                                <TextBlock x:Name="NavTabsHint" Text="Hold and drag icons in the notch to reorder tabs, or arrange them here."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,8"/>
                                                <Border x:Name="NavTabsSettingsCard"
                                                        Background="{StaticResource SurfaceBrush}"
                                                        CornerRadius="14"
                                                        Padding="10,8"
                                                        Margin="0,4,0,10">
                                                    <StackPanel x:Name="NavTabsSettingsContainer"/>
                                                </Border>
                                                <Button x:Name="ResetTabOrderButton"
                                                        Content="Reset to Default Order"
                                                        HorizontalAlignment="Left"
                                                        Padding="12,6"
                                                        Margin="0,0,0,8"
                                                        Click="ResetTabOrderButton_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <TextBlock x:Name="ExpandedWidgetLabel" Text="Expanded widget" Style="{StaticResource SettingTitleText}"/>
                                                <TextBlock x:Name="ExpandedWidgetHint" Text="Choose which widget shows in the expanded notch."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,8"/>
                                                <ComboBox x:Name="WidgetCombo" SelectionChanged="WidgetCombo_SelectionChanged"/>
                                            </StackPanel>
                                        </Border>



                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <TextBlock x:Name="ClockPageStyleLabel" Text="Clock page style" Style="{StaticResource SettingTitleText}"/>
                                                <TextBlock x:Name="ClockPageStyleHint" Text="Choose the main clock display for the Clock &amp; Timer page."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,8"/>
                                                <ComboBox x:Name="ClockPageStyleCombo" SelectionChanged="ClockPageStyleCombo_SelectionChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}" Margin="0,4,0,4">
                                            <StackPanel>
                                                <CheckBox x:Name="MediaArtBackgroundCheck"
                                                          Content="Media art backdrop"
                                                          Checked="PerformanceSetting_Changed"
                                                          Unchecked="PerformanceSetting_Changed"/>
                                                <TextBlock x:Name="MediaArtBackgroundHint"
                                                           Text="Show the blurred album-art glow behind the expanded media view. Turn off for a cleaner, flat background."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="SubjectBlurRow" Style="{StaticResource SettingRowBorder}" Margin="0,0,0,4">
                                            <StackPanel>
                                                <CheckBox x:Name="EnableSubjectBlurCheck"
                                                          Content="Subject-aware media blur"
                                                          Checked="PerformanceSetting_Changed"
                                                          Unchecked="PerformanceSetting_Changed"/>
                                                <TextBlock x:Name="EnableSubjectBlurHint"
                                                           Text="Keeps media subjects clearer inside the blurred background. Disable it for a cheaper blur pass."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}" Margin="0,0,0,4">
                                            <StackPanel>
                                                <CheckBox x:Name="EnableSmartCropCheck"
                                                          Content="Smart thumbnail crop"
                                                          Checked="PerformanceSetting_Changed"
                                                          Unchecked="PerformanceSetting_Changed"/>
                                                <TextBlock x:Name="EnableSmartCropHint"
                                                           Text="Use the ONNX model to find better thumbnail crops. Disable it to avoid the heavier image-analysis path."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}" Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock x:Name="BlurLabel" Text="Blur Brightness" Style="{StaticResource SettingTitleText}" Visibility="Collapsed"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Visibility="Collapsed">
                                                    <Run x:Name="BlurBrightnessValue" Text="140"/><Run Text=" %"/>
                                                </TextBlock>
                                                <TextBlock x:Name="BlurHint" Visibility="Collapsed"/>
                                                <controls:ElasticSlider x:Name="BlurBrightnessSlider"
                                                        Label="Blur Brightness" Unit="%"
                                                        Description="Brighten the expanded media blur without changing the notch body opacity."
                                                        Minimum="100"
                                                        Maximum="200"
                                                        Value="140"
                                                        TickFrequency="5"
                                                        IsSnapToTickEnabled="True"
                                                        ValueChanged="BlurBrightnessSlider_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="PanelBehavior" Visibility="Collapsed">
                                <Border x:Name="BehaviorCard" Style="{StaticResource CardBorderStyle}" Opacity="0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="BehaviorCardTranslate" Y="12"/>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock x:Name="BehaviorHeader" Text="BEHAVIOR" Style="{StaticResource SectionHeader}" Visibility="Collapsed"/>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <CheckBox x:Name="AutoStartCheck" x:Uid="autoStart" Content="Start with Windows"/>
                                                <TextBlock x:Name="AutoStartHint" Text="Launch automatically when you sign in."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <CheckBox x:Name="InteractionSoundsCheck" Content="Interaction sounds"
                                                          Checked="InteractionSounds_Changed" Unchecked="InteractionSounds_Changed"/>
                                                <TextBlock x:Name="InteractionSoundsHint" Text="Play soft sounds for buttons, switches and selections."
                                                           Style="{StaticResource SettingHintText}"/>
                                                <controls:ElasticSlider x:Name="InteractionSoundVolumeSlider"
                                                    Label="SFX volume" Unit="%"
                                                    Description="Adjust interaction sounds only. Release to preview; 0% is silent."
                                                    Minimum="0" Maximum="100" Value="55" TickFrequency="5"
                                                    IsSnapToTickEnabled="True" Margin="0,12,0,0"
                                                    ValueChanged="InteractionSoundVolume_ValueChanged"
                                                    PreviewMouseUp="InteractionSoundVolume_MouseUp"
                                                    PreviewKeyUp="InteractionSoundVolume_KeyUp"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <CheckBox x:Name="StayBehindWindowsCheck" Content="Stay behind other windows"/>
                                                <TextBlock x:Name="StayBehindWindowsHint"
                                                           Text="Keep V-Notch on the desktop so maximized apps and browser tab controls are never covered."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <CheckBox x:Name="HelloGreetingCheck" x:Uid="helloGreeting" Content="Hello greeting on startup"/>
                                                <TextBlock x:Name="HelloGreetingHint" Text="Show handwriting 'hello' animation when the app starts."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <CheckBox x:Name="HideOnExclusiveFullscreenCheck" x:Uid="hideExclusiveFs" Content="Hide on exclusive fullscreen"/>
                                                <TextBlock x:Name="HideOnExclusiveFullscreenHint" Text="Hide the notch when a true fullscreen app is detected."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <CheckBox x:Name="HideOnWindowedFullscreenCheck" x:Uid="hideWindowedFs" Content="Hide on windowed fullscreen"/>
                                                <TextBlock x:Name="HideOnWindowedFullscreenHint" Text="Hide the notch when a borderless windowed fullscreen app is detected."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <CheckBox x:Name="HoverExpandCheck" x:Uid="hoverExpand" Content="Expand on hover"
                                                         Checked="HoverExpandCheck_Changed" Unchecked="HoverExpandCheck_Changed"/>
                                                <TextBlock x:Name="HoverExpandHint" Text="Open the notch automatically when the pointer lingers nearby."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}" Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock x:Name="ExpandDelayLabel" Text="Expand Delay" Style="{StaticResource SettingTitleText}" Visibility="Collapsed"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Visibility="Collapsed">
                                                    <Run x:Name="HoverDelayValue" Text="100"/><Run Text=" ms"/>
                                                </TextBlock>
                                                <TextBlock x:Name="ExpandDelayHint" Visibility="Collapsed"/>
                                                <controls:ElasticSlider x:Name="HoverDelaySlider"
                                                        Label="Expand Delay" Unit=" ms"
                                                        Description="Delay before hover opens the notch."
                                                        Minimum="0"
                                                        Maximum="500"
                                                        Value="100"
                                                        TickFrequency="50"
                                                        IsSnapToTickEnabled="True"
                                                        ValueChanged="HoverDelaySlider_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <CheckBox x:Name="DisableMouseLeaveAutoCloseCheck" x:Uid="disableMouseLeaveAutoClose" Content="Click to close (no auto-close)"/>
                                                <TextBlock x:Name="DisableMouseLeaveAutoCloseHint" Text="Keep the notch open when the cursor leaves; click to close it."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <CheckBox x:Name="ReopenLastViewCheck" x:Uid="reopenLastView" Content="Reopen last view on expand"/>
                                                <TextBlock x:Name="ReopenLastViewHint" Text="Restore the view that was open before the last collapse the next time the notch expands."
                                                           Style="{StaticResource SettingHintText}"
