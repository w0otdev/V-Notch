                                                <CheckBox x:Name="FormatTranslationCheck" Checked="TranslationSetting_Changed" Unchecked="TranslationSetting_Changed"/>
                                                <TextBlock x:Name="TranslationFormatHint" Style="{StaticResource SettingHintText}" Margin="0,6,0,14" TextWrapping="Wrap"/>
                                                <CheckBox x:Name="HumanizerTranslationCheck" Checked="TranslationSetting_Changed" Unchecked="TranslationSetting_Changed"/>
                                                <TextBlock x:Name="TranslationHumanizerHint" Style="{StaticResource SettingHintText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
