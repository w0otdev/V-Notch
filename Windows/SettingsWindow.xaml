                                                        <TextBlock x:Name="TranslationCustomHint" Style="{StaticResource SettingHintText}" TextWrapping="Wrap" Margin="0,6,0,16"/>
                                                        <TextBlock x:Name="TranslationAdvancedHint" Style="{StaticResource SettingHintText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                                        <StackPanel x:Name="TranslationAdvancedFields"/>
                                                        <Button x:Name="TranslationFastPreset" HorizontalAlignment="Left" Margin="0,12,0,0" Click="TranslationFastPreset_Click"/>
                                                        <TextBlock x:Name="TranslationFastHint" Style="{StaticResource SettingHintText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                        <Button x:Name="TranslationAdvancedReset" HorizontalAlignment="Left" Margin="0,12,0,0" Click="TranslationAdvancedReset_Click"/>
