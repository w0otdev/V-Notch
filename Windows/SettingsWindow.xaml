                                                            <TextBlock x:Name="TranslationProgressPercent" Grid.Column="1" Foreground="{StaticResource AccentBrushStrong}" FontWeight="SemiBold"/>
                                                        </Grid>
                                                        <Grid x:Name="TranslationProgressTrack" Height="8" ClipToBounds="True" SizeChanged="TranslationProgress_SizeChanged">
