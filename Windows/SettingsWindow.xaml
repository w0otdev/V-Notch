                                                           TextWrapping="Wrap"
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>

                                                <Border x:Name="SpotifyCanvasAccountPanel"
                                                        Background="#0F0F0F"
                                                        BorderBrush="#2A2A2A"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="12"
                                                        Margin="0,10,0,0">
                                                    <StackPanel>
                                                        <TextBlock x:Name="SpotifyCanvasAccountLabel"
                                                                   Text="Spotify account"
                                                                   Style="{StaticResource SettingTitleText}"/>
                                                        <TextBlock x:Name="SpotifyCanvasAccountHint"
                                                                   Text="Sign in once. The Spotify session is encrypted with Windows DPAPI."
                                                                   Style="{StaticResource SettingHintText}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,10"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="SpotifyCanvasAccountStatus"
                                                                       Text="Not connected — the normal lyrics background will be used."
                                                                       FontSize="11"
                                                                       Foreground="#EAB308"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,10,0"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <Button x:Name="SpotifyConnectButton"
                                                                        Content="Connect Spotify"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        Height="36"
                                                                        Padding="16,8"
                                                                        Click="SpotifyConnectButton_Click"/>
                                                                <Button x:Name="SpotifyDisconnectButton"
                                                                        Content="Disconnect"
                                                                        Height="36"
                                                                        Padding="14,8"
                                                                        Margin="8,0,0,0"
                                                                        Visibility="Collapsed"
                                                                        Click="SpotifyDisconnectButton_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <controls:ElasticSlider x:Name="SpotifyCanvasBrightnessSlider"
                                                        Label="Canvas brightness"
                                                        Unit="%"
                                                        Description="Adjust the Canvas brightness so lyrics remain easy to read."
                                                        Minimum="20"
                                                        Maximum="100"
                                                        Value="70"
                                                        TickFrequency="5"
                                                        IsSnapToTickEnabled="True"
                                                        ValueChanged="SpotifyCanvasBrightnessSlider_ValueChanged"
                                                        Margin="0,12,0,0"/>

                                                 <TextBlock x:Name="DarkOverlayLabel" Text="Lyrics Dark Overlay" Style="{StaticResource SettingTitleText}" Visibility="Collapsed" Margin="0,12,0,0"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Visibility="Collapsed">
                                                    <Run x:Name="BlurDarkOverlayValue" Text="30"/><Run Text=" %"/>
                                                </TextBlock>
                                                <TextBlock x:Name="DarkOverlayHint" Visibility="Collapsed"/>
                                                <controls:ElasticSlider x:Name="BlurDarkOverlaySlider"
                                                        Label="Dark Overlay" Unit="%"
                                                        Description="Add a dark layer over the lyrics background image to improve text readability."
                                                        Minimum="0"
                                                        Maximum="80"
                                                        Value="30"
                                                        TickFrequency="5"
                                                        IsSnapToTickEnabled="True"
                                                        ValueChanged="BlurDarkOverlaySlider_ValueChanged"
                                                        Margin="0,12,0,0"/>

                                                <CheckBox x:Name="BrightenDarkLyricsBackgroundCheck"
                                                          Content="Brighten dark lyrics backgrounds"
                                                          Checked="BrightenDarkLyricsBackgroundCheck_Changed"
                                                          Unchecked="BrightenDarkLyricsBackgroundCheck_Changed"
                                                          Margin="0,14,0,0"/>

                                                <CheckBox x:Name="EnableYouTubeSubtitlesCheck"
                                                          x:Uid="enableYouTubeSubtitles"
                                                          Checked="EnableYouTubeSubtitlesCheck_Changed"
                                                          Unchecked="EnableYouTubeSubtitlesCheck_Changed"
                                                          Margin="0,14,0,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock x:Name="EnableYouTubeSubtitlesLabel" Style="{StaticResource SettingTitleText}" TextWrapping="Wrap" Text="Show YouTube subtitles" VerticalAlignment="Center"/>
                                                        <Border Background="#C8C8C8" CornerRadius="4" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock x:Name="YouTubeSubtitlesExperimentalBadge" Text="EXPERIMENTAL" FontSize="11" FontWeight="Bold"
                                                                       Foreground="#1A1A1A" FontFamily="{StaticResource SFProDisplay}"/>
                                                        </Border>
                                                    </WrapPanel>
                                                </CheckBox>
                                                <TextBlock x:Name="EnableYouTubeSubtitlesHint"
                                                           Text="Only use captions you are entitled to access under YouTube's terms and applicable law. Fair use is assessed case by case; this notice grants no permission for automated collection."
                                                           TextWrapping="Wrap"
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>

                                                <CheckBox x:Name="IgnoreYouTubeAutoSubtitlesCheck"
                                                          x:Uid="ignoreYouTubeAutoSubtitles"
                                                          Checked="IgnoreYouTubeAutoSubtitlesCheck_Changed"
                                                          Unchecked="IgnoreYouTubeAutoSubtitlesCheck_Changed"
                                                          Margin="0,12,0,0">
                                                    <TextBlock x:Name="IgnoreYouTubeAutoSubtitlesLabel" Style="{StaticResource SettingTitleText}" TextWrapping="Wrap" Text="Ignore auto-generated subtitles" VerticalAlignment="Center"/>
                                                </CheckBox>
                                                <TextBlock x:Name="IgnoreYouTubeAutoSubtitlesHint"
                                                           Text="Only display manually uploaded captions and skip automatic speech recognition subtitles."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="SubtitlePriorityRow" Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="SubtitlePriorityLabel" Text="Subtitle Language" Style="{StaticResource SettingTitleText}"/>
                                                </StackPanel>
                                                <TextBlock x:Name="SubtitlePriorityHint"
                                                           Text="Drag to reorder priority. Subtitles are selected using the first available match."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,8"/>
                                                <ItemsControl x:Name="SubtitlePriorityItems"
                                                              Background="Transparent"
                                                              AllowDrop="True"
                                                              Drop="SubtitlePriority_Drop"
                                                              DragOver="SubtitlePriority_DragOver">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1A1A1A" CornerRadius="8" Padding="12,10" Margin="0,2"
                                                                    Cursor="Hand"
                                                                    MouseMove="SubtitlePriorityItem_MouseMove"
                                                                    MouseLeftButtonDown="SubtitlePriorityItem_MouseLeftButtonDown"
                                                                    GiveFeedback="SubtitlePriorityItem_GiveFeedback">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="20"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="≡" FontSize="14" Foreground="#555"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                                               FontSize="13" Foreground="{StaticResource SettingsTextBrush}"
                                                                               FontFamily="{StaticResource SFProDisplay}"
                                                                               FontWeight="Bold"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <CheckBox x:Name="YouTubeApiCheck" x:Uid="youtubeApi" Content="Use YouTube Data API"
                                                          Checked="YouTubeApiCheck_Changed" Unchecked="YouTubeApiCheck_Changed"/>
                                                <TextBlock x:Name="YouTubeApiHint" Text="Improve thumbnail accuracy with your own YouTube API key."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="YouTubeApiKeyRow" Style="{StaticResource SettingRowBorder}" Margin="0,0,0,4" Visibility="Collapsed">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="YouTubeApiKeyRowTranslate" Y="0"/>
                                            </Border.RenderTransform>
                                            <StackPanel>
                                                <TextBlock x:Name="YouTubeApiKeyLabel" Text="API Key" Style="{StaticResource SettingTitleText}"/>
                                                <TextBlock x:Name="YouTubeApiKeyHint" Text="Paste your YouTube Data API v3 key from Google Cloud Console."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,8"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <PasswordBox x:Name="YouTubeApiKeyPasswordBox"
                                                             Height="40"
                                                             Padding="12,10"
                                                             FontSize="12"
                                                             FontFamily="{StaticResource SettingsFont}"
                                                             Background="#0F0F0F"
                                                             Foreground="{StaticResource SettingsTextBrush}"
                                                             BorderBrush="#2A2A2A"
                                                             BorderThickness="1"
                                                             CaretBrush="#C8C8C8"
                                                             VerticalContentAlignment="Center"
                                                             PasswordChar="●"
                                                             PasswordChanged="YouTubeApiKeyPasswordBox_PasswordChanged">
                                                        <PasswordBox.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="10"/>
                                                            </Style>
                                                        </PasswordBox.Resources>
                                                    </PasswordBox>
                                                    <TextBox x:Name="YouTubeApiKeyTextBox"
                                                             Height="40"
                                                             Padding="12,10"
                                                             FontSize="12"
                                                             FontFamily="{StaticResource SettingsFont}"
                                                             Background="#0F0F0F"
                                                             Foreground="{StaticResource SettingsTextBrush}"
                                                             BorderBrush="#2A2A2A"
                                                             BorderThickness="1"
                                                             CaretBrush="#C8C8C8"
                                                             VerticalContentAlignment="Center"
                                                             Visibility="Collapsed"
                                                             TextChanged="YouTubeApiKeyTextBox_TextChanged">
                                                        <TextBox.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="10"/>
                                                            </Style>
                                                        </TextBox.Resources>
                                                    </TextBox>
                                                    <Button x:Name="ToggleKeyVisibilityButton"
                                                            Grid.Column="1"
                                                            Width="36" Height="36"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Click="ToggleKeyVisibility_Click"
                                                            ToolTip="Show/Hide key">
                                                        <Grid Width="20" Height="20">
                                                            <Canvas x:Name="EyeOpenIcon" Width="20" Height="20" Opacity="1">
                                                                <Path Fill="#CCCCCC" Data="M10 4C5.6 4 1.9 6.7 0.2 10.5C0.1 10.8 0.1 11.2 0.2 11.5C1.9 15.3 5.6 18 10 18C14.4 18 18.1 15.3 19.8 11.5C19.9 11.2 19.9 10.8 19.8 10.5C18.1 6.7 14.4 4 10 4ZM10 15.5C7.5 15.5 5.5 13.5 5.5 11C5.5 8.5 7.5 6.5 10 6.5C12.5 6.5 14.5 8.5 14.5 11C14.5 13.5 12.5 15.5 10 15.5ZM10 8.5C8.6 8.5 7.5 9.6 7.5 11C7.5 12.4 8.6 13.5 10 13.5C11.4 13.5 12.5 12.4 12.5 11C12.5 9.6 11.4 8.5 10 8.5Z"/>
                                                            </Canvas>
                                                            <Canvas x:Name="EyeClosedIcon" Width="20" Height="20" Opacity="0">
                                                                <Path Data="M2.5 2.5L17.5 17.5M8.1 8.2C7.7 8.6 7.5 9.3 7.5 10C7.5 11.4 8.6 12.5 10 12.5C10.7 12.5 11.4 12.3 11.8 11.8M14.1 14.2C12.9 15.1 11.5 15.5 10 15.5C5.6 15.5 1.9 12.8 0.2 9C0.9 7.5 1.9 6.2 3.2 5.2M7.5 4.5C8.3 4.2 9.1 4 10 4C14.4 4 18.1 6.7 19.8 10.5C19.4 11.4 18.9 12.2 18.3 12.9" Stroke="#CCCCCC" StrokeThickness="1.5" Fill="Transparent"/>
                                                            </Canvas>
                                                        </Grid>
                                                    </Button>
                                                </Grid>
                                                <TextBlock x:Name="YouTubeApiKeyStatus"
                                                           Text=""
                                                           FontSize="11"
                                                           Foreground="#6B7280"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                         </Border>

                                        <Border Style="{StaticResource SettingRowBorder}" Margin="0,0,0,4">
                                            <StackPanel>
                                                <CheckBox x:Name="EnableDebugModeCheck"
                                                          Content="Enable Debug Mode"
                                                          Checked="EnableDebugModeCheck_Changed"
                                                          Unchecked="EnableDebugModeCheck_Changed"/>
                                                <TextBlock x:Name="EnableDebugModeHint"
                                                           Text="Display FPS, CPU, and RAM usage on a floating draggable performance HUD window."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="PanelPerformance" Visibility="Collapsed">
                                <Border x:Name="PerformanceCard" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,6" Opacity="0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="PerformanceCardTranslate" Y="12"/>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock x:Name="PerformanceHeader" Text="PERFORMANCE" Style="{StaticResource SectionHeader}" Visibility="Collapsed"/>

                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <TextBlock x:Name="AnimationFpsLabel" Text="Animation FPS" Style="{StaticResource SettingTitleText}" Visibility="Collapsed"/>
                                                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Visibility="Collapsed">
                                                    <Run x:Name="AnimationFpsValue" Text="120"/><Run Text=" FPS"/>
                                                </TextBlock>
                                                <TextBlock x:Name="AnimationFpsHint" Visibility="Collapsed"/>
                                                <CheckBox x:Name="AutoAnimationFpsCheck"
                                                          Content="Auto FPS — match monitor refresh rate"
                                                          Margin="0,0,0,8"
                                                          Checked="AutoAnimationFps_Changed"
                                                          Unchecked="AutoAnimationFps_Changed"/>
                                                <controls:ElasticSlider x:Name="AnimationFpsSlider"
                                                        Label="Animation FPS" Unit=" FPS"
                                                        Description="Cap UI animation frame rate. Lower values reduce render/GPU load."
                                                        Minimum="30"
                                                        Maximum="550"
                                                        Value="240"
                                                        TickFrequency="5"
                                                        IsSnapToTickEnabled="False"
                                                        ValueChanged="AnimationFpsSlider_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}" Margin="0,4,0,4">
                                            <StackPanel>
                                                <CheckBox x:Name="EnableBlurEffectsCheck"
                                                          Content="Enable blur effects"
                                                          Checked="PerformanceSetting_Changed"
                                                          Unchecked="PerformanceSetting_Changed"/>
                                                <TextBlock x:Name="EnableBlurEffectsHint"
                                                           Text="Use media background blur, content transition blur, and other visual blur effects."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRowBorder}" Margin="0,0,0,4" BorderThickness="0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="GpuPreferenceLabel" Text="GPU Render App" Style="{StaticResource SettingTitleText}"/>
                                                    <Border Background="#26FF9F0A"
                                                            BorderBrush="#55FF9F0A"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="6,2"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock x:Name="GpuPreferenceRestartBadge"
                                                                   Text="RESTART REQUIRED"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#FF9F0A"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="GpuPreferenceHint" Text="Select which GPU Windows should use to render V-Notch."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,4"/>
                                                <TextBlock x:Name="GpuPreferenceRestartNote"
                                                           Text="Requires restarting the app to take effect."
                                                           FontSize="11.5"
                                                           FontWeight="Bold"
                                                           Foreground="#FF9F0A"
                                                           Margin="0,0,0,8"/>
                                                <ComboBox x:Name="GpuPreferenceCombo" Width="200" HorizontalAlignment="Left" SelectionChanged="GpuPreferenceCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Let Windows Decide" Tag="0"/>
                                                    <ComboBoxItem Content="Power Saving (iGPU)" Tag="1"/>
                                                    <ComboBoxItem Content="High Performance (dGPU)" Tag="2"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingRowBorder}">
                                            <StackPanel>
                                                <TextBlock x:Name="ProcessPriorityLabel" Text="Process Priority" Style="{StaticResource SettingTitleText}"/>
                                                <TextBlock x:Name="ProcessPriorityHint" Text="Adjust the priority of V-Notch in Windows to ensure smooth animations under heavy system load."
                                                           Style="{StaticResource SettingHintText}"
                                                           Margin="0,4,0,8"/>
                                                <ComboBox x:Name="ProcessPriorityCombo" Width="200" HorizontalAlignment="Left" SelectionChanged="ProcessPriorityCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Normal (Default)" Tag="Normal"/>
                                                    <ComboBoxItem Content="High" Tag="High"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="PanelDonating" Visibility="Collapsed">
                                <Border x:Name="DonatingCard" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,6" Opacity="0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="DonatingCardTranslate" Y="12"/>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <TextBlock x:Name="DonatingHeader" Text="DONATING" Style="{StaticResource SectionHeader}" Visibility="Collapsed"/>

                                        <!-- Star on GitHub Section (No outer border box, placed at top) -->
                                        <Grid Margin="4,2,4,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Animated Golden Star Container -->
                                            <Grid Grid.Column="0"
                                                  Width="44"
                                                  Height="44"
                                                  Margin="0,0,18,0"
                                                  VerticalAlignment="Center">
                                                <!-- Soft background aura glow -->
                                                <Path Data="M 12,2 L 15.09,8.26 L 22,9.27 L 17,14.14 L 18.18,21.02 L 12,17.77 L 5.82,21.02 L 7,14.14 L 2,9.27 L 8.91,8.26 Z"
                                                      Stretch="Uniform"
                                                      Fill="#44FFB800">
                                                    <Path.Effect>
                                                        <BlurEffect Radius="16"/>
                                                    </Path.Effect>
                                                </Path>

                                                <!-- Main animated Star -->
                                                <Path x:Name="AnimatedStarPath"
                                                      Data="M 12,2 L 15.09,8.26 L 22,9.27 L 17,14.14 L 18.18,21.02 L 12,17.77 L 5.82,21.02 L 7,14.14 L 2,9.27 L 8.91,8.26 Z"
                                                      Stretch="Uniform"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.Fill>
                                                        <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                                                            <GradientStop Color="#FFFBEA" Offset="0.0"/>
                                                            <GradientStop Color="#FFD54F" Offset="0.3"/>
                                                            <GradientStop Color="#FFB800" Offset="0.7"/>
                                                            <GradientStop Color="#FF8F00" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Path.Fill>
                                                    <Path.Effect>
                                                        <DropShadowEffect x:Name="StarShadowEffect"
                                                                          Color="#FFB800"
                                                                          BlurRadius="12"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.8"/>
                                                    </Path.Effect>
                                                    <Path.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform x:Name="StarScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                                            <RotateTransform x:Name="StarRotateTransform" Angle="0"/>
                                                        </TransformGroup>
                                                    </Path.RenderTransform>
                                                    <Path.Triggers>
                                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetName="StarScaleTransform"
                                                                                     Storyboard.TargetProperty="ScaleX"
                                                                                     From="0.92" To="1.14"
                                                                                     Duration="0:0:1.6"
                                                                                     AutoReverse="True">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <SineEase EasingMode="EaseInOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="StarScaleTransform"
                                                                                     Storyboard.TargetProperty="ScaleY"
                                                                                     From="0.92" To="1.14"
                                                                                     Duration="0:0:1.6"
                                                                                     AutoReverse="True">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <SineEase EasingMode="EaseInOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="StarRotateTransform"
                                                                                     Storyboard.TargetProperty="Angle"
                                                                                     From="-8" To="8"
                                                                                     Duration="0:0:2.4"
                                                                                     AutoReverse="True">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <SineEase EasingMode="EaseInOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="StarShadowEffect"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     From="0.4" To="0.95"
                                                                                     Duration="0:0:1.6"
                                                                                     AutoReverse="True">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <SineEase EasingMode="EaseInOut"/>
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Path.Triggers>
                                                </Path>
                                            </Grid>

                                            <!-- Texts -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                                <TextBlock x:Name="StarRepoTitle"
                                                           Text="Star on GitHub"
                                                           Style="{StaticResource SettingTitleText}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock x:Name="StarRepoDescription"
                                                           Text="Giving a star on GitHub is completely free, but it is a huge motivation for w0otdev to keep maintaining and developing this project."
                                                           Style="{StaticResource SettingHintText}"
                                                           LineHeight="17"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Star Action Button -->
                                            <Button x:Name="StarRepoButton"
                                                    Grid.Column="2"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Click="StarRepoButton_Click"
                                                    VerticalAlignment="Center"
                                                    Height="40"
                                                    Padding="18,0"
                                                    Cursor="Hand">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="M 12,2 L 15.09,8.26 L 22,9.27 L 17,14.14 L 18.18,21.02 L 12,17.77 L 5.82,21.02 L 7,14.14 L 2,9.27 L 8.91,8.26 Z"
                                                          Fill="#FFA000"
                                                          Width="14" Height="14"
                                                          Stretch="Uniform"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="StarRepoButtonText"
                                                               Text="Star on GitHub"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               Foreground="#11161D"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Divider between Star section and Donation/QR section -->
                                        <Border Height="1" Background="#14FFFFFF" Margin="0,0,0,16"/>

                                        <!-- Domestic QR + PayPal Support Section -->
                                        <Border Style="{StaticResource SettingRowBorder}" Margin="0" Padding="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="196"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,22,0">
                                                    <TextBlock x:Name="DonatingTitle"
                                                               Text="Thank you for supporting V-Notch"
                                                               Style="{StaticResource SettingTitleText}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock x:Name="DonatingDescription"
                                                               Text="V-Notch is 100% non-profit. Donations help cover the costs that let me stay focused and keep maintaining this product."
                                                               Style="{StaticResource SettingHintText}"
                                                               LineHeight="18"
                                                               Margin="0,4,0,0"/>

                                                    <Button x:Name="DonatePaypalButton"
                                                            Content="Support via PayPal"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Click="DonatePaypal_Click"
                                                            HorizontalAlignment="Left"
                                                            MinWidth="174"
                                                            Height="40"
                                                            Margin="0,16,0,0"/>

                                                    <TextBlock x:Name="DonatePaypalLinkText"
                                                               Text="https://www.paypal.com/paypalme/PhuocLe678"
                                                               Style="{StaticResource SettingHintText}"
