                                              Stroke="#FF9F0A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        <Path Data="M3 4.49988H7V8.49988"
                                              Stroke="#FF9F0A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock x:Name="RestartPromptTitle" Text="Restart required" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource SettingsTextBrush}"/>
                                    <TextBlock x:Name="RestartPromptMessage" Text="Some settings require restarting V-Notch to take full effect. Restart now?"
                                               FontSize="11.5" FontWeight="Bold" Foreground="#D0A8B3C3" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="RestartLaterButton" Content="Later" Height="34" MinWidth="68" Margin="0,0,8,0"
                                            Click="RestartLater_Click"/>
                                    <Button x:Name="RestartNowButton" Content="Restart Now" Height="34" MinWidth="110"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="RestartNow_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border x:Name="FooterBar"
                    Grid.Row="2"
                    Background="Transparent"
                    BorderBrush="#10FFFFFF"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,24,24"
                    Padding="22,14,20,16"
                    Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="FooterTranslate" Y="10"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ResetButton" Grid.Column="0" HorizontalAlignment="Left"
                            Height="36" MinWidth="80" Padding="12,0" Background="Transparent" BorderThickness="0" Foreground="#AAAAAA"
                            Margin="0,0,8,0"
                            Content="Reset"
                            Click="Reset_Click"/>
                    <Button x:Name="ApplyButton" Grid.Column="1" Height="36" MinWidth="96"
                            Margin="4,0"
                            Content="Apply"
                            Click="Apply_Click"/>
                    <Button x:Name="SaveButton" Grid.Column="2" Height="36" MinWidth="96"
                            Background="#DCDCDC" BorderBrush="#DCDCDC"
                            Margin="8,0,0,0"
                            Content="Save"
                            Style="{StaticResource PrimaryButton}"
                            Click="Save_Click"/>

                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
