<Window xmlns:fonts="clr-namespace:VNotch.Services"
        x:Class="VNotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:controls="clr-namespace:VNotch.Controls"
        Title="V-Notch Settings"
        Width="880"
        Height="710"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        FocusManager.FocusedElement="{Binding ElementName=MainShell}"
        FontFamily="{fonts:AppFont Fallbacks='Nirmala UI, Segoe UI'}"
        UseLayoutRounding="False"
        SnapsToDevicePixels="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        TextOptions.TextHintingMode="Animated">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/V-Notch;component/Controls/SettingsComboBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DisabledFeatureGroup" TargetType="StackPanel">
                <Setter Property="Opacity" Value="1"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
                            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Opacity" Value="0.45"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        <fonts:AppFont x:Key="SettingsFont" Fallbacks="Nirmala UI, Segoe UI" />
        <sys:Double x:Key="SettingsLabelFontSize">14</sys:Double>
        <sys:Double x:Key="SettingsHintFontSize">12</sys:Double>
        <SolidColorBrush x:Key="PanelBg" Color="#F4020202"/>
        <SolidColorBrush x:Key="CardBg" Color="#F0080808"/>
        <SolidColorBrush x:Key="CardBorder" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="SettingsTextBrush" Color="#C8C8C8"/>
        <SolidColorBrush x:Key="MutedText" Color="#8C959E"/>
        <SolidColorBrush x:Key="SoftText" Color="#D8DEE5"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="AccentBrushStrong" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TrackBg" Color="#262626"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#141414"/>
        <SolidColorBrush x:Key="SurfaceBrushHover" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="NavItemBg" Color="Transparent"/>
        <SolidColorBrush x:Key="NavItemActiveBg" Color="#24FFFFFF"/>
        <CubicEase x:Key="InteractiveEaseOut" EasingMode="EaseOut"/>

        <LinearGradientBrush x:Key="WindowGlow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#090909" Offset="0"/>
            <GradientStop Color="#030303" Offset="0.55"/>
            <GradientStop Color="#000000" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource SettingsLabelFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource SettingsFont}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Animated"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#8E96A0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="TextAlignment" Value="Left"/>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18,4,18,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <TranslateTransform Y="0"/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#24FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingTitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource SettingsLabelFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SettingHintText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedText}"/>
            <Setter Property="FontSize" Value="{StaticResource SettingsHintFontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LineHeight" Value="17"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource SettingsLabelFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SliderLabelGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="SettingRowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="Margin" Value="-8,0,-8,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0CFFFFFF"/>
                    <Setter Property="BorderBrush" Value="#16FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButton" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource SettingsLabelFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource SettingsFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0,0,12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="Loaded" Handler="SettingsSwitch_Loaded"/>
            <EventSetter Event="Checked" Handler="SettingsSwitch_StateChanged"/>
            <EventSetter Event="Unchecked" Handler="SettingsSwitch_StateChanged"/>
            <EventSetter Event="Indeterminate" Handler="SettingsSwitch_StateChanged"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SettingsSwitch_PreviewMouseDown"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="SettingsSwitch_PreviewMouseUp"/>
            <EventSetter Event="MouseLeave" Handler="SettingsSwitch_MouseLeave"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid MinHeight="36" Background="Transparent" SnapsToDevicePixels="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="SwitchContent"
                                              Grid.Column="0"
                                              TextBlock.LineHeight="22"
                                              TextBlock.LineStackingStrategy="BlockLineHeight"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <Grid x:Name="SwitchVisual" Grid.Column="1" Width="54" Height="28"
                                  VerticalAlignment="Center" HorizontalAlignment="Right"
                                  IsHitTestVisible="False">
                                <Border x:Name="SwitchTrack" CornerRadius="14" Background="#28FFFFFF" BorderBrush="#36FFFFFF" BorderThickness="1"/>
                                <Border x:Name="SwitchOnTrack" CornerRadius="14" Background="#34C759" BorderBrush="#5CFFFFFF" BorderThickness="1" Opacity="0"/>
                                <Border x:Name="SwitchThumb" Width="22" Height="22" CornerRadius="11"
                                        Background="Transparent" Margin="3,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                    <Border x:Name="SwitchThumbCap" Background="#FFFFFF" CornerRadius="11"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="5" ShadowDepth="1"
                                                              Opacity="0.28" Color="Black" Direction="270"/>
                                        </Border.Effect>
                                    </Border>
                                </Border>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#36FFFFFF"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#58FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#88FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="controls:ElasticSlider">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="62"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:ElasticSlider">
                        <StackPanel>
                            <TextBlock x:Name="PART_Label"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="2,0,0,0"
                                       LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                       FontSize="{StaticResource SettingsLabelFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SettingsTextBrush}"
                                       FontFamily="{StaticResource SettingsFont}"
                                       IsHitTestVisible="False"/>
                            <TextBlock x:Name="PART_Description"
                                       Margin="2,4,0,7"
                                       Style="{StaticResource SettingHintText}"
                                       Foreground="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       FontFamily="{StaticResource SettingsFont}"
                                       IsHitTestVisible="False"/>
                            <Border x:Name="PART_Root"
                                    Height="40"
                                    CornerRadius="11"
                                    Background="#1AFFFFFF"
                                    BorderBrush="#2AFFFFFF"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="False"
                                    ClipToBounds="True">
                                <Grid>
                                    <Border x:Name="PART_Fill"
                                            HorizontalAlignment="Left"
                                            CornerRadius="10"
                                            Background="#30FFFFFF"
                                            Width="0"/>
                                    <Canvas x:Name="PART_Ticks"
                                            IsHitTestVisible="False"/>
                                    <Canvas IsHitTestVisible="False">
                                        <Rectangle x:Name="PART_Indicator"
                                                   Width="3.5"
                                                   Height="20"
                                                   RadiusX="1.75"
                                                   RadiusY="1.75"
                                                   Fill="#FFFFFF"
                                                   Canvas.Top="9"
                                                   Canvas.Left="0">
                                            <Rectangle.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                                                  Opacity="0.55" Color="White"/>
                                            </Rectangle.Effect>
                                        </Rectangle>
                                    </Canvas>
                                    <TextBlock x:Name="PART_Value"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,12,0"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#F2F6FA"
                                               FontFamily="{StaticResource SFProDisplay}"
                                               IsHitTestVisible="False"/>
                                    <Track x:Name="PART_Track" Visibility="Hidden"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Root" Property="Background" Value="#22FFFFFF"/>
                                <Setter TargetName="PART_Root" Property="BorderBrush" Value="#4CFFFFFF"/>
                                <Setter TargetName="PART_Fill" Property="Background" Value="#3EFFFFFF"/>
                                <Setter TargetName="PART_Label" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PART_Root" Property="BorderBrush" Value="#7CFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}"/>
            <Setter Property="BorderBrush" Value="#34FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource SettingsFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#24FFFFFF"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5CFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             To="1.016" Duration="0:0:0.14"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             To="1.016" Duration="0:0:0.14"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.16"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.16"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#18FFFFFF"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#78FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             To="0.974" Duration="0:0:0.08"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             To="0.974" Duration="0:0:0.08"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F3F6FA"/>
            <Setter Property="Foreground" Value="#11161D"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             To="1.018" Duration="0:0:0.14"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             To="1.018" Duration="0:0:0.14"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.16"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.16"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCE4EE"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             To="0.974" Duration="0:0:0.08"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             To="0.974" Duration="0:0:0.08"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.15"
                                                             EasingFunction="{StaticResource InteractiveEaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="MainShell"
            Margin="18"
            CornerRadius="24"
            Background="{StaticResource WindowGlow}"
            BorderBrush="#18FFFFFF"
            BorderThickness="1"
            SnapsToDevicePixels="False"
            UseLayoutRounding="False"
            Opacity="0"
            Focusable="True"
            PreviewMouseLeftButtonDown="WindowSurface_PreviewMouseLeftButtonDown"
            RenderTransformOrigin="0.5,0.0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ShellScale" ScaleX="0.985" ScaleY="0.985"/>
                <TranslateTransform x:Name="ShellTranslate" Y="8"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid x:Name="ShellContent"
              SnapsToDevicePixels="False"
              UseLayoutRounding="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Liquid Glass Layers -->
            <Border x:Name="GlassBackdropHost"
                    Grid.RowSpan="3"
                    IsHitTestVisible="False"
                    ClipToBounds="True"
                    Visibility="Collapsed"
                    CornerRadius="24">
                <Image x:Name="GlassBackdropImage"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Stretch="Fill"
                       Margin="0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <Border x:Name="GlassGrainOverlay"
                    Grid.RowSpan="3"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
                    Opacity="0"
                    CornerRadius="24"/>

            <Border x:Name="GlassTintOverlay"
                    Grid.RowSpan="3"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
                    CornerRadius="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" po:Freeze="True" xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
                        <GradientStop Color="#0CFFFFFF" Offset="0"/>
                        <GradientStop Color="#06FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#160A0E14" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border x:Name="GlassDarkOverlay"
                    Grid.RowSpan="3"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
