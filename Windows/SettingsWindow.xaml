                        </Button>
                        <Button x:Name="SocialDiscord" Width="34" Height="34" MinWidth="0" Padding="0"
                                BorderThickness="0" Background="Transparent"
                                Cursor="Hand" Click="SocialLink_Discord_Click"
                                ToolTip="Discord" Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <TranslateTransform x:Name="SocialDiscordTranslate" Y="6"/>
                            </Button.RenderTransform>
