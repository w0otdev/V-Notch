      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'DirectML.dll' Or '%(Filename)%(Extension)' == 'onnxruntime.dll'" ExcludeFromSingleFile="true" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'DirectML.pdb' Or '%(Filename)%(Extension)' == 'DirectML.Debug.dll' Or '%(Filename)%(Extension)' == 'DirectML.Debug.pdb' Or '%(Filename)%(Extension)' == 'onnxruntime_providers_shared.dll' Or '%(Filename)%(Extension)' == 'Microsoft.Web.WebView2.WinForms.dll' Or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.ML.OnnxRuntime', System.StringComparison.OrdinalIgnoreCase))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'mtmd.dll' Or '%(Extension)' == '.lib' Or '%(RelativePath)' == 'runtimes\win-x64\native\WebView2Loader.dll' Or $([System.String]::Copy('%(RelativePath)').StartsWith('runtimes\win-x64\native\avx\')) Or $([System.String]::Copy('%(RelativePath)').StartsWith('runtimes\win-x64\native\avx512\'))" />
