  <UsingTask TaskName="MinifyLocaleJsonTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <LocaleFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <MinifiedFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.IO;
using System.Text;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public sealed class MinifyLocaleJsonTask : Task
{
    [Required] public ITaskItem[] LocaleFiles { get; set; }
    [Required] public string OutputDirectory { get; set; }
    [Output] public ITaskItem[] MinifiedFiles { get; set; }

    public override bool Execute()
    {
        Directory.CreateDirectory(OutputDirectory);
        var utf8NoBom = new UTF8Encoding(false);
        var results = new List<ITaskItem>(LocaleFiles.Length);

        foreach (var item in LocaleFiles)
        {
            string srcPath = item.GetMetadata("FullPath");
            string fileName = Path.GetFileName(srcPath);
            string src = File.ReadAllText(srcPath, Encoding.UTF8);
            var sb = new StringBuilder(src.Length);
            bool inStr = false;
            for (int i = 0; i < src.Length; i++)
            {
                char c = src[i];
                if (inStr)
                {
                    sb.Append(c);
                    if (c == '\\' && i + 1 < src.Length) sb.Append(src[++i]);
                    else if (c == '"') inStr = false;
                }
                else
                {
                    if (c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == '\uFEFF') continue;
                    sb.Append(c);
                    if (c == '"') inStr = true;
                }
            }

            string minified = sb.ToString();
            string destPath = Path.Combine(OutputDirectory, fileName);
            if (!File.Exists(destPath) || !string.Equals(File.ReadAllText(destPath, Encoding.UTF8), minified, StringComparison.Ordinal))
            {
                File.WriteAllText(destPath, minified, utf8NoBom);
            }

            var outItem = new TaskItem(destPath);
            outItem.SetMetadata("LogicalName", "VNotch.Locales." + fileName);
            results.Add(outItem);
        }

        MinifiedFiles = results.ToArray();
        return true;
    }
}
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="MinifyLocalesForEmbed" BeforeTargets="AssignTargetPaths;PrepareResourceNames;PrepareResources" Condition="'$(DesignTimeBuild)' != 'true' And !$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <ItemGroup>
      <_RawAppLocales Include="$(MSBuildThisFileDirectory)Locales\*.json" />
    </ItemGroup>
    <MinifyLocaleJsonTask LocaleFiles="@(_RawAppLocales)" OutputDirectory="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'Locales-min'))">
      <Output TaskParameter="MinifiedFiles" ItemName="_MinifiedAppLocales" />
    </MinifyLocaleJsonTask>
    <ItemGroup>
      <EmbeddedResource Include="@(_MinifiedAppLocales)" />
    </ItemGroup>
  </Target>

