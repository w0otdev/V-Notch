<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <!-- Audit snapshots are not application source, XAML pages, or resources. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**\*;.cache\**\*;Tests\**\*;Tools\**\*;Uninstall\**\*</DefaultItemExcludes>

    <CETCompat>true</CETCompat>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>V-Notch</AssemblyName>
    <RootNamespace>VNotch</RootNamespace>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <PublishReadyToRun>false</PublishReadyToRun>

    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugType Condition="'$(Configuration)' != 'Release'">portable</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugSymbols Condition="'$(Configuration)' != 'Release'">true</DebugSymbols>
    <Microsoft_AI_DirectML_SkipDebugLayerCopy>true</Microsoft_AI_DirectML_SkipDebugLayerCopy>
    <!-- Native libraries are already deployed beside the app. Avoid extracting
         another per-version copy, and share runtime DLLs with the uninstaller. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Reduce the installed single-file executable without trimming WPF,
         reflection, COM interop or CPU/GPU translation backends. -->
    <EnableCompressionInSingleFile Condition="'$(Configuration)' == 'Release' And '$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <Version>2.3.2</Version>
    <AssemblyVersion>2.3.2</AssemblyVersion>
    <FileVersion>2.3.2</FileVersion>
    <Authors>w0otdev, viper1aa</Authors>
    <Company>V-Notch</Company>
    <Product>V-Notch</Product>
    <Copyright>Copyright © 2026 w0otdev &amp; viper1aa</Copyright>
    <PackageId>V-Notch</PackageId>
    <PackageProjectUrl>https://github.com/w0otdev/V-Notch</PackageProjectUrl>
    <RepositoryUrl>https://github.com/w0otdev/V-Notch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>A desktop status and media companion for Windows</Description>
    <ApplicationIcon>Services\icons\logo.ico</ApplicationIcon>

    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="LanguageDetection.Ai" Version="1.1.0" />
