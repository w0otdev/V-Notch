  <Target Name="CompileVNotchNative" BeforeTargets="BeforeBuild" Condition="'$(SkipNativeCompile)' != 'true' And '$(DesignTimeBuild)' != 'true' And !$(MSBuildProjectName.EndsWith('_wpftmp'))" Inputs="@(_VNotchNativeSources);@(_VNotchNativeHeaders);@(_VNotchGpuShaderInputs);$(MSBuildThisFileFullPath)" Outputs="$(_VNotchNativeDll)">
    <PropertyGroup Condition="'$(VcVars64Path)' == ''">
      <_VcVarsCacheFile>$(_VNotchNativeObjDir)\vcvars64.cache</_VcVarsCacheFile>
      <VcVars64Path Condition="Exists('$(_VcVarsCacheFile)')">$([System.IO.File]::ReadAllText('$(_VcVarsCacheFile)').Trim())</VcVars64Path>
    </PropertyGroup>
    <PropertyGroup Condition="'$(VcVars64Path)' == '' Or !Exists('$(VcVars64Path)')">
      <_VcVarsFallback1>C:\Program Files\Microsoft Visual Studio\2022\Enterprise\VC\Auxiliary\Build\vcvars64.bat</_VcVarsFallback1>
      <_VcVarsFallback2>C:\Program Files\Microsoft Visual Studio\2022\Professional\VC\Auxiliary\Build\vcvars64.bat</_VcVarsFallback2>
      <_VcVarsFallback3>C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Auxiliary\Build\vcvars64.bat</_VcVarsFallback3>
      <_VcVarsFallback4>C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Auxiliary\Build\vcvars64.bat</_VcVarsFallback4>
      <VcVars64Path Condition="Exists('$(_VcVarsFallback1)')">$(_VcVarsFallback1)</VcVars64Path>
      <VcVars64Path Condition="'$(VcVars64Path)' == '' And Exists('$(_VcVarsFallback2)')">$(_VcVarsFallback2)</VcVars64Path>
      <VcVars64Path Condition="'$(VcVars64Path)' == '' And Exists('$(_VcVarsFallback3)')">$(_VcVarsFallback3)</VcVars64Path>
      <VcVars64Path Condition="'$(VcVars64Path)' == '' And Exists('$(_VcVarsFallback4)')">$(_VcVarsFallback4)</VcVars64Path>
      <_VsWherePath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</_VsWherePath>
    </PropertyGroup>
    <Exec Condition="('$(VcVars64Path)' == '' Or !Exists('$(VcVars64Path)')) And Exists('$(_VsWherePath)')" Command="&quot;$(_VsWherePath)&quot; -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -find **\vcvars64.bat" ConsoleToMSBuild="true" EchoOff="true" StandardOutputImportance="Low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_VcVarsFromVsWhere" />
    </Exec>
    <PropertyGroup Condition="('$(VcVars64Path)' == '' Or !Exists('$(VcVars64Path)')) And '$(_VcVarsFromVsWhere)' != ''">
      <VcVars64Path>$([System.String]::Copy('$(_VcVarsFromVsWhere)').Split(';')[0].Trim())</VcVars64Path>
    </PropertyGroup>
    <Error Condition="'$(VcVars64Path)' == '' Or !Exists('$(VcVars64Path)')" Text="vcvars64.bat was not found. Install the Visual Studio C++ x64 build tools or pass -p:VcVars64Path=..." />
    <MakeDir Directories="$(MSBuildThisFileDirectory)Native\out;$(_VNotchNativeObjDir);$(_VNotchNativeObjDir)\hot;$(_VNotchNativeObjDir)\cold;$(_VNotchNativeObjDir)\avx2" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\Generate-GlassShaders.ps1&quot; -Root &quot;$(MSBuildProjectDirectory)&quot; -Output &quot;$(_VNotchNativeObjDir)\GlassShaders.g.h&quot;" />
    <WriteLinesToFile Condition="'$(_VcVarsCacheFile)' != '' And !Exists('$(_VcVarsCacheFile)')" File="$(_VcVarsCacheFile)" Lines="$(VcVars64Path)" Overwrite="true" />
    <!--
      Baseline x64 (SSE2) for everything except *.avx2.cpp: hot render/audio/capture/inference TUs keep /O2 /Ot,
      cold Win32/parser/settings TUs use /O1 (/Os) for compact code size. The AVX2 kernels are compiled with
      /arch:AVX2 and WITHOUT /GL so LTCG never hoists AVX2 instructions above Native\vnotch_cpu.h CPUID guards.
    -->
    <ItemGroup>
      <_VNotchNativeStaleObj Include="$(_VNotchNativeObjDir)\**\*.obj" />
    </ItemGroup>
    <Delete Files="@(_VNotchNativeStaleObj)" Condition="'$(VcVars64Path)' != '' And Exists('$(VcVars64Path)')" />
    <WriteLinesToFile File="$(_VNotchNativeObjDir)\baseline-hot.rsp" Lines="@(_VNotchNativeHotBaselineSources -> '&quot;%(FullPath)&quot;')" Overwrite="true" />
    <WriteLinesToFile File="$(_VNotchNativeObjDir)\baseline-cold.rsp" Lines="@(_VNotchNativeColdBaselineSources -> '&quot;%(FullPath)&quot;')" Overwrite="true" />
    <WriteLinesToFile File="$(_VNotchNativeObjDir)\avx2.rsp" Lines="@(_VNotchNativeAvx2Sources -> '&quot;%(FullPath)&quot;')" Overwrite="true" />
    <PropertyGroup>
      <_OnnxRuntimePkgRoot>$(PkgMicrosoft_ML_OnnxRuntime_DirectML)</_OnnxRuntimePkgRoot>
      <_OnnxRuntimePkgRoot Condition="'$(_OnnxRuntimePkgRoot)' == '' And '$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)microsoft.ml.onnxruntime.directml\1.24.4</_OnnxRuntimePkgRoot>
      <_OnnxRuntimePkgRoot Condition="'$(_OnnxRuntimePkgRoot)' == '' And '$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)\microsoft.ml.onnxruntime.directml\1.24.4</_OnnxRuntimePkgRoot>
      <_OnnxRuntimePkgRoot Condition="'$(_OnnxRuntimePkgRoot)' == '' And '$(USERPROFILE)' != ''">$(USERPROFILE)\.nuget\packages\microsoft.ml.onnxruntime.directml\1.24.4</_OnnxRuntimePkgRoot>
      <_OnnxRuntimeIncludeDir>$(_OnnxRuntimePkgRoot)\build\native\include</_OnnxRuntimeIncludeDir>
      <_NativeHotOptFlags Condition="'$(NativeFastCompile)' == 'true'">/O2 /Oi /Ot /Gy /Gw</_NativeHotOptFlags>
      <_NativeHotOptFlags Condition="'$(NativeFastCompile)' != 'true'">/O2 /Oi /Ot /Gy /Gw /GL</_NativeHotOptFlags>
      <_NativeColdOptFlags Condition="'$(NativeFastCompile)' == 'true'">/O1 /Oi /Gy /Gw</_NativeColdOptFlags>
      <_NativeColdOptFlags Condition="'$(NativeFastCompile)' != 'true'">/O1 /Oi /Gy /Gw /GL</_NativeColdOptFlags>
      <_NativeLinkOptFlags Condition="'$(NativeFastCompile)' == 'true'">/OPT:REF /OPT:ICF</_NativeLinkOptFlags>
      <_NativeLinkOptFlags Condition="'$(NativeFastCompile)' != 'true'">/LTCG /OPT:REF /OPT:ICF</_NativeLinkOptFlags>
    </PropertyGroup>
    <Exec Condition="!Exists('$(_OnnxRuntimeIncludeDir)\onnxruntime_cxx_api.h')" Command="dotnet restore &quot;$(MSBuildThisFileFullPath)&quot; --locked-mode -nologo -v:q" />
    <Exec Command="call &quot;$(VcVars64Path)&quot; &gt;nul &amp;&amp; cl.exe /nologo /c /std:c++latest $(_NativeHotOptFlags) /GR- /MT /EHsc /MP /W4 /utf-8 /I&quot;$(MSBuildThisFileDirectory)Native&quot; /I&quot;$(_VNotchNativeObjDir)&quot; /I&quot;$(_OnnxRuntimeIncludeDir)&quot; /Fo&quot;$(_VNotchNativeObjDir)\hot\\&quot; @&quot;$(_VNotchNativeObjDir)\baseline-hot.rsp&quot; &amp;&amp; cl.exe /nologo /c /std:c++latest $(_NativeColdOptFlags) /GR- /MT /EHsc /MP /W4 /utf-8 /I&quot;$(MSBuildThisFileDirectory)Native&quot; /I&quot;$(_VNotchNativeObjDir)&quot; /I&quot;$(_OnnxRuntimeIncludeDir)&quot; /Fo&quot;$(_VNotchNativeObjDir)\cold\\&quot; @&quot;$(_VNotchNativeObjDir)\baseline-cold.rsp&quot; &amp;&amp; cl.exe /nologo /c /std:c++latest /O2 /Oi /Ot /Gy /Gw /GR- /arch:AVX2 /MT /EHsc /MP /W4 /utf-8 /I&quot;$(MSBuildThisFileDirectory)Native&quot; /Fo&quot;$(_VNotchNativeObjDir)\avx2\\&quot; @&quot;$(_VNotchNativeObjDir)\avx2.rsp&quot;" IgnoreStandardErrorWarningFormat="true" />
    <ItemGroup>
      <_VNotchNativeObj Include="$(_VNotchNativeObjDir)\hot\*.obj;$(_VNotchNativeObjDir)\cold\*.obj;$(_VNotchNativeObjDir)\avx2\*.obj" />
    </ItemGroup>
    <WriteLinesToFile File="$(_VNotchNativeObjDir)\link.rsp" Lines="@(_VNotchNativeObj -> '&quot;%(FullPath)&quot;')" Overwrite="true" />
    <Exec Command="call &quot;$(VcVars64Path)&quot; &gt;nul &amp;&amp; link.exe /nologo /DLL $(_NativeLinkOptFlags) /BREPRO /NOCOFFGRPINFO /MERGE:.fptable=.rdata /NODEFAULTLIB:libucrt.lib /DEFAULTLIB:ucrt.lib /CETCOMPAT /OUT:&quot;$(_VNotchNativeDll)&quot; /IMPLIB:&quot;$(_VNotchNativeObjDir)\VNotch.Native.lib&quot; @&quot;$(_VNotchNativeObjDir)\link.rsp&quot;" IgnoreStandardErrorWarningFormat="true" />
  </Target>
  <Target Name="BuildNativeDll" DependsOnTargets="CompileVNotchNative" />

  <Target Name="SetPackageManifestVersion" BeforeTargets="Build">
    <PropertyGroup>
      <PackageManifestVersion Condition="'$(PackageManifestVersion)' == ''">$(Version).0</PackageManifestVersion>
    </PropertyGroup>
    <Copy SourceFiles="Package.appxmanifest" DestinationFiles="$(IntermediateOutputPath)Package.appxmanifest" />
    <XmlPoke XmlInputPath="$(IntermediateOutputPath)Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version" Value="$(PackageManifestVersion)" />
    <Copy SourceFiles="$(IntermediateOutputPath)Package.appxmanifest" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
