<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <!-- Audit snapshots are not application source, XAML pages, or resources. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**\*</DefaultItemExcludes>

    <!-- Opt out of CET shadow-stack enforcement. Added with the LiquidGlass D3D interop
         work (490e198); the app loads native GPU/audio/LLM libraries and hooks that are
         not verified as CET compatible. Re-enable only after testing those paths. -->
    <CETCompat>false</CETCompat>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>V-Notch</AssemblyName>
    <RootNamespace>VNotch</RootNamespace>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <ReadyToRun>true</ReadyToRun>

    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <!-- Native libraries are already deployed beside the app. Avoid extracting
         another per-version copy, and share runtime DLLs with the uninstaller. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Reduce the installed single-file executable without trimming WPF,
         reflection, COM interop or CPU/GPU translation backends. -->
    <EnableCompressionInSingleFile Condition="'$(Configuration)' == 'Release' And '$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <Version>2.2.1</Version>
    <AssemblyVersion>2.2.1</AssemblyVersion>
    <FileVersion>2.2.1</FileVersion>
    <Authors>w0otdev</Authors>
    <Company>V-Notch</Company>
    <Product>V-Notch</Product>
    <Copyright>Copyright © 2026 w0otdev</Copyright>
    <PackageId>V-Notch</PackageId>
    <PackageProjectUrl>https://github.com/w0otdev/V-Notch</PackageProjectUrl>
    <RepositoryUrl>https://github.com/w0otdev/V-Notch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>A desktop status and media companion for Windows</Description>
    <ApplicationIcon>Services\icons\logo.ico</ApplicationIcon>

    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="LanguageDetection.Ai" Version="1.1.0" />
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan.Windows" Version="0.27.0" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="System.Data.OleDb" Version="8.0.1" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="Tools\**\*.cs" />
    <Compile Remove="Uninstall\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VNotch.Tests" />
    <InternalsVisibleTo Include="VNotch.TranslationBench" />
    <EmbeddedResource Include="Security\update-public-key.pem" LogicalName="VNotch.UpdatePublicKey.pem" />
    <EmbeddedResource Include="Assets\MediaProtocols.json" LogicalName="VNotch.MediaProtocols.json" />
    <EmbeddedResource Include="docs\TERMS_OF_SERVICE.md" LogicalName="VNotch.TERMS_OF_SERVICE.md" />
    <EmbeddedResource Include="docs\TERMS_OF_SERVICE_VI.md" LogicalName="VNotch.TERMS_OF_SERVICE_VI.md" />
    <EmbeddedResource Include="Locales\*.json" LogicalName="VNotch.Locales.%(FileName).json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tray loads this icon from disk; it differs from the WPF logo resource. -->
    <None Update="Services\icons\logo.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Link="logo.ico" />
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="docs\THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="THIRD_PARTY_NOTICES.md" />
    <None Update="docs\licenses\Hardcodet.NotifyIcon.Wpf-MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="licenses\Hardcodet.NotifyIcon.Wpf-MIT.txt" />
    <None Update="Assets\MediaProtocols.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Introduction\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="Assets\Translation\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Assets\SPL_CLICK_SFX.m4a" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="KeepTranslationNativeLibrariesBesideExecutable" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <Content Remove="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').Contains('LLamaSharpRuntimes')) And '%(Filename)%(Extension)' == 'mtmd.dll'" />
      <Content Update="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').Contains('LLamaSharpRuntimes'))" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
  <Target Name="PruneUnusedPublishPayload" AfterTargets="ComputeFilesToPublish" BeforeTargets="_HandleFileConflictsForPublish;_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'mtmd.dll' Or '%(Extension)' == '.lib' Or '%(RelativePath)' == 'runtimes\win-x64\native\WebView2Loader.dll'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Update="Models\yolox_nano.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Models\YOLOX-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Update="Models\model-provenance.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="Package.appxmanifest" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Fonts\SF-Pro-Display-*.otf" />
    <Content Include="Fonts\SF-Pro-Display-*.otf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Native\out\VNotch.Native.dll" Link="VNotch.Native.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Resource Include="Fonts\segmdl2.ttf" />
    <Resource Include="Services\icons\browser.svg" />
    <Resource Include="Services\icons\discord.svg" />
    <Resource Include="Services\icons\soundcloud.svg" />
    <Resource Include="Services\icons\spotify.svg" />
    <Resource Include="Services\icons\twitch.svg" />
    <Resource Include="Services\icons\twitter.svg" />
    <Resource Include="Services\icons\youtube.svg" />
    <Resource Include="logo.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\TrayIcons\*.png" />
    <Resource Include="Assets\QR.PNG" />
    <Resource Include="Assets\vertex_logo.png" />
    <Resource Include="Assets\scrollv_logo.png" />
    <Resource Include="Shaders\LiquidGlassRefraction.ps" />
    <Resource Include="Assets\Flags\flag_en.png" />
    <Resource Include="Assets\Flags\flag_vi.png" />
    <Resource Include="Assets\Flags\flag_es.png" />
    <Resource Include="Assets\Flags\flag_fr.png" />
    <Resource Include="Assets\Flags\flag_de.png" />
    <Resource Include="Assets\Flags\flag_ja.png" />
    <Resource Include="Assets\Flags\flag_hi.png" />
    <Resource Include="Assets\Flags\flag_zh.png" />
    <Resource Include="Assets\Flags\flag_pt.png" />
    <Resource Include="Assets\Flags\flag_ru.png" />
    <Resource Include="Assets\Flags\flag_ar.png" />
    <Resource Include="Assets\Flags\flag_ko.png" />
    <Resource Include="Assets\Flags\flag_it.png" />
    <Resource Include="Assets\Flags\flag_tr.png" />
    <Resource Include="Assets\Flags\flag_pl.png" />
    <Resource Include="Assets\Flags\flag_nl.png" />
    <Resource Include="Assets\Flags\flag_id.png" />
  </ItemGroup>
  <!-- Recompiles the committed LiquidGlass pixel shader only when the HLSL source is newer
       than the .ps output (Inputs/Outputs). Override the compiler with -p:FxcPath=...,
       or skip the step with -p:SkipShaderCompile=true. A failed compile keeps the committed
       .ps and emits a warning, which -warnaserror turns into a build failure. -->
  <PropertyGroup>
    <_LiquidGlassShaderSource>$(MSBuildThisFileDirectory)Shaders\LiquidGlassRefraction.hlsl</_LiquidGlassShaderSource>
    <_LiquidGlassShaderOutput>$(MSBuildThisFileDirectory)Shaders\LiquidGlassRefraction.ps</_LiquidGlassShaderOutput>
    <_WindowsKitsRoot Condition="'$(_WindowsKitsRoot)' == '' And '$(WindowsSdkDir)' != ''">$(WindowsSdkDir)</_WindowsKitsRoot>
    <_WindowsKitsRoot Condition="'$(_WindowsKitsRoot)' == '' And '$(MSBuildProgramFiles32)' != ''">$(MSBuildProgramFiles32)\Windows Kits\10\</_WindowsKitsRoot>
  </PropertyGroup>
  <Target Name="CompileLiquidGlassShader" BeforeTargets="BeforeBuild" Condition="'$(SkipShaderCompile)' != 'true' And '$(DesignTimeBuild)' != 'true'" Inputs="$(_LiquidGlassShaderSource)" Outputs="$(_LiquidGlassShaderOutput)">
    <ItemGroup Condition="'$(FxcPath)' == ''">
      <!-- Versioned SDK folders enumerate in name order, so the last match is the newest SDK. -->
      <_FxcCandidate Include="$(WindowsSdkVerBinPath)x64\fxc.exe" Condition="'$(WindowsSdkVerBinPath)' != '' And Exists('$(WindowsSdkVerBinPath)x64\fxc.exe')" />
      <_FxcCandidate Include="$(_WindowsKitsRoot)bin\10.*\x64\fxc.exe" Condition="'@(_FxcCandidate)' == '' And '$(_WindowsKitsRoot)' != ''" />
    </ItemGroup>
    <PropertyGroup Condition="'$(FxcPath)' == ''">
      <FxcPath Condition="'@(_FxcCandidate)' != ''">%(_FxcCandidate.FullPath)</FxcPath>
    </PropertyGroup>
    <PropertyGroup>
      <_ShaderCompileExitCode>0</_ShaderCompileExitCode>
      <_UseFxc Condition="'$(FxcPath)' != '' And Exists('$(FxcPath)')">true</_UseFxc>
    </PropertyGroup>

    <Exec Condition="'$(_UseFxc)' == 'true'" Command="&quot;$(FxcPath)&quot; /nologo /T ps_3_0 /O3 /E main /Fo &quot;$(_LiquidGlassShaderOutput)&quot; &quot;$(_LiquidGlassShaderSource)&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_ShaderCompileExitCode" />
    </Exec>
    <Message Condition="'$(_UseFxc)' != 'true'" Importance="high" Text="fxc.exe not found (set FxcPath to override). Falling back to Tools\ShaderCompiler." />
    <Exec Condition="'$(_UseFxc)' != 'true'" Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)Tools\ShaderCompiler\ShaderCompiler.csproj&quot; -- &quot;$(_LiquidGlassShaderSource)&quot; &quot;$(_LiquidGlassShaderOutput)&quot;" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_ShaderCompileExitCode" />
    </Exec>
    <Warning Condition="'$(_ShaderCompileExitCode)' != '0'" Code="VNOTCH001" Text="LiquidGlass shader compile failed with exit code $(_ShaderCompileExitCode). The committed Shaders\LiquidGlassRefraction.ps was kept and may be stale." />
  </Target>

  <PropertyGroup>
    <_VNotchNativeDll>$(MSBuildThisFileDirectory)Native\out\VNotch.Native.dll</_VNotchNativeDll>
    <_VNotchNativeObjDir>$(MSBuildThisFileDirectory)obj\native</_VNotchNativeObjDir>
  </PropertyGroup>
  <ItemGroup>
    <_VNotchNativeHeaders Include="$(MSBuildThisFileDirectory)Native\**\*.h" />
    <_VNotchNativeSources Include="$(MSBuildThisFileDirectory)Native\**\*.cpp" />
    <_VNotchNativeAvx2Sources Include="$(MSBuildThisFileDirectory)Native\**\*.avx2.cpp" />
    <_VNotchNativeBaselineSources Include="$(MSBuildThisFileDirectory)Native\**\*.cpp" Exclude="$(MSBuildThisFileDirectory)Native\**\*.avx2.cpp" />
  </ItemGroup>
  <Target Name="CompileVNotchNative" BeforeTargets="BeforeBuild" Condition="'$(SkipNativeCompile)' != 'true' And '$(DesignTimeBuild)' != 'true'" Inputs="@(_VNotchNativeSources);@(_VNotchNativeHeaders)" Outputs="$(_VNotchNativeDll)">
    <PropertyGroup Condition="'$(VcVars64Path)' == ''">
      <_VcVarsCacheFile>$(_VNotchNativeObjDir)\vcvars64.cache</_VcVarsCacheFile>
      <VcVars64Path Condition="Exists('$(_VcVarsCacheFile)')">$([System.IO.File]::ReadAllText('$(_VcVarsCacheFile)').Trim())</VcVars64Path>
    </PropertyGroup>
    <PropertyGroup Condition="'$(VcVars64Path)' == '' Or !Exists('$(VcVars64Path)')">
      <_VcVarsFallback1>C:\Program Files\Microsoft Visual Studio\2022\Enterprise\VC\Auxiliary\Build\vcvars64.bat</_VcVarsFallback1>
      <_VcVarsFallback2>C:\Program Files\Microsoft Visual Studio\2022\Professional\VC\Auxiliary\Build\vcvars64.bat</_VcVarsFallback2>
      <_VcVarsFallback3>C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Auxiliary\Build\vcvars64.bat</_VcVarsFallback3>
      <_VcVarsFallback4>C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Auxiliary\Build\vcvars64.bat</_VcVarsFallback4>
      <VcVars64Path Condition="Exists('$(_VcVarsFallback1)')">$(_VcVarsFallback1)</VcVars64Path>
      <VcVars64Path Condition="'$(VcVars64Path)' == '' And Exists('$(_VcVarsFallback2)')">$(_VcVarsFallback2)</VcVars64Path>
      <VcVars64Path Condition="'$(VcVars64Path)' == '' And Exists('$(_VcVarsFallback3)')">$(_VcVarsFallback3)</VcVars64Path>
      <VcVars64Path Condition="'$(VcVars64Path)' == '' And Exists('$(_VcVarsFallback4)')">$(_VcVarsFallback4)</VcVars64Path>
      <_VsWherePath>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer\vswhere.exe</_VsWherePath>
    </PropertyGroup>
    <Exec Condition="('$(VcVars64Path)' == '' Or !Exists('$(VcVars64Path)')) And Exists('$(_VsWherePath)')" Command="&quot;$(_VsWherePath)&quot; -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -find **\vcvars64.bat" ConsoleToMSBuild="true" EchoOff="true" StandardOutputImportance="Low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_VcVarsFromVsWhere" />
    </Exec>
    <PropertyGroup Condition="('$(VcVars64Path)' == '' Or !Exists('$(VcVars64Path)')) And '$(_VcVarsFromVsWhere)' != ''">
      <VcVars64Path>$([System.String]::Copy('$(_VcVarsFromVsWhere)').Split(';')[0].Trim())</VcVars64Path>
    </PropertyGroup>
    <Error Condition="'$(VcVars64Path)' == '' Or !Exists('$(VcVars64Path)')" Text="vcvars64.bat was not found. Install the Visual Studio C++ x64 build tools or pass -p:VcVars64Path=..." />
    <MakeDir Directories="$(MSBuildThisFileDirectory)Native\out;$(_VNotchNativeObjDir)" />
    <WriteLinesToFile Condition="'$(_VcVarsCacheFile)' != '' And !Exists('$(_VcVarsCacheFile)')" File="$(_VcVarsCacheFile)" Lines="$(VcVars64Path)" Overwrite="true" />
    <!--
      Baseline x64 (SSE2) for everything except *.avx2.cpp. The AVX2 kernels are compiled with /arch:AVX2
      and only entered after the runtime check in Native\vnotch_cpu.h, so the DLL loads and runs on CPUs
      and VMs without AVX2. The AVX2 objects are built without /GL so the compiler keeps their instruction set.
    -->
    <ItemGroup>
      <_VNotchNativeStaleObj Include="$(_VNotchNativeObjDir)\*.obj" />
    </ItemGroup>
    <Delete Files="@(_VNotchNativeStaleObj)" Condition="'$(VcVars64Path)' != '' And Exists('$(VcVars64Path)')" />
    <WriteLinesToFile File="$(_VNotchNativeObjDir)\baseline.rsp" Lines="@(_VNotchNativeBaselineSources -> '&quot;%(FullPath)&quot;')" Overwrite="true" />
    <WriteLinesToFile File="$(_VNotchNativeObjDir)\avx2.rsp" Lines="@(_VNotchNativeAvx2Sources -> '&quot;%(FullPath)&quot;')" Overwrite="true" />
    <PropertyGroup>
      <_NativeBaselineOptFlags Condition="'$(NativeFastCompile)' == 'true'">/O2 /Oi /Ot /Gy /Gw</_NativeBaselineOptFlags>
      <_NativeBaselineOptFlags Condition="'$(NativeFastCompile)' != 'true'">/O2 /Oi /Ot /Gy /Gw /GL</_NativeBaselineOptFlags>
      <_NativeLinkOptFlags Condition="'$(NativeFastCompile)' == 'true'">/OPT:REF /OPT:ICF</_NativeLinkOptFlags>
      <_NativeLinkOptFlags Condition="'$(NativeFastCompile)' != 'true'">/LTCG /OPT:REF /OPT:ICF</_NativeLinkOptFlags>
    </PropertyGroup>
    <Exec Command="call &quot;$(VcVars64Path)&quot; &gt;nul &amp;&amp; cl.exe /nologo /c /std:c++latest $(_NativeBaselineOptFlags) /MT /EHsc /MP /W4 /utf-8 /I&quot;$(MSBuildThisFileDirectory)Native&quot; /Fo&quot;$(_VNotchNativeObjDir)\\&quot; @&quot;$(_VNotchNativeObjDir)\baseline.rsp&quot; &amp;&amp; cl.exe /nologo /c /std:c++latest /O2 /Oi /Ot /Gy /Gw /arch:AVX2 /MT /EHsc /MP /W4 /utf-8 /I&quot;$(MSBuildThisFileDirectory)Native&quot; /Fo&quot;$(_VNotchNativeObjDir)\\&quot; @&quot;$(_VNotchNativeObjDir)\avx2.rsp&quot;" IgnoreStandardErrorWarningFormat="true" />
    <ItemGroup>
      <_VNotchNativeObj Include="$(_VNotchNativeObjDir)\*.obj" />
    </ItemGroup>
    <WriteLinesToFile File="$(_VNotchNativeObjDir)\link.rsp" Lines="@(_VNotchNativeObj -> '&quot;%(FullPath)&quot;')" Overwrite="true" />
    <Exec Command="call &quot;$(VcVars64Path)&quot; &gt;nul &amp;&amp; link.exe /nologo /DLL $(_NativeLinkOptFlags) /OUT:&quot;$(_VNotchNativeDll)&quot; /IMPLIB:&quot;$(_VNotchNativeObjDir)\VNotch.Native.lib&quot; @&quot;$(_VNotchNativeObjDir)\link.rsp&quot;" IgnoreStandardErrorWarningFormat="true" />
  </Target>
  <Target Name="BuildNativeDll" DependsOnTargets="CompileVNotchNative" />

  <Target Name="SetPackageManifestVersion" BeforeTargets="Build">
    <PropertyGroup>
      <PackageManifestVersion Condition="'$(PackageManifestVersion)' == ''">$(Version).0</PackageManifestVersion>
    </PropertyGroup>
    <Copy SourceFiles="Package.appxmanifest" DestinationFiles="$(IntermediateOutputPath)Package.appxmanifest" />
    <XmlPoke XmlInputPath="$(IntermediateOutputPath)Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version" Value="$(PackageManifestVersion)" />
    <Copy SourceFiles="$(IntermediateOutputPath)Package.appxmanifest" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
