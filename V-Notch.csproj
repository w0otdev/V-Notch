    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    <!-- Unreachable transitive managed packages excluded cleanly from .deps.json and single-file bundle -->
