root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cs,csx}]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true

# Naming conventions
dotnet_naming_rule.interfaces_must_be_pascal_case_with_i.severity = suggestion
dotnet_naming_rule.interfaces_must_be_pascal_case_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_must_be_pascal_case_with_i.style = i_pascal_case_style
dotnet_naming_symbol.interface_symbols.applicable_kinds = interface
dotnet_naming_style.i_pascal_case_style.required_prefix = I
dotnet_naming_style.i_pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.private_fields_camel_with_underscore.severity = suggestion
dotnet_naming_rule.private_fields_camel_with_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_camel_with_underscore.style = underscore_camel_case_style
dotnet_naming_symbol.private_field_symbols.applicable_kinds = field
dotnet_naming_symbol.private_field_symbols.applicable_accessibilities = private, private_protected
dotnet_naming_style.underscore_camel_case_style.required_prefix = _
dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case

dotnet_naming_rule.types_and_members_pascal_case.severity = suggestion
dotnet_naming_rule.types_and_members_pascal_case.symbols = public_and_type_symbols
dotnet_naming_rule.types_and_members_pascal_case.style = pascal_case_style
dotnet_naming_symbol.public_and_type_symbols.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_symbol.public_and_type_symbols.applicable_accessibilities = public, internal, protected, protected_internal
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

[*.{xml,xaml,csproj,props,targets,nuspec}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{md,svg}]
trim_trailing_whitespace = false

# Architectural rules aligned with C++26 Native-First & Zero-LINQ guidelines
[*.cs]
dotnet_diagnostic.S6640.severity = none
dotnet_diagnostic.S3267.severity = none
dotnet_diagnostic.S4200.severity = none

[Tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
